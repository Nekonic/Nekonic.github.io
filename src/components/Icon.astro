---
// JetBrains New UI 느낌의 16px 스트로크 아이콘 모음
interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 16, class: className } = Astro.props;

const paths: Record<string, string> = {
  folder: '<path d="M1.5 3.5h4.5l1.5 1.5h7v8.5h-13z"/>',
  file: '<path d="M3.5 1.5h6l3 3v10h-9z"/><path d="M6 8h4.5M6 10.5h4.5"/>',
  chat: '<path d="M2 3h12v8H6l-3 2.5V11H2z"/>',
  lock: '<rect x="3" y="7" width="10" height="7" rx="1.5"/><path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2"/>',
  user: '<circle cx="8" cy="5.5" r="2.5"/><path d="M3 14c.6-2.8 2.6-4 5-4s4.4 1.2 5 4"/>',
  search: '<circle cx="7" cy="7" r="4.5"/><path d="M10.5 10.5L14 14"/>',
  branch: '<circle cx="4" cy="3.5" r="1.6"/><circle cx="4" cy="12.5" r="1.6"/><circle cx="12" cy="6" r="1.6"/><path d="M4 5v6M12 7.6c0 2.4-3 2.4-6.6 3.6"/>',
  plus: '<path d="M8 3v10M3 8h10"/>',
  'chevron-down': '<path d="M4.5 6.5l3.5 3.5 3.5-3.5"/>',
  'chevron-right': '<path d="M6.5 4.5l3.5 3.5-3.5 3.5"/>',
  close: '<path d="M4.5 4.5l7 7M11.5 4.5l-7 7"/>',
  copy: '<rect x="5" y="5" width="9" height="9" rx="1.5"/><path d="M11 5V3.5A1.5 1.5 0 0 0 9.5 2h-6A1.5 1.5 0 0 0 2 3.5v6A1.5 1.5 0 0 0 3.5 11H5"/>',
  menu: '<path d="M2.5 4.5h11M2.5 8h11M2.5 11.5h11"/>',
  list: '<path d="M2 4h12M5 8h9M5 12h9"/>',
  pencil: '<path d="M10.5 2.5l3 3-8 8H2.5v-3z"/>',
  info: '<circle cx="8" cy="8" r="6"/><path d="M8 7v4M8 5v.01"/>',
};
---

{name === 'play' ? (
  <svg width={size} height={size} viewBox="0 0 16 16" class={className} aria-hidden="true"><path d="M4 2.5v11l9.5-5.5z" fill="#5fb865"/></svg>
) : name === 'github' ? (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="currentColor" class={className} aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.2 11.39.6.11.8-.26.8-.58v-2.23c-3.34.73-4.03-1.42-4.03-1.42-.55-1.39-1.33-1.76-1.33-1.76-1.09-.75.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.49 1 .11-.78.42-1.31.76-1.6-2.67-.31-5.47-1.34-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.65 1.66.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.81 5.62-5.48 5.92.43.37.82 1.1.82 2.22v3.29c0 .32.19.7.8.58C20.57 21.8 24 17.3 24 12c0-6.63-5.37-12-12-12z"/></svg>
) : name === 'md' ? (
  <span class:list={["inline-flex items-center justify-center font-mono text-[9px] font-semibold leading-3 px-[2px] rounded-[3px] text-syntax-func border border-[#3a5a86]", className]} aria-hidden="true">M↓</span>
) : (
  <svg width={size} height={size} viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true" set:html={paths[name] ?? ''} />
)}
