---
interface Props {
  headings: { depth: number; slug: string; text: string }[];
}

const { headings } = Astro.props;
const toc = headings.filter(h => h.depth >= 2 && h.depth <= 4);
---

{toc.length > 0 && (
  <nav class="toc-container" aria-label="목차">
    <div class="h-9 flex items-center px-3.5 font-semibold text-[13px]">Structure</div>
    <ul class="flex flex-col px-1.5 leading-[26px]">
      {toc.map(heading => (
        <li>
          <a
            href={`#${heading.slug}`}
            class="toc-link flex items-center gap-2 pr-2 rounded-[5px] text-text-body hover:bg-secondary transition-colors"
            style={`padding-left:${0.5 + (heading.depth - 2) * 0.875}rem`}
            data-slug={heading.slug}
          >
            <span class="toc-badge font-mono text-[10px] font-semibold text-text-muted shrink-0">H{heading.depth}</span>
            <span class="truncate">{heading.text}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<script is:inline>
  (function() {
    function setupToc() {
      var links = document.querySelectorAll('.toc-link');
      if (!links.length) return;

      var headings = document.querySelectorAll('.article-content h2, .article-content h3, .article-content h4');
      if (!headings.length) return;

      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (!entry.isIntersecting) return;
          var id = entry.target.getAttribute('id');
          links.forEach(function(link) {
            var on = link.getAttribute('data-slug') === id;
            link.classList.toggle('bg-accent/15', on);
            link.classList.toggle('text-text-primary', on);
            var badge = link.querySelector('.toc-badge');
            if (badge) badge.classList.toggle('text-accent-soft', on);
          });
        });
      }, { rootMargin: '0px 0px -75% 0px' });

      headings.forEach(function(h) {
        observer.observe(h);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupToc);
    } else {
      setupToc();
    }
  })();
</script>
