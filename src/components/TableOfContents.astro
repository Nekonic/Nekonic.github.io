---
interface Props {
  headings: { depth: number; slug: string; text: string }[];
}

const { headings } = Astro.props;
const toc = headings.filter(h => h.depth >= 2 && h.depth <= 4);
---

{toc.length > 0 && (
  <nav class="toc-container text-xs">
    <div class="flex items-center gap-1.5 text-text-muted font-mono uppercase tracking-wider text-[11px] font-semibold mb-3">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="8" y1="6" x2="21" y2="6"/>
        <line x1="8" y1="12" x2="21" y2="12"/>
        <line x1="8" y1="18" x2="21" y2="18"/>
        <line x1="3" y1="6" x2="3.01" y2="6"/>
        <line x1="3" y1="12" x2="3.01" y2="12"/>
        <line x1="3" y1="18" x2="3.01" y2="18"/>
      </svg>
      <span>On this page</span>
    </div>

    <ul class="space-y-1 border-l border-border/80 pl-2">
      {toc.map(heading => {
        const indentClass = heading.depth === 2 
          ? "pl-1 text-text-secondary font-medium" 
          : heading.depth === 3 
          ? "pl-3.5 text-text-muted text-[11.5px]" 
          : "pl-6 text-text-muted/80 text-[11px]";
        
        return (
          <li>
            <a 
              href={`#${heading.slug}`}
              class:list={[
                "toc-link block py-1 hover:text-white transition-all truncate leading-snug rounded-xs",
                indentClass
              ]}
              data-slug={heading.slug}
            >
              {heading.text}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
)}

<script is:inline>
  (function() {
    function setupToc() {
      var links = document.querySelectorAll('.toc-link');
      if (!links.length) return;

      var headings = document.querySelectorAll('.article-content h2, .article-content h3, .article-content h4');
      if (!headings.length) return;

      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            var id = entry.target.getAttribute('id');
            links.forEach(function(link) {
              if (link.getAttribute('data-slug') === id) {
                link.classList.add('text-accent', 'font-semibold', 'translate-x-0.5');
                link.classList.remove('text-text-secondary', 'text-text-muted');
              } else {
                link.classList.remove('text-accent', 'font-semibold', 'translate-x-0.5');
              }
            });
          }
        });
      }, { rootMargin: '0px 0px -75% 0px' });

      headings.forEach(function(h) {
        observer.observe(h);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupToc);
    } else {
      setupToc();
    }
  })();
</script>
