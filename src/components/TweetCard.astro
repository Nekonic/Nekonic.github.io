---
import { formatDate } from '../lib/utils';

export interface Props {
  id?: string;
  content?: string;
  date?: Date;
}

const { id, content = '', date } = Astro.props;
const tweetTerm = id ? `tweet-${id}` : undefined;
---

<article 
  class="tweet-article bg-card border border-borderSubtle rounded-2xl p-4 sm:p-5 transition-all duration-200 hover:border-borderHover hover:bg-card/90" 
  data-tweet-id={id}
>
  <div class="flex items-start gap-3">
    <!-- Twitter-style Avatar -->
    <a href="https://github.com/Nekonic" target="_blank" rel="noopener noreferrer" class="flex-shrink-0 group">
      <img 
        src="https://github.com/Nekonic.png" 
        alt="Nekonic" 
        class="w-10 h-10 rounded-full border border-borderSubtle group-hover:opacity-90 transition-opacity object-cover"
      />
    </a>

    <!-- Tweet Body -->
    <div class="flex-1 min-w-0">
      <!-- User info header -->
      <div class="flex items-center justify-between mb-1">
        <div class="flex items-baseline gap-1.5 flex-wrap leading-tight">
          <span class="font-bold text-text-primary text-[15px] hover:underline cursor-pointer">Nekonic</span>
          <span class="text-[14px] text-text-muted">@Nekonic</span>
          <span class="text-[13px] text-text-muted">·</span>
          {date && (
            <time class="text-[13px] text-text-muted hover:underline cursor-pointer">
              {formatDate(date)}
            </time>
          )}
        </div>
      </div>

      <!-- Tweet text -->
      <div class="text-[#e7e9ea] whitespace-pre-wrap text-[15px] leading-relaxed mb-3 break-words font-sans">
        {content}
      </div>

      <!-- Authentic Twitter Action Bar -->
      <div class="flex items-center justify-between max-w-md -ml-2 text-[#71767b]">
        <!-- 1. Reply / Comment Button -->
        <button 
          type="button"
          class="tweet-comment-btn group flex items-center gap-1.5 text-[#71767b] hover:text-[#1d9bf0] transition-colors focus:outline-none cursor-pointer"
          data-target={`comments-${id || 'generic'}`}
          data-term={tweetTerm}
          title="답글 달기 (GitHub Discussions)"
        >
          <div class="w-8 h-8 rounded-full flex items-center justify-center group-hover:bg-[#1d9bf0]/10 transition-colors">
            <svg class="w-[18px] h-[18px] fill-current transition-transform group-hover:scale-110" viewBox="0 0 24 24">
              <path d="M1.751 10c0-4.42 3.584-8 8.005-8h4.366c4.49 0 8.129 3.64 8.129 8.13 0 2.96-1.607 5.68-4.196 7.11l-8.054 4.46v-3.69h-.067c-4.49.1-8.183-3.51-8.183-8.01zm8.005-6c-3.317 0-6.005 2.69-6.005 6 0 3.37 2.77 6.08 6.138 6.01l.351-.01h1.761v2.3l5.087-2.81c1.951-1.08 3.163-3.13 3.163-5.36 0-3.39-2.744-6.13-6.129-6.13H9.756z"/>
            </svg>
          </div>
          <span class="reply-indicator text-xs font-mono"></span>
        </button>

        <!-- 2. Retweet / Repost Button -->
        <button 
          type="button"
          class="tweet-retweet-btn group flex items-center gap-1.5 text-[#71767b] hover:text-[#00ba7c] transition-colors focus:outline-none cursor-pointer"
          data-id={id}
          title="리포스트"
        >
          <div class="w-8 h-8 rounded-full flex items-center justify-center group-hover:bg-[#00ba7c]/10 transition-colors">
            <svg class="w-[18px] h-[18px] fill-current transition-transform group-hover:scale-110" viewBox="0 0 24 24">
              <path d="M4.5 3.88l4.432 4.14-1.364 1.46L5.5 7.55V16c0 1.1.896 2 2 2H13v2H7.5c-2.209 0-4-1.79-4-4V7.55L1.432 9.48.068 8.02 4.5 3.88zM16.5 6H11V4h5.5c2.209 0 4 1.79 4 4v8.45l2.068-1.93 1.364 1.46-4.432 4.14-4.432-4.14 1.364-1.46 2.068 1.93V8c0-1.1-.896-2-2-2z"/>
            </svg>
          </div>
          <span class="retweet-count text-xs font-mono"></span>
        </button>

        <!-- 3. Heart / Like Button -->
        <button 
          type="button"
          class="tweet-like-btn group flex items-center gap-1.5 text-[#71767b] hover:text-[#f91880] transition-colors focus:outline-none cursor-pointer"
          data-id={id}
          data-target={`comments-${id || 'generic'}`}
          data-term={tweetTerm}
          title="마음에 들어요"
        >
          <div class="w-8 h-8 rounded-full flex items-center justify-center group-hover:bg-[#f91880]/10 transition-colors">
            <svg class="heart-svg w-[18px] h-[18px] fill-none stroke-current stroke-[1.8] transition-transform duration-200 group-hover:scale-115" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
            </svg>
          </div>
          <span class="like-count text-xs font-mono"></span>
        </button>

        <!-- 4. Share / Copy Link Button -->
        <button 
          type="button"
          class="tweet-share-btn group flex items-center gap-1.5 text-[#71767b] hover:text-[#1d9bf0] transition-colors focus:outline-none cursor-pointer relative"
          data-id={id}
          title="트윗 링크 복사"
        >
          <div class="w-8 h-8 rounded-full flex items-center justify-center group-hover:bg-[#1d9bf0]/10 transition-colors">
            <svg class="share-icon w-[18px] h-[18px] fill-current transition-transform group-hover:scale-110" viewBox="0 0 24 24">
              <path d="M12 2.59l5.7 5.7-1.41 1.42L13 6.41V16h-2V6.41L7.71 9.71 6.3 8.29 12 2.59zM21 15l-.02 3.51c0 1.38-1.12 2.49-2.5 2.49H5.5C4.11 21.01 3 19.9 3 18.51V15h2v3.5c0 .28.22.5.5.5h12.98c.28 0 .5-.22.5-.5L19 15h2z"/>
            </svg>
            <svg class="check-icon hidden w-[18px] h-[18px] text-green-400 stroke-current stroke-2 fill-none" viewBox="0 0 24 24">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
          </div>
          <!-- Toast tooltip -->
          <span class="copied-tooltip absolute -top-8 left-1/2 -translate-x-1/2 px-2 py-0.5 bg-[#1e1f22] border border-borderSubtle text-white text-[11px] rounded shadow-lg opacity-0 pointer-events-none transition-opacity duration-150 whitespace-nowrap font-mono">복사됨!</span>
        </button>
      </div>

      <!-- Collapsible Replies / Giscus Thread (GitHub Auth Commenting) -->
      {tweetTerm && (
        <div id={`comments-${id}`} class="hidden mt-3 pt-3 border-t border-borderSubtle">
          <div class="flex items-center justify-between mb-3 text-xs text-text-muted">
            <span class="flex items-center gap-1.5 font-mono">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
              </svg>
              GitHub Discussions 댓글 및 답글
            </span>
            <span class="text-[11px] text-text-muted">GitHub 로그인 필요</span>
          </div>
          <div class="giscus-slot" data-term={tweetTerm}></div>
        </div>
      )}
    </div>
  </div>
</article>
