---
import { formatDate, toArray } from '../lib/utils';

export interface Props {
  title: string;
  date: Date;
  categories?: string | string[];
  tags?: string | string[];
  slug: string;
}

const { title, date, categories, tags, slug } = Astro.props;
const catArray = toArray(categories);
const tagArray = toArray(tags);
---

<a href={`/blog/${slug}`} class="block group h-full">
  <article class="bg-card border border-borderSubtle rounded-lg p-5 transition-all duration-200 hover:border-accent hover:bg-cardHover hover:shadow-[0_4px_24px_rgba(53,116,240,0.12)] hover:-translate-y-0.5 h-full flex flex-col justify-between relative overflow-hidden">
    <!-- Top accent highlight line on hover -->
    <span class="absolute top-0 left-0 right-0 h-[2px] bg-accent opacity-0 group-hover:opacity-100 transition-opacity duration-200"></span>

    <div>
      <div class="flex items-center justify-between gap-2 mb-3">
        <div class="flex items-center gap-1.5">
          <!-- IDE Markdown file icon -->
          <svg class="text-text-muted group-hover:text-accent transition-colors" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/>
            <polyline points="14 2 14 8 20 8"/>
          </svg>
          <time class="text-[11px] font-mono text-text-muted">{formatDate(date)}</time>
        </div>

        {catArray.length > 0 && (
          <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-accent/10 text-[#56a8f5] border border-accent/25 font-medium">
            {catArray[0]}
          </span>
        )}
      </div>

      <h3 class="text-base font-semibold text-text-primary tracking-tight group-hover:text-white transition-colors mb-2 leading-snug">
        {title}
      </h3>
    </div>

    {tagArray.length > 0 && (
      <div class="flex flex-wrap gap-1 mt-4 pt-3 border-t border-borderSubtle">
        {tagArray.slice(0, 3).map(tag => (
          <span class="px-1.5 py-0.5 text-[10.5px] font-mono rounded bg-primary/80 text-text-muted border border-borderSubtle">
            #{tag}
          </span>
        ))}
      </div>
    )}
  </article>
</a>
