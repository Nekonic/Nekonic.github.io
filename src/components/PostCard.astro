---
import { formatDate, toArray } from '../lib/utils';

export interface Props {
    title: string;
    date: Date;
    categories?: string | string[];
    tags?: string | string[];
    slug: string;
}

const { title, date, categories, tags, slug } = Astro.props;
const catArray = toArray(categories);
const tagArray = toArray(tags);
---
<a href={`/blog/${slug}`} class="block group h-full">
    <article class="bg-card border border-border rounded-lg p-5 transition-all duration-200 hover:border-accent h-full flex flex-col">
        <header class="mb-3">
            <h3 class="text-lg font-semibold text-text-primary mb-1 group-hover:text-accent transition-colors">{title}</h3>
            <time class="text-sm text-text-secondary block mb-3">{formatDate(date)}</time>
        </header>
        
        <div class="flex flex-wrap gap-2 mt-auto">
            {catArray.map(category => (
                <span class="px-2 py-0.5 text-xs rounded bg-accent/20 text-accent border border-accent/30 font-medium">
                    {category}
                </span>
            ))}
            {tagArray.map(tag => (
                <span class="px-2 py-0.5 text-xs rounded bg-secondary text-text-secondary border border-border">
                    #{tag}
                </span>
            ))}
        </div>
    </article>
</a>
