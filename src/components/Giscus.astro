---
interface Props {
  term?: string;
  mapping?: 'pathname' | 'specific' | 'title';
}

const { term, mapping = 'pathname' } = Astro.props;
---

<div class="giscus-section mt-12 pt-8 border-t border-borderSubtle">
  <div class="flex items-center gap-2 mb-6">
    <h3 class="text-[13px] font-semibold text-text-primary">Comments</h3>
    <span class="font-mono text-xs text-text-muted">GitHub Discussions</span>
  </div>

  <div class="giscus"></div>

  <!-- 테마에 맞춰 Giscus를 붙이고, 테마를 바꾸면 댓글 창도 바꿈 -->
  <script is:inline define:vars={{ mapping, term }}>
    (function() {
      var theme = function() { return document.documentElement.dataset.theme === 'light' ? 'light' : 'transparent_dark'; };
      var s = document.createElement('script');
      s.src = 'https://giscus.app/client.js';
      var attrs = {
        'data-repo': 'Nekonic/Nekonic.github.io', 'data-repo-id': 'R_kgDOIgGsMA',
        'data-category': 'General', 'data-category-id': 'DIC_kwDOIgGsMM4DG0Di',
        'data-mapping': mapping, 'data-strict': '0', 'data-reactions-enabled': '1', 'data-emit-metadata': '0',
        'data-input-position': 'bottom', 'data-theme': theme(), 'data-lang': 'ko', 'data-loading': 'lazy',
      };
      if (term) attrs['data-term'] = term;
      for (var k in attrs) s.setAttribute(k, attrs[k]);
      s.crossOrigin = 'anonymous';
      s.async = true;
      document.currentScript.parentNode.appendChild(s);
      var send = function(w) { w.postMessage({ giscus: { setConfig: { theme: theme() } } }, 'https://giscus.app'); };
      document.addEventListener('nk-theme', function() {
        document.querySelectorAll('iframe.giscus-frame').forEach(function(f) { send(f.contentWindow); });
      });
      // 지연 로딩이라 아직 안 뜬 댓글 창은 메시지를 못 받음 → 처음 뜰 때 지금 테마를 한 번 더 보냄
      window.addEventListener('message', function onFirst(e) {
        if (e.origin !== 'https://giscus.app' || !e.source) return;
        window.removeEventListener('message', onFirst);
        send(e.source);
      });
    })();
  </script>
</div>
