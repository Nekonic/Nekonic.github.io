---
interface Props {
  term?: string;
  mapping?: 'pathname' | 'specific' | 'title';
}

const { term, mapping = 'pathname' } = Astro.props;
---

<div class="giscus-section mt-12 pt-8 border-t border-borderSubtle">
  <div class="flex items-center gap-2 mb-6">
    <svg class="text-accent" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
    </svg>
    <h3 class="text-base font-bold text-white tracking-tight">댓글 & 반응</h3>
    <span class="text-xs font-mono text-text-muted">GitHub Discussions</span>
  </div>

  <div class="giscus"></div>

  <script
    is:inline
    src="https://giscus.app/client.js"
    data-repo="Nekonic/Nekonic.github.io"
    data-repo-id="R_kgDOIgGsMA"
    data-category="General"
    data-category-id="DIC_kwDOIgGsMM4DG0Di"
    data-mapping={mapping}
    data-term={term}
    data-strict="0"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="bottom"
    data-theme="transparent_dark"
    data-lang="ko"
    data-loading="lazy"
    crossorigin="anonymous"
    async
  ></script>
</div>
