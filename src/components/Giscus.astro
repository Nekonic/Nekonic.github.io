---
interface Props {
  term?: string;
  mapping?: 'pathname' | 'specific' | 'title';
}

const { term, mapping = 'pathname' } = Astro.props;
---

<div class="giscus-section mt-12 pt-8 border-t border-borderSubtle">
  <div class="flex items-center gap-2 mb-6">
    <h3 class="text-[13px] font-semibold text-text-primary">Comments</h3>
    <span class="font-mono text-xs text-text-muted">GitHub Discussions</span>
  </div>

  <div class="giscus"></div>

  <script
    is:inline
    src="https://giscus.app/client.js"
    data-repo="Nekonic/Nekonic.github.io"
    data-repo-id="R_kgDOIgGsMA"
    data-category="General"
    data-category-id="DIC_kwDOIgGsMM4DG0Di"
    data-mapping={mapping}
    data-term={term}
    data-strict="0"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="bottom"
    data-theme="transparent_dark"
    data-lang="ko"
    data-loading="lazy"
    crossorigin="anonymous"
    async
  ></script>
</div>
