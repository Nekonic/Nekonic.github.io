---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';
import { getDateFromId } from '../lib/utils';

type Crumb = string | { label: string; href?: string };

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
  /** 에디터 탭에 표시할 이름 (기본: title) */
  tab?: string;
  /** 탭 아이콘 */
  tabIcon?: string;
  /** 에디터 상단/상태 표시줄 경로 */
  crumbs?: Crumb[];
  /** 왼쪽 Project 트리 표시 여부 */
  tree?: boolean;
  /** 상태 표시줄 오른쪽 정보 */
  status?: string[];
}

const {
  title,
  description = "C++ Programmer & Developer",
  wide = false,
  tab = title,
  tabIcon = 'md',
  crumbs = [],
  tree = false,
  status = ['UTF-8', 'LF'],
} = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

const navItems = [
  { href: "/", label: "Home", icon: "folder" },
  { href: "/blog", label: "Blog", icon: "file" },
  { href: "/tweets", label: "Tweets", icon: "chat" },
  { href: "/memos", label: "Memos", icon: "lock" },
  { href: "/about", label: "About", icon: "user" },
];

function isActive(href: string) {
  if (href === "/") return pathname === "/";
  if (href === "/blog") return pathname.startsWith("/blog") || pathname.startsWith("/secret");
  return pathname.startsWith(href);
}

const crumbItems = crumbs.map((c) => (typeof c === 'string' ? { label: c } : c));

// Project 트리: 연도별 글 목록
let treeYears: { year: string; posts: { id: string; title: string }[] }[] = [];
if (tree) {
  const posts = (await getCollection('blog'))
    .map((p) => ({ id: p.id, title: p.data.title, date: getDateFromId(p.id, p.data.date) }))
    .sort((a, b) => b.date.valueOf() - a.date.valueOf());
  const byYear = new Map<string, { id: string; title: string }[]>();
  for (const p of posts) {
    const y = String(p.date.getFullYear());
    if (!byYear.has(y)) byYear.set(y, []);
    byYear.get(y)!.push({ id: p.id, title: p.title });
  }
  treeYears = [...byYear.entries()].map(([year, posts]) => ({ year, posts }));
}
const hasAside = Astro.slots.has('aside');
---

<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title} | Nekonic</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://cdn.jsdelivr.net" />
  <link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-4FX5NFXY7Z"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-4FX5NFXY7Z');
  </script>
</head>
<body class="bg-ground text-text-primary font-sans antialiased text-[13px]">
<div class="min-h-screen flex flex-col pb-16 lg:pb-0">

  <!-- Main toolbar -->
  <header class="sticky top-0 z-40 h-11 bg-ground flex items-center gap-1.5 px-2.5">
    <a href="/" class="flex items-center gap-2 px-2 py-1 rounded-md hover:bg-secondary transition-colors">
      <span class="w-5 h-5 rounded-[5px] bg-accent text-white font-mono text-[10px] font-semibold flex items-center justify-center">NK</span>
      <span class="font-semibold text-text-primary"><span class="hidden sm:inline">nekonic.github.io</span><span class="sm:hidden">nekonic</span></span>
    </a>
    <span class="hidden md:flex items-center gap-1.5 px-2 py-1 text-text-secondary">
      <Icon name="branch" size={14} />
      <span>main</span>
    </span>

    <div class="flex-1"></div>

    <form action="/blog" method="get" role="search" class="hidden md:flex items-center gap-2 h-7 w-72 px-2.5 bg-primary border border-borderSubtle rounded-md text-text-muted focus-within:border-accent transition-colors">
      <Icon name="search" size={14} />
      <input id="globalSearch" type="search" name="q" placeholder="Search Everywhere" aria-label="글 검색" class="flex-1 min-w-0 bg-transparent border-0 outline-none text-text-primary placeholder:text-text-muted" />
      <kbd class="font-mono text-[11px] text-text-muted">⇧⇧</kbd>
    </form>
    <a href="/blog#filter" aria-label="글 검색" class="md:hidden w-10 h-10 flex items-center justify-center rounded-md text-text-secondary hover:bg-secondary">
      <Icon name="search" />
    </a>

    <div class="hidden md:block flex-1"></div>

    <a href="/write" class="hidden sm:flex items-center gap-1.5 h-7 px-2.5 rounded-md bg-secondary hover:bg-border text-text-primary transition-colors">
      <Icon name="play" size={12} />
      <span>새 포스트</span>
    </a>
    <a href="/compose" class="hidden md:flex items-center gap-1.5 h-7 px-2.5 rounded-md text-text-secondary hover:bg-secondary hover:text-text-primary transition-colors">
      <Icon name="plus" size={14} />
      <span>트윗</span>
    </a>
    <a href="https://github.com/Nekonic" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="w-8 h-7 flex items-center justify-center rounded-md text-text-secondary hover:bg-secondary hover:text-text-primary transition-colors">
      <Icon name="github" />
    </a>
  </header>

  <div class="flex-1 flex items-stretch gap-1.5 px-1.5 lg:pl-0">

    <!-- Tool window stripe -->
    <nav aria-label="사이트 메뉴" class="hidden lg:flex w-10 shrink-0 flex-col items-center gap-1 pt-1 sticky top-11 self-start">
      {navItems.map((item, i) => (
        <>
          {i === navItems.length - 1 && <span class="w-5 h-px bg-borderSubtle my-1"></span>}
          <a
            href={item.href}
            aria-label={item.label}
            title={item.label}
            class:list={[
              "w-[30px] h-[30px] rounded-md flex items-center justify-center transition-colors",
              isActive(item.href) ? "bg-accent/20 text-accent-soft" : "text-text-secondary hover:bg-secondary hover:text-text-primary",
            ]}
          >
            <Icon name={item.icon} />
          </a>
        </>
      ))}
    </nav>

    <!-- Project tool window -->
    {tree && (
      <aside class="hidden lg:flex w-64 shrink-0 flex-col bg-primary rounded-xl sticky top-11 self-start max-h-[calc(100vh-4.75rem)] overflow-hidden">
        <div class="h-9 shrink-0 flex items-center px-3 font-semibold">Project</div>
        <div class="flex-1 overflow-y-auto px-1.5 pb-3 leading-6">
          <div class="flex items-center gap-1.5 px-1.5">
            <Icon name="chevron-down" size={12} class="text-text-muted" />
            <Icon name="folder" size={14} class="text-text-secondary" />
            <span class="font-semibold">nekonic.github.io</span>
          </div>
          <details open class="group/posts">
            <summary class="list-none cursor-pointer flex items-center gap-1.5 pl-[22px] pr-1.5 rounded-md hover:bg-secondary">
              <Icon name="chevron-right" size={12} class="text-text-muted transition-transform group-open/posts:rotate-90" />
              <Icon name="folder" size={14} class="text-text-secondary" />
              <span>posts</span>
              <span class="text-text-muted text-xs">{treeYears.reduce((n, y) => n + y.posts.length, 0)}</span>
            </summary>
            {treeYears.map((y, i) => (
              <details open={i === 0} class="group/year">
                <summary class="list-none cursor-pointer flex items-center gap-1.5 pl-[38px] pr-1.5 rounded-md hover:bg-secondary">
                  <Icon name="chevron-right" size={12} class="text-text-muted transition-transform group-open/year:rotate-90" />
                  <Icon name="folder" size={14} class="text-text-secondary" />
                  <span>{y.year}</span>
                </summary>
                {y.posts.map((p) => (
                  <a
                    href={`/blog/${p.id}`}
                    title={p.title}
                    class:list={[
                      "flex items-center gap-1.5 pl-[70px] pr-1.5 rounded-md text-text-primary whitespace-nowrap overflow-hidden",
                      pathname === `/blog/${p.id}` ? "bg-accent/15" : "hover:bg-secondary",
                    ]}
                  >
                    <Icon name="md" />
                    <span class="truncate">{p.title}</span>
                  </a>
                ))}
              </details>
            ))}
          </details>
          <a href="/tweets" class="flex items-center gap-1.5 pl-[22px] pr-1.5 rounded-md hover:bg-secondary text-text-primary">
            <Icon name="chevron-right" size={12} class="text-text-muted" />
            <Icon name="folder" size={14} class="text-text-secondary" />
            <span>tweets</span>
          </a>
          <a href="/memos" class="flex items-center gap-1.5 pl-[22px] pr-1.5 rounded-md hover:bg-secondary text-text-primary">
            <Icon name="chevron-right" size={12} class="text-text-muted" />
            <Icon name="folder" size={14} class="text-[#c9a35a]" />
            <span>memos</span>
            <Icon name="lock" size={11} class="text-text-muted" />
          </a>
          <a href="/" class:list={["flex items-center gap-1.5 pl-[38px] pr-1.5 rounded-md text-text-primary", pathname === '/' ? 'bg-accent/15' : 'hover:bg-secondary']}>
            <Icon name="md" />
            <span>README.md</span>
          </a>
          <a href="/about" class="flex items-center gap-1.5 pl-[38px] pr-1.5 rounded-md hover:bg-secondary text-text-primary">
            <Icon name="md" />
            <span>about.md</span>
          </a>
        </div>
      </aside>
    )}

    <!-- Editor island -->
    <main class="flex-1 min-w-0 bg-primary rounded-xl flex flex-col">
      <div role="tablist" class="h-[38px] shrink-0 flex items-stretch px-1.5 border-b border-borderSubtle overflow-x-auto">
        <span role="tab" aria-selected="true" class="flex items-center gap-1.5 px-3 text-text-primary shadow-[inset_0_-2px_0_#3574f0] whitespace-nowrap">
          {tabIcon === 'md' ? <Icon name="md" /> : <Icon name={tabIcon} size={14} class="text-text-secondary" />}
          <span>{tab}</span>
        </span>
      </div>

      {crumbItems.length > 0 && (
        <div class="h-[30px] shrink-0 flex items-center gap-1.5 px-5 text-xs text-text-secondary border-b border-borderSubtle overflow-hidden whitespace-nowrap">
          {crumbItems.map((c, i) => (
            <>
              {i > 0 && <span aria-hidden="true">›</span>}
              {c.href
                ? <a href={c.href} class="hover:text-text-primary">{c.label}</a>
                : <span class:list={[i === crumbItems.length - 1 && "text-text-primary truncate"]}>{c.label}</span>}
            </>
          ))}
          <slot name="crumbs-end" />
        </div>
      )}

      <div class:list={["w-full mx-auto px-5 sm:px-8 lg:px-12 py-8 lg:py-10", wide ? "max-w-6xl" : "max-w-4xl"]}>
        <slot />
      </div>
    </main>

    <!-- Right tool windows -->
    {hasAside && (
      <aside class="hidden xl:flex w-64 shrink-0 flex-col gap-1.5 sticky top-11 self-start max-h-[calc(100vh-4.75rem)] overflow-y-auto">
        <slot name="aside" />
      </aside>
    )}
  </div>

  <!-- Status bar -->
  <footer class="hidden lg:flex h-7 items-center gap-1 px-3 text-xs text-text-secondary whitespace-nowrap overflow-hidden">
    <span>nekonic.github.io</span>
    {crumbItems.map((c) => (
      <>
        <span aria-hidden="true">›</span>
        <span>{c.label}</span>
      </>
    ))}
    <span class="flex-1"></span>
    {status.map((s) => <span class="px-2">{s}</span>)}
    <span class="px-2">© 2026 Nekonic</span>
  </footer>

  <!-- Mobile bottom stripe -->
  <nav aria-label="사이트 메뉴" class="lg:hidden fixed bottom-0 inset-x-0 z-40 h-16 bg-primary border-t border-borderSubtle grid grid-cols-5">
    {navItems.map((item) => (
      <a
        href={item.href}
        class:list={[
          "flex flex-col items-center justify-center gap-1 text-[11px]",
          isActive(item.href) ? "text-accent-soft" : "text-text-secondary",
        ]}
      >
        <Icon name={item.icon} size={18} />
        {item.label}
      </a>
    ))}
  </nav>
</div>

  <!-- Search Everywhere: Shift 두 번 -->
  <script is:inline>
    (function() {
      var last = 0;
      document.addEventListener('keyup', function(e) {
        if (e.key !== 'Shift') { last = 0; return; }
        var t = e.target;
        if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable)) return;
        var now = Date.now();
        if (now - last < 350) {
          var input = document.getElementById('globalSearch');
          if (input && input.offsetParent !== null) input.focus();
          else location.href = '/blog#filter';
          last = 0;
        } else {
          last = now;
        }
      });
    })();
  </script>
</body>
</html>
