---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "C++ Programmer & Developer" } = Astro.props;
const pathname = Astro.url.pathname;

const navItems = [
  {
    href: "/",
    label: "Home",
    // Home icon SVG
    svg: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>`
  },
  {
    href: "/blog",
    label: "Blog",
    // FileText / Posts icon
    svg: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></svg>`
  },
  {
    href: "/tweets",
    label: "Tweets",
    // MessageSquare icon
    svg: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`
  },
  {
    href: "/memos",
    label: "Memos",
    // Lock / Key icon for private memos
    svg: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>`
  },
  {
    href: "/about",
    label: "About",
    // User / Info icon
    svg: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>`
  },
];

function isActive(href: string) {
  if (href === "/") return pathname === "/";
  return pathname.startsWith(href);
}
---

<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title} | Nekonic</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-4FX5NFXY7Z"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-4FX5NFXY7Z');
  </script>
</head>
<body class="bg-primary text-text-primary font-sans antialiased min-h-screen">
  <!-- Mobile Header -->
  <header class="lg:hidden fixed top-0 left-0 right-0 z-50 bg-secondary border-b border-border px-4 h-14 flex items-center justify-between">
    <div class="flex items-center gap-2">
      <span class="inline-block w-2.5 h-2.5 rounded-sm bg-gradient-to-tr from-amber-500 via-rose-500 to-accent"></span>
      <span class="text-base font-bold text-text-primary tracking-tight">Nekonic</span>
    </div>
    <button id="menuToggle" class="text-text-secondary hover:text-text-primary p-2 focus:outline-none">
      <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M3 12h18M3 6h18M3 18h18" />
      </svg>
    </button>
  </header>

  <!-- Sidebar Overlay (Mobile) -->
  <div id="sidebarOverlay" class="fixed inset-0 bg-black/60 backdrop-blur-xs z-40 hidden lg:hidden"></div>

  <!-- Sidebar (JetBrains New UI style) -->
  <aside id="sidebar" class="fixed top-0 left-0 h-full w-60 bg-secondary border-r border-border z-50 flex flex-col transform -translate-x-full lg:translate-x-0 transition-transform duration-200 ease-in-out">
    <!-- Brand Header -->
    <div class="p-5 border-b border-border/60">
      <a href="/" class="flex items-center gap-2.5 group">
        <!-- JetBrains Logo Icon Style -->
        <span class="w-4 h-4 rounded-xs bg-gradient-to-tr from-amber-500 via-rose-500 to-accent shadow-xs group-hover:rotate-12 transition-transform duration-200"></span>
        <span class="text-lg font-bold text-text-primary tracking-tight group-hover:text-white transition-colors">
          Nekonic
        </span>
      </a>
      <div class="mt-2 flex items-center gap-2">
        <span class="text-[11px] font-mono text-text-muted px-1.5 py-0.5 rounded bg-primary/70 border border-border/80">
          C++ / Systems
        </span>
      </div>
    </div>

    <!-- Navigation List -->
    <nav class="flex-1 px-2.5 py-4 space-y-1">
      <div class="text-[10px] font-mono font-medium text-text-muted uppercase tracking-wider px-3 mb-2">
        Project Explorer
      </div>
      {navItems.map((item) => {
        const active = isActive(item.href);
        return (
          <a
            href={item.href}
            class:list={[
              "flex items-center gap-3 px-3 py-2 rounded-md text-sm font-medium transition-all group relative",
              active
                ? "bg-[#35373c] text-text-primary shadow-xs"
                : "text-text-secondary hover:text-text-primary hover:bg-[#35373c]/50",
            ]}
          >
            {active && (
              <span class="absolute left-0 top-1.5 bottom-1.5 w-1 bg-accent rounded-r"></span>
            )}
            <span class:list={[
              "transition-colors",
              active ? "text-accent" : "text-text-muted group-hover:text-text-secondary"
            ]} set:html={item.svg}></span>
            <span>{item.label}</span>
          </a>
        );
      })}

      <!-- Compose Action -->
      <div class="pt-5 px-1">
        <a
          href="/compose"
          class="flex items-center justify-center gap-2 w-full py-2 bg-accent/90 hover:bg-accent text-white rounded-md text-xs font-semibold tracking-wide shadow-xs transition-colors"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
          새 트윗 작성
        </a>
      </div>
    </nav>

    <!-- Bottom Status Bar style -->
    <div class="p-3 border-t border-border/60 bg-secondary/80 flex items-center justify-between text-[11px] font-mono text-text-muted">
      <span>UTF-8</span>
      <span>© 2026 Nekonic</span>
    </div>
  </aside>

  <!-- Main Content Area -->
  <main class="lg:ml-60 min-h-screen pt-14 lg:pt-0 bg-primary">
    <!-- Top breadcrumb bar (IDE style) -->
    <div class="hidden lg:flex items-center justify-between px-8 py-3 border-b border-border/50 text-xs font-mono text-text-muted bg-primary/40 backdrop-blur-xs">
      <div class="flex items-center gap-2">
        <span class="text-text-secondary">nekonic</span>
        <span>/</span>
        <span class="text-accent">{title.toLowerCase()}</span>
      </div>
      <div class="flex items-center gap-3">
        <a href="https://github.com/Nekonic" target="_blank" rel="noopener noreferrer" class="hover:text-text-primary transition-colors flex items-center gap-1.5">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          GitHub
        </a>
      </div>
    </div>

    <!-- Page Body -->
    <div class="max-w-4xl mx-auto px-6 lg:px-10 py-10">
      <slot />
    </div>
  </main>

  <!-- Mobile Menu Script -->
  <script>
    const toggle = document.getElementById("menuToggle");
    const sidebar = document.getElementById("sidebar");
    const overlay = document.getElementById("sidebarOverlay");

    function openMenu() {
      sidebar?.classList.remove("-translate-x-full");
      overlay?.classList.remove("hidden");
    }

    function closeMenu() {
      sidebar?.classList.add("-translate-x-full");
      overlay?.classList.add("hidden");
    }

    toggle?.addEventListener("click", openMenu);
    overlay?.addEventListener("click", closeMenu);
  </script>
</body>
</html>
