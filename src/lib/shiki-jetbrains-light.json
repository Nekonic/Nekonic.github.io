{
  "name": "JetBrains Light",
  "type": "light",
  "colors": {
    "editor.background": "#f7f8fa",
    "editor.foreground": "#080808"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8c8c8c"
      }
    },
    {
      "scope": [
        "comment.block.documentation",
        "comment.block.javadoc",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#8c8c8c",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.operator.wordlike",
        "constant.language",
        "variable.language",
        "support.type.primitive",
        "support.type.builtin",
        "entity.name.type.primitive"
      ],
      "settings": {
        "foreground": "#0033b3"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation"
      ],
      "settings": {
        "foreground": "#080808"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#067d17"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#0033b3"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.character.numeric"
      ],
      "settings": {
        "foreground": "#1750eb"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#00627a"
      }
    },
    {
      "scope": [
        "variable.other.constant",
        "constant.other",
        "variable.other.enummember",
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#871094"
      }
    },
    {
      "scope": [
        "meta.preprocessor",
        "keyword.control.directive",
        "punctuation.definition.directive",
        "entity.name.function.preprocessor",
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator",
        "storage.type.annotation",
        "meta.annotation"
      ],
      "settings": {
        "foreground": "#9e880d"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#0033b3"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#080808"
      }
    },
    {
      "scope": [
        "meta.mapping.key string",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#871094"
      }
    },
    {
      "scope": [
        "support.constant.property-value.css",
        "support.constant.color"
      ],
      "settings": {
        "foreground": "#067d17"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#0033b3"
      }
    },
    {
      "scope": [
        "variable.other.readwrite.shell",
        "variable.other.normal.shell",
        "punctuation.definition.variable.shell"
      ],
      "settings": {
        "foreground": "#871094"
      }
    },
    {
      "scope": [
        "markup.heading",
        "markup.bold"
      ],
      "settings": {
        "foreground": "#0033b3",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code",
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#067d17"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#c42c2c"
      }
    }
  ]
}