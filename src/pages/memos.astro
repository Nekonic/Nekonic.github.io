---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Memos" description="Private memos">
  <div class="max-w-4xl mx-auto py-6">
    <div class="flex justify-between items-center mb-8 pb-4 border-b border-border/70">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <h1 class="text-xl lg:text-2xl font-bold text-white tracking-tight">Private Memos</h1>
          <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-primary border border-border text-accent">
            Encrypted & Private
          </span>
        </div>
        <p class="text-xs font-mono text-text-muted">비공개 저장소(Nekonic.github.io.data)에만 안전하게 보관되는 개인 메모장</p>
      </div>
      <button 
        id="newMemoBtn" 
        class="hidden items-center gap-1.5 px-3.5 py-1.5 bg-accent hover:bg-accent-hover text-white rounded-md text-xs font-semibold tracking-wide transition-colors shadow-xs"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
        새 메모 작성
      </button>
    </div>

    <!-- Auth Container -->
    <div id="authContainer" class="bg-card border border-border rounded-xl p-6 max-w-md mx-auto shadow-sm">
      <div class="w-10 h-10 rounded-lg bg-secondary border border-border flex items-center justify-center text-accent mb-4">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      </div>
      <h2 class="text-base font-bold text-white mb-1.5">인증 필요</h2>
      <p class="text-xs text-text-secondary mb-4 leading-relaxed">
        비공개 메모를 조회하고 작성하려면 GitHub Classic Token (<code class="text-accent font-mono">repo</code> 권한)이 필요합니다. 토큰은 오직 현재 브라우저의 localStorage에만 보관됩니다.
      </p>
      <input 
        type="password" 
        id="patInput" 
        class="w-full bg-primary border border-border rounded-md px-3 py-2 text-xs font-mono text-text-primary focus:outline-none focus:border-accent mb-3" 
        placeholder="ghp_xxxxxxxxxxxx"
      >
      <button 
        id="saveAuthBtn" 
        class="w-full bg-accent hover:bg-accent-hover text-white text-xs font-semibold py-2 rounded-md transition-colors shadow-xs"
      >
        확인 및 로그인
      </button>
    </div>

    <!-- Memos Container -->
    <div id="memosContainer" class="hidden">
      <div class="text-text-muted font-mono text-xs text-center py-12" id="loadingState">
        비공개 저장소에서 메모를 동기화하는 중...
      </div>
    </div>
  </div>

  <!-- New Memo Modal -->
  <div id="memoModal" class="hidden fixed inset-0 bg-black/60 backdrop-blur-xs z-50 flex items-center justify-center p-4">
    <div class="bg-card border border-border rounded-xl w-full max-w-2xl flex flex-col max-h-[90vh] shadow-xl">
      <div class="flex justify-between items-center p-4 border-b border-border/70">
        <h2 class="text-sm font-bold text-white font-mono">New Private Memo</h2>
        <button id="closeModalBtn" class="text-text-muted hover:text-white text-lg">&times;</button>
      </div>
      <div class="p-4 flex-grow flex flex-col gap-3 overflow-y-auto">
        <input 
          type="text" 
          id="memoTitle" 
          class="w-full bg-primary border border-border rounded-md px-3 py-2 text-sm text-text-primary focus:outline-none focus:border-accent" 
          placeholder="메모 제목을 입력하세요"
        >
        <textarea 
          id="memoContent" 
          class="w-full bg-primary border border-border rounded-md p-3 text-sm text-text-primary font-mono focus:outline-none focus:border-accent flex-grow min-h-[260px] resize-none leading-relaxed" 
          placeholder="마크다운 문법으로 메모 내용을 자유롭게 작성하세요..."
        ></textarea>
      </div>
      <div class="p-4 border-t border-border/70 flex justify-end gap-2 bg-secondary/30">
        <button id="cancelMemoBtn" class="px-3.5 py-1.5 bg-secondary text-text-secondary hover:text-white rounded-md text-xs font-medium transition-colors">
          취소
        </button>
        <button id="saveMemoBtn" class="px-4 py-1.5 bg-accent hover:bg-accent-hover text-white rounded-md text-xs font-semibold transition-colors">
          저장하기
        </button>
      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  var REPO = 'Nekonic/Nekonic.github.io.data';
  var MEMO_PATH = '_memos';

  var authContainer = document.getElementById('authContainer');
  var memosContainer = document.getElementById('memosContainer');
  var patInput = document.getElementById('patInput');
  var saveAuthBtn = document.getElementById('saveAuthBtn');
  var newMemoBtn = document.getElementById('newMemoBtn');
  var memoModal = document.getElementById('memoModal');
  var closeModalBtn = document.getElementById('closeModalBtn');
  var cancelMemoBtn = document.getElementById('cancelMemoBtn');
  var saveMemoBtn = document.getElementById('saveMemoBtn');
  var memoTitleInput = document.getElementById('memoTitle');
  var memoContentInput = document.getElementById('memoContent');

  function getPat() { return localStorage.getItem('github_pat'); }

  function checkAuth() {
    var pat = getPat();
    if (pat) {
      authContainer.classList.add('hidden');
      memosContainer.classList.remove('hidden');
      newMemoBtn.classList.remove('hidden');
      newMemoBtn.classList.add('inline-flex');
      fetchMemos();
    } else {
      authContainer.classList.remove('hidden');
      memosContainer.classList.add('hidden');
      newMemoBtn.classList.add('hidden');
      newMemoBtn.classList.remove('inline-flex');
    }
  }

  saveAuthBtn.addEventListener('click', function() {
    var pat = patInput.value.trim();
    if (pat) {
      localStorage.setItem('github_pat', pat);
      checkAuth();
    }
  });

  newMemoBtn.addEventListener('click', function() {
    memoModal.classList.remove('hidden');
    memoTitleInput.value = '';
    memoContentInput.value = '';
  });

  closeModalBtn.addEventListener('click', function() { memoModal.classList.add('hidden'); });
  cancelMemoBtn.addEventListener('click', function() { memoModal.classList.add('hidden'); });

  async function fetchMemos() {
    var pat = getPat();
    if (!pat) return;

    try {
      var response = await fetch('https://api.github.com/repos/' + REPO + '/contents/' + MEMO_PATH, {
        headers: { 'Authorization': 'Bearer ' + pat, 'Accept': 'application/vnd.github.v3+json' }
      });

      if (!response.ok) {
        if (response.status === 401) { 
          localStorage.removeItem('github_pat'); 
          checkAuth(); 
          return; 
        }
        if (response.status === 404) { 
          memosContainer.innerHTML = '<div class="text-text-muted font-mono text-xs text-center py-12 bg-card border border-border rounded-xl p-8">저장된 메모가 없습니다. 첫 비밀 메모를 작성해보세요.</div>'; 
          return; 
        }
        throw new Error('Failed');
      }

      var files = await response.json();
      if (!files.length) { 
        memosContainer.innerHTML = '<div class="text-text-muted font-mono text-xs text-center py-12 bg-card border border-border rounded-xl p-8">저장된 메모가 없습니다.</div>'; 
        return; 
      }

      memosContainer.innerHTML = '<div class="grid grid-cols-1 md:grid-cols-2 gap-4"></div>';
      var grid = memosContainer.firstChild;

      for (var i = 0; i < files.length; i++) {
        var file = files[i];
        if (!file.name.endsWith('.md')) continue;
        var contentRes = await fetch(file.url, { 
          headers: { 
            'Authorization': 'Bearer ' + pat, 
            'Accept': 'application/vnd.github.raw' 
          } 
        });
        var text = await contentRes.text();

        var title = file.name.replace('.md', '');
        var body = text;
        var date = '';
        var fmMatch = text.match(/^---\n([\s\S]*?)\n---\n([\s\S]*)$/);
        if (fmMatch) {
          var fm = fmMatch[1];
          body = fmMatch[2].trim();
          var titleMatch = fm.match(/title:\s*["']?(.*?)["']?$/m);
          var dateMatch = fm.match(/date:\s*["']?(.*?)["']?$/m);
          if (titleMatch) title = titleMatch[1].trim();
          if (dateMatch) date = dateMatch[1].trim().substring(0, 10);
        }

        var el = document.createElement('div');
        el.className = 'bg-card border border-border rounded-lg p-5 flex flex-col justify-between hover:border-borderHover transition-all';
        el.innerHTML = '<div><div class="flex items-center justify-between mb-2"><h3 class="text-base font-semibold text-text-primary tracking-tight">' + title + '</h3>' + (date ? '<span class="text-[11px] font-mono text-text-muted">' + date + '</span>' : '') + '</div><div class="text-text-secondary text-xs font-mono leading-relaxed line-clamp-4 whitespace-pre-wrap">' + body.substring(0, 240) + '</div></div>';
        grid.appendChild(el);
      }
    } catch (e) {
      console.error(e);
      memosContainer.innerHTML = '<div class="text-rose-400 font-mono text-xs text-center py-8">메모 목록을 불러오지 못했습니다. 토큰 권한을 확인해주세요.</div>';
    }
  }

  saveMemoBtn.addEventListener('click', async function() {
    var pat = getPat();
    var title = memoTitleInput.value.trim();
    var content = memoContentInput.value.trim();
    if (!pat || !title || !content) return;

    saveMemoBtn.textContent = '저장 중...';
    saveMemoBtn.disabled = true;

    var now = new Date();
    var pad = function(n) { return n.toString().padStart(2, '0'); };
    var dateStr = now.getFullYear() + '-' + pad(now.getMonth()+1) + '-' + pad(now.getDate());
    var filename = dateStr + '-' + title.toLowerCase().replace(/[^a-z0-9가-힣]+/g, '-') + '.md';
    var fileContent = '---\ntitle: "' + title + '"\ndate: ' + now.toISOString() + '\n---\n' + content;

    try {
      var response = await fetch('https://api.github.com/repos/' + REPO + '/contents/' + MEMO_PATH + '/' + filename, {
        method: 'PUT',
        headers: { 'Authorization': 'Bearer ' + pat, 'Content-Type': 'application/json' },
        body: JSON.stringify({ message: 'memo: ' + title, content: btoa(unescape(encodeURIComponent(fileContent))) })
      });
      if (response.ok) { 
        memoModal.classList.add('hidden'); 
        fetchMemos(); 
      } else { 
        alert('저장에 실패했습니다.'); 
      }
    } catch (e) { 
      alert('오류가 발생했습니다.'); 
    } finally { 
      saveMemoBtn.textContent = '저장하기'; 
      saveMemoBtn.disabled = false; 
    }
  });

  checkAuth();
</script>
