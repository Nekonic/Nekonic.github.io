---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Compose Tweet" description="Write a new tweet">
  <div class="max-w-xl mx-auto py-6">
    <div class="flex items-center justify-between mb-6 pb-4 border-b border-border/70">
      <h1 class="text-xl font-bold text-white tracking-tight">새 트윗 작성</h1>
      <button id="openTokenBtn" class="text-xs font-mono text-accent hover:text-accent-hover transition-colors flex items-center gap-1">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        <span>GitHub 토큰 관리</span>
      </button>
    </div>

    <!-- Compose Box (JetBrains IDE prompt style) -->
    <div class="bg-card border border-border rounded-xl p-5 shadow-sm">
      <div class="flex gap-4">
        <img src="https://github.com/Nekonic.png" alt="Nekonic" class="w-10 h-10 rounded-lg border border-border object-cover flex-shrink-0">
        <div class="flex-grow flex flex-col gap-3">
          <textarea 
            id="tweetInput" 
            class="w-full bg-transparent text-text-primary text-base resize-none focus:outline-none min-h-[130px] placeholder:text-text-muted leading-relaxed"
            placeholder="무슨 일이 일어나고 있나요?"
            maxlength="280"
          ></textarea>
          
          <!-- 첨부한 사진 (최대 4장) -->
          <div id="mediaPreview" class="hidden grid grid-cols-2 gap-2"></div>
          <input id="mediaInput" type="file" accept="image/*,.heic,.heif,video/mp4,video/webm,video/quicktime" multiple class="hidden" />

          <div class="border-t border-border/60 pt-3 flex justify-between items-center">
            <div class="flex items-center gap-3">
              <button id="mediaBtn" type="button" title="사진·GIF·영상 추가 (최대 4개, 붙여넣기·끌어놓기도 됩니다)" aria-label="사진·영상 추가" class="w-8 h-8 -ml-1.5 rounded-full flex items-center justify-center text-[#1d9bf0] hover:bg-[#1d9bf0]/10 transition-colors disabled:opacity-40 disabled:cursor-not-allowed">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 5.5C3 4.12 4.12 3 5.5 3h13C19.88 3 21 4.12 21 5.5v13c0 1.38-1.12 2.5-2.5 2.5h-13C4.12 21 3 19.88 3 18.5v-13zM5.5 5c-.28 0-.5.22-.5.5v9.09l3.29-3.3c.39-.39 1.03-.39 1.42 0L13 14.59l1.79-1.8c.39-.39 1.03-.39 1.42 0L19 15.59V5.5c0-.28-.22-.5-.5-.5h-13zM19 18.41l-3.5-3.5-1.79 1.8c-.39.39-1.03.39-1.42 0L9 13.41l-4 4v1.09c0 .28.22.5.5.5h13c.28 0 .5-.22.5-.5v-.09zM15.5 7.5a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3z"/></svg>
              </button>
              <span id="charCount" class="text-xs font-mono text-text-muted">0 / 280</span>
            </div>
            <button 
              id="postBtn" 
              disabled 
              class="px-4 py-1.5 bg-accent hover:bg-accent-hover text-white rounded-md text-xs font-semibold tracking-wide transition-colors disabled:opacity-40 disabled:cursor-not-allowed shadow-xs"
            >
              게시하기
            </button>
          </div>
        </div>
      </div>
    </div>
    
    <div id="statusMsg" class="hidden px-4 py-3 rounded-lg text-xs font-mono mt-4"></div>

    <!-- Token Modal -->
    <div id="tokenModal" class="hidden fixed inset-0 bg-black/60 backdrop-blur-xs z-50 flex items-center justify-center p-4">
      <div class="bg-card border border-border rounded-xl w-full max-w-md p-6 shadow-xl">
        <div class="flex justify-between items-center mb-4">
          <h2 class="text-base font-bold text-white">GitHub Personal Access Token</h2>
          <button id="closeTokenBtn" class="text-text-muted hover:text-white text-lg">&times;</button>
        </div>
        <p class="text-xs text-text-secondary mb-4 leading-relaxed">
          트윗 및 비공개 메모 작성을 위해 Classic PAT (<code class="text-accent">repo</code> 권한 필요)를 입력하세요. 브라우저 localStorage에만 저장됩니다.
        </p>
        <input 
          type="password" 
          id="patInput" 
          class="w-full bg-primary border border-border rounded-md px-3 py-2 text-xs font-mono text-text-primary focus:outline-none focus:border-accent mb-4" 
          placeholder="ghp_xxxxxxxxxxxx"
        />
        <div class="flex justify-end gap-2">
          <button id="cancelTokenBtn" class="px-3 py-1.5 bg-secondary text-text-secondary hover:text-white rounded-md text-xs font-medium transition-colors">
            취소
          </button>
          <button id="saveTokenBtn" class="px-4 py-1.5 bg-accent hover:bg-accent-hover text-white rounded-md text-xs font-semibold transition-colors">
            저장
          </button>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline src="/js/heic.js"></script>
<script is:inline>
  const tweetInput = document.getElementById('tweetInput');
  const charCount = document.getElementById('charCount');
  const postBtn = document.getElementById('postBtn');
  const statusMsg = document.getElementById('statusMsg');
  const tokenModal = document.getElementById('tokenModal');
  const openTokenBtn = document.getElementById('openTokenBtn');
  const closeTokenBtn = document.getElementById('closeTokenBtn');
  const cancelTokenBtn = document.getElementById('cancelTokenBtn');
  const saveTokenBtn = document.getElementById('saveTokenBtn');
  const patInput = document.getElementById('patInput');
  
  const REPO = 'Nekonic/Nekonic.github.io';
  const PATH = 'src/content/tweets';

  const mediaBtn = document.getElementById('mediaBtn');
  const mediaInput = document.getElementById('mediaInput');
  const mediaPreview = document.getElementById('mediaPreview');
  const MAX_MEDIA = 4;
  // 브라우저에서 바로 보이는 형식만 받습니다 (확장자도 형식에서 정합니다)
  const TYPES = {
    'image/png': 'png', 'image/jpeg': 'jpg', 'image/gif': 'gif', 'image/webp': 'webp',
    'video/mp4': 'mp4', 'video/webm': 'webm', 'video/quicktime': 'mov'
  };
  // GitHub API가 큰 요청에서 자주 끊겨서 사진 10MB, 영상 25MB까지만 받습니다
  const MAX_IMAGE = 10 * 1024 * 1024;
  const MAX_VIDEO = 25 * 1024 * 1024;
  var media = []; // { file, url, video }
  var posting = false;
  var converting = false; // HEIC 변환 중

  function updatePostState() {
    var len = tweetInput.value.trim().length;
    charCount.textContent = tweetInput.value.length + ' / 280';
    postBtn.disabled = posting || converting || !((len > 0 || media.length > 0) && tweetInput.value.length <= 280);
    mediaBtn.disabled = posting || converting || media.length >= MAX_MEDIA;
    tweetInput.readOnly = posting;
    mediaPreview.querySelectorAll('button').forEach(function(b) { b.disabled = posting; });
  }

  tweetInput.addEventListener('input', function() {
    updatePostState();
    tweetInput.style.height = 'auto';
    tweetInput.style.height = tweetInput.scrollHeight + 'px';
  });

  function renderMedia() {
    mediaPreview.innerHTML = '';
    mediaPreview.classList.toggle('hidden', media.length === 0);
    mediaPreview.classList.toggle('grid-cols-2', media.length > 1);
    mediaPreview.classList.toggle('grid-cols-1', media.length === 1);
    media.forEach(function(m, i) {
      var box = document.createElement('div');
      box.className = 'relative rounded-xl overflow-hidden border border-border bg-primary';
      var img = document.createElement(m.video ? 'video' : 'img');
      img.src = m.url;
      if (m.video) { img.controls = true; img.muted = true; img.playsInline = true; img.preload = 'metadata'; }
      else img.alt = '첨부 ' + (i + 1) + '/' + media.length;
      img.className = 'w-full object-cover bg-black ' + (media.length === 1 ? 'max-h-[360px]' : 'h-40');
      var del = document.createElement('button');
      del.type = 'button';
      del.title = '빼기';
      del.setAttribute('aria-label', '첨부 빼기');
      del.className = 'absolute top-1.5 right-1.5 w-7 h-7 rounded-full bg-black/70 hover:bg-black/90 text-white text-base leading-none flex items-center justify-center';
      del.textContent = '×';
      del.addEventListener('click', function() {
        if (posting) return;
        URL.revokeObjectURL(m.url);
        media.splice(i, 1);
        renderMedia();
      });
      box.append(img, del);
      mediaPreview.append(box);
    });
    updatePostState();
  }

  // 변환 중에 또 넣은 파일은 앞의 변환이 끝난 뒤 차례로 넣습니다
  var addQueue = Promise.resolve();
  function addMedia(files) {
    if (posting) return false;
    var list = Array.prototype.slice.call(files);
    if (!list.length) return false;
    addQueue = addQueue.then(function() { return addMediaNow(list); })
      .catch(function(e) { showStatus('첨부하지 못했어요: ' + e.message, true); });
    return true;
  }

  async function addMediaNow(list) {
    if (posting) return;
    var bad = [], big = [], ok = [], failed = [];
    function check(f) {
      if (!TYPES[f.type]) bad.push(f.name || f.type || '알 수 없는 파일');
      else if (f.size > (f.type.indexOf('video/') === 0 ? MAX_VIDEO : MAX_IMAGE)) big.push(f.name || f.type);
      else ok.push(f);
    }
    list.forEach(function(f) { window.Heic.isHeic(f) ? ok.push(f) : check(f); });
    var room = Math.max(0, MAX_MEDIA - media.length);
    var over = ok.length > room;
    ok = ok.slice(0, room); // 넣을 자리가 없는 HEIC는 변환하지 않습니다
    if (ok.some(window.Heic.isHeic)) {
      converting = true;
      updatePostState();
      showStatus('HEIC 사진을 변환하는 중...', false, true);
      try {
        var conv = await window.Heic.convertFiles(ok);
        failed = conv.failed;
        ok = [];
        conv.files.forEach(check); // 변환한 파일도 크기를 다시 봅니다
      } finally {
        converting = false;
      }
      statusMsg.classList.add('hidden');
    }
    var msgs = [];
    if (failed.length) msgs.push('HEIC 사진을 바꾸지 못했어요: ' + failed.join(', '));
    if (bad.length) msgs.push('넣을 수 없는 형식이에요 (png, jpg, gif, webp, heic, mp4, webm, mov만 돼요): ' + bad.join(', '));
    if (big.length) msgs.push('너무 커요 (사진 10MB, 영상 25MB까지): ' + big.join(', '));
    if (over) msgs.push('사진·영상은 최대 ' + MAX_MEDIA + '개까지 넣을 수 있어요.');
    if (msgs.length) showStatus(msgs.join(' / '), true);
    ok.forEach(function(f) { media.push({ file: f, url: URL.createObjectURL(f), video: f.type.indexOf('video/') === 0 }); });
    renderMedia();
  }

  mediaBtn.addEventListener('click', function() { mediaInput.click(); });
  mediaInput.addEventListener('change', function() { addMedia(mediaInput.files); mediaInput.value = ''; });
  tweetInput.addEventListener('paste', function(e) {
    var cd = e.clipboardData;
    // 엑셀·워드처럼 글과 그림이 같이 오면 글을 붙입니다
    if (!cd || !cd.files.length || cd.getData('text/plain')) return;
    e.preventDefault();
    addMedia(cd.files);
  });
  // 페이지 어디에 떨어뜨려도 첨부로 받습니다 (브라우저가 파일을 열며 쓰던 글이 날아가지 않게)
  window.addEventListener('dragover', function(e) { e.preventDefault(); });
  window.addEventListener('drop', function(e) {
    e.preventDefault();
    if (e.dataTransfer && e.dataTransfer.files.length) addMedia(e.dataTransfer.files);
  });

  function fileToBase64(file) {
    return new Promise(function(resolve, reject) {
      var r = new FileReader();
      r.onload = function() { resolve(String(r.result).split(',')[1]); };
      r.onerror = reject;
      r.readAsDataURL(file);
    });
  }

  function extOf(file) {
    return TYPES[file.type];
  }

  async function gh(path, method, body, pat) {
    var res = await fetch('https://api.github.com/repos/' + REPO + path, {
      method: method,
      headers: { 'Authorization': 'Bearer ' + pat, 'Content-Type': 'application/json' },
      body: body ? JSON.stringify(body) : undefined
    });
    var data = await res.json().catch(function() { return {}; });
    if (!res.ok) throw new Error(data.message || ('HTTP ' + res.status));
    return data;
  }

  // 트윗 글과 첨부를 한 커밋으로 올립니다 (배포도 한 번).
  // 파일은 하나씩 읽어 바로 올리고 놓아서, 큰 파일 여러 개를 메모리에 동시에 들고 있지 않습니다.
  async function commitTweet(pat, files, message, onProgress) {
    var entries = [];
    for (var i = 0; i < files.length; i++) {
      if (onProgress) onProgress(i + 1, files.length);
      var f = files[i];
      var body = f.file
        ? { content: await fileToBase64(f.file), encoding: 'base64' }
        : { content: f.text, encoding: 'utf-8' };
      var blob = await gh('/git/blobs', 'POST', body, pat);
      body = null;
      entries.push({ path: f.path, mode: '100644', type: 'blob', sha: blob.sha });
    }
    var branch = (await gh('', 'GET', null, pat)).default_branch;
    // 그사이 main이 움직였으면(fast forward 아님) 올린 파일은 그대로 두고 커밋만 다시 만듭니다
    for (var attempt = 0; ; attempt++) {
      var ref = await gh('/git/ref/heads/' + branch, 'GET', null, pat);
      var base = await gh('/git/commits/' + ref.object.sha, 'GET', null, pat);
      var tree = await gh('/git/trees', 'POST', { base_tree: base.tree.sha, tree: entries }, pat);
      var commit = await gh('/git/commits', 'POST', { message: message, tree: tree.sha, parents: [ref.object.sha] }, pat);
      try {
        await gh('/git/refs/heads/' + branch, 'PATCH', { sha: commit.sha }, pat);
        return;
      } catch (e) {
        if (attempt >= 2 || !/fast forward/i.test(e.message)) throw e;
      }
    }
  }

  var statusTimer = null;
  function showStatus(msg, isError, keep) {
    clearTimeout(statusTimer); // 앞 문구의 타이머가 새 문구를 지우지 않게
    statusTimer = null;
    statusMsg.textContent = msg;
    statusMsg.className = 'px-4 py-3 rounded-lg text-xs font-mono mt-4 ' + (isError ? 'bg-red-950/40 text-red-400 border border-red-900/50' : 'bg-emerald-950/40 text-emerald-400 border border-emerald-900/50');
    statusMsg.classList.remove('hidden');
    if (!keep) statusTimer = setTimeout(function() { statusMsg.classList.add('hidden'); }, 6000);
  }

  function openModal() {
    patInput.value = localStorage.getItem('github_pat') || '';
    tokenModal.classList.remove('hidden');
  }
  function closeModal() {
    tokenModal.classList.add('hidden');
  }

  openTokenBtn.addEventListener('click', openModal);
  closeTokenBtn.addEventListener('click', closeModal);
  cancelTokenBtn.addEventListener('click', closeModal);
  saveTokenBtn.addEventListener('click', function() {
    var val = patInput.value.trim();
    if (val) {
      localStorage.setItem('github_pat', val);
      closeModal();
      showStatus('토큰이 저장되었습니다.', false);
    }
  });

  postBtn.addEventListener('click', async function() {
    var pat = localStorage.getItem('github_pat');
    if (!pat) {
      openModal();
      showStatus('GitHub 토큰을 먼저 입력해주세요.', true);
      return;
    }

    var content = tweetInput.value.trim();
    if (posting || (!content && media.length === 0)) return;

    // 올리는 동안은 글과 첨부를 바꿀 수 없게 막고, 시작할 때의 첨부만 씁니다
    posting = true;
    var items = media.slice();
    updatePostState();
    postBtn.textContent = '게시 중...';

    var now = new Date();
    var pad = function(n) { return n.toString().padStart(2, '0'); };
    var dateStr = now.getFullYear() + '-' + pad(now.getMonth()+1) + '-' + pad(now.getDate());
    var timeStr = pad(now.getHours()) + pad(now.getMinutes()) + pad(now.getSeconds());
    var stem = dateStr + '-' + timeStr;

    try {
      var files = [];
      var mediaPaths = [];
      items.forEach(function(m, i) {
        var publicPath = '/assets/tweets/' + stem + '/' + (i + 1) + '.' + extOf(m.file);
        mediaPaths.push(publicPath);
        files.push({ path: 'public' + publicPath, file: m.file });
      });
      var fileContent = '---\ntitle: "' + dateStr + ' tweet"\ndate: ' + now.toISOString() + '\nlayout: tweet\n'
        + (mediaPaths.length ? 'media: ' + JSON.stringify(mediaPaths).replace(/","/g, '", "') + '\n' : '')
        + '---\n' + content;
      files.push({ path: PATH + '/' + stem + '.md', text: fileContent });

      var summary = content ? content.substring(0, 30) : '미디어';
      await commitTweet(pat, files, 'tweet: ' + summary + (items.length ? ' (+' + items.length + ' media)' : ''), function(n, total) {
        if (items.length && n <= items.length) postBtn.textContent = '올리는 중 ' + n + '/' + items.length;
        else postBtn.textContent = '게시 중...';
      });

      showStatus('트윗이 성공적으로 게시되었습니다! 잠시 후 GitHub Pages에 반영됩니다.', false);
      tweetInput.value = '';
      tweetInput.style.height = 'auto';
      media.forEach(function(m) { URL.revokeObjectURL(m.url); });
      media = [];
    } catch (e) {
      showStatus('게시 실패: ' + (e && e.message ? e.message : '네트워크 오류'), true);
    } finally {
      posting = false;
      postBtn.textContent = '게시하기';
      renderMedia();
    }
  });

  if (!localStorage.getItem('github_pat')) {
    setTimeout(openModal, 400);
  }
</script>
