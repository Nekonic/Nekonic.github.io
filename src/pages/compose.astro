---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Compose Tweet" description="Write a new tweet">
  <div class="max-w-xl mx-auto py-6">
    <div class="flex items-center justify-between mb-6 pb-4 border-b border-border/70">
      <h1 class="text-xl font-bold text-white tracking-tight">새 트윗 작성</h1>
      <button id="openTokenBtn" class="text-xs font-mono text-accent hover:text-accent-hover transition-colors flex items-center gap-1">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        <span>GitHub 토큰 관리</span>
      </button>
    </div>

    <!-- Compose Box (JetBrains IDE prompt style) -->
    <div class="bg-card border border-border rounded-xl p-5 shadow-sm">
      <div class="flex gap-4">
        <img src="https://github.com/Nekonic.png" alt="Nekonic" class="w-10 h-10 rounded-lg border border-border object-cover flex-shrink-0">
        <div class="flex-grow flex flex-col gap-3">
          <textarea 
            id="tweetInput" 
            class="w-full bg-transparent text-text-primary text-base resize-none focus:outline-none min-h-[130px] placeholder:text-text-muted leading-relaxed"
            placeholder="무슨 일이 일어나고 있나요?"
            maxlength="280"
          ></textarea>
          
          <div class="border-t border-border/60 pt-3 flex justify-between items-center">
            <span id="charCount" class="text-xs font-mono text-text-muted">0 / 280</span>
            <button 
              id="postBtn" 
              disabled 
              class="px-4 py-1.5 bg-accent hover:bg-accent-hover text-white rounded-md text-xs font-semibold tracking-wide transition-colors disabled:opacity-40 disabled:cursor-not-allowed shadow-xs"
            >
              게시하기
            </button>
          </div>
        </div>
      </div>
    </div>
    
    <div id="statusMsg" class="hidden px-4 py-3 rounded-lg text-xs font-mono mt-4"></div>

    <!-- Token Modal -->
    <div id="tokenModal" class="hidden fixed inset-0 bg-black/60 backdrop-blur-xs z-50 flex items-center justify-center p-4">
      <div class="bg-card border border-border rounded-xl w-full max-w-md p-6 shadow-xl">
        <div class="flex justify-between items-center mb-4">
          <h2 class="text-base font-bold text-white">GitHub Personal Access Token</h2>
          <button id="closeTokenBtn" class="text-text-muted hover:text-white text-lg">&times;</button>
        </div>
        <p class="text-xs text-text-secondary mb-4 leading-relaxed">
          트윗 및 비공개 메모 작성을 위해 Classic PAT (<code class="text-accent">repo</code> 권한 필요)를 입력하세요. 브라우저 localStorage에만 저장됩니다.
        </p>
        <input 
          type="password" 
          id="patInput" 
          class="w-full bg-primary border border-border rounded-md px-3 py-2 text-xs font-mono text-text-primary focus:outline-none focus:border-accent mb-4" 
          placeholder="ghp_xxxxxxxxxxxx"
        />
        <div class="flex justify-end gap-2">
          <button id="cancelTokenBtn" class="px-3 py-1.5 bg-secondary text-text-secondary hover:text-white rounded-md text-xs font-medium transition-colors">
            취소
          </button>
          <button id="saveTokenBtn" class="px-4 py-1.5 bg-accent hover:bg-accent-hover text-white rounded-md text-xs font-semibold transition-colors">
            저장
          </button>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  const tweetInput = document.getElementById('tweetInput');
  const charCount = document.getElementById('charCount');
  const postBtn = document.getElementById('postBtn');
  const statusMsg = document.getElementById('statusMsg');
  const tokenModal = document.getElementById('tokenModal');
  const openTokenBtn = document.getElementById('openTokenBtn');
  const closeTokenBtn = document.getElementById('closeTokenBtn');
  const cancelTokenBtn = document.getElementById('cancelTokenBtn');
  const saveTokenBtn = document.getElementById('saveTokenBtn');
  const patInput = document.getElementById('patInput');
  
  const REPO = 'Nekonic/Nekonic.github.io';
  const PATH = '_tweets';

  tweetInput.addEventListener('input', function() {
    var len = tweetInput.value.length;
    charCount.textContent = len + ' / 280';
    postBtn.disabled = !(len > 0 && len <= 280);
    tweetInput.style.height = 'auto';
    tweetInput.style.height = tweetInput.scrollHeight + 'px';
  });

  function showStatus(msg, isError) {
    statusMsg.textContent = msg;
    statusMsg.className = 'px-4 py-3 rounded-lg text-xs font-mono mt-4 ' + (isError ? 'bg-red-950/40 text-red-400 border border-red-900/50' : 'bg-emerald-950/40 text-emerald-400 border border-emerald-900/50');
    statusMsg.classList.remove('hidden');
    setTimeout(function() { statusMsg.classList.add('hidden'); }, 6000);
  }

  function openModal() {
    patInput.value = localStorage.getItem('github_pat') || '';
    tokenModal.classList.remove('hidden');
  }
  function closeModal() {
    tokenModal.classList.add('hidden');
  }

  openTokenBtn.addEventListener('click', openModal);
  closeTokenBtn.addEventListener('click', closeModal);
  cancelTokenBtn.addEventListener('click', closeModal);
  saveTokenBtn.addEventListener('click', function() {
    var val = patInput.value.trim();
    if (val) {
      localStorage.setItem('github_pat', val);
      closeModal();
      showStatus('토큰이 저장되었습니다.', false);
    }
  });

  postBtn.addEventListener('click', async function() {
    var pat = localStorage.getItem('github_pat');
    if (!pat) {
      openModal();
      showStatus('GitHub 토큰을 먼저 입력해주세요.', true);
      return;
    }

    var content = tweetInput.value.trim();
    if (!content) return;

    postBtn.disabled = true;
    postBtn.textContent = '게시 중...';

    var now = new Date();
    var pad = function(n) { return n.toString().padStart(2, '0'); };
    var dateStr = now.getFullYear() + '-' + pad(now.getMonth()+1) + '-' + pad(now.getDate());
    var timeStr = pad(now.getHours()) + pad(now.getMinutes()) + pad(now.getSeconds());
    var filename = dateStr + '-' + timeStr + '.md';

    var fileContent = '---\ntitle: "' + dateStr + ' tweet"\ndate: ' + now.toISOString() + '\nlayout: tweet\n---\n' + content;

    try {
      var response = await fetch('https://api.github.com/repos/' + REPO + '/contents/' + PATH + '/' + filename, {
        method: 'PUT',
        headers: {
          'Authorization': 'Bearer ' + pat,
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          message: 'tweet: ' + content.substring(0, 30),
          content: btoa(unescape(encodeURIComponent(fileContent)))
        })
      });

      if (response.ok) {
        showStatus('트윗이 성공적으로 게시되었습니다! 잠시 후 GitHub Pages에 반영됩니다.', false);
        tweetInput.value = '';
        charCount.textContent = '0 / 280';
        tweetInput.style.height = 'auto';
      } else {
        var err = await response.json();
        showStatus('게시 실패: ' + err.message, true);
      }
    } catch (e) {
      showStatus('네트워크 통신 오류가 발생했습니다.', true);
    } finally {
      postBtn.disabled = false;
      postBtn.textContent = '게시하기';
    }
  });

  if (!localStorage.getItem('github_pat')) {
    setTimeout(openModal, 400);
  }
</script>
