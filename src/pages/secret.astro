---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout
  title="Private Post"
  description="Private post"
  tab="private.md"
  tabIcon="lock"
  crumbs={[{ label: 'posts', href: '/blog' }, 'private']}
  status={['Private', 'UTF-8', 'Markdown']}
>
  <span slot="crumbs-end" class="ml-auto font-mono hidden sm:inline">Reader Mode</span>

  <!-- 토큰 없음 -->
  <div id="needAuth" class="hidden max-w-md mx-auto bg-secondary border border-border rounded-xl p-6">
    <div class="w-10 h-10 rounded-lg bg-primary border border-border flex items-center justify-center text-accent-soft mb-4">
      <Icon name="lock" size={18} />
    </div>
    <h1 class="text-base font-bold text-white mb-1.5">비밀글입니다</h1>
    <p class="text-xs text-text-secondary leading-relaxed mb-4">
      이 글은 비공개 저장소에만 저장되어 있어요. <a href="/memos" class="text-accent-soft hover:text-white">Memos</a> 페이지에서 GitHub 토큰으로 로그인한 브라우저에서만 볼 수 있습니다.
    </p>
  </div>

  <p id="loading" class="text-center py-16 font-mono text-xs text-text-muted">비공개 저장소에서 글을 불러오는 중...</p>
  <p id="notFound" class="hidden text-center py-16 font-mono text-xs text-text-muted">글을 찾을 수 없거나 토큰 권한이 없습니다.</p>

  <article id="post" class="hidden flex-col">
    <header class="flex flex-col gap-3.5 pb-6 mb-8 border-b border-borderSubtle">
      <div class="flex gap-1.5 flex-wrap font-mono text-xs">
        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-secondary text-text-body"><Icon name="lock" size={11} /> private</span>
        <span id="postCats" class="contents"></span>
      </div>
      <h1 id="postTitle" class="text-[28px] lg:text-[34px] leading-tight font-bold tracking-tight text-white"></h1>
      <div class="flex items-center gap-2.5 flex-wrap font-mono text-xs text-text-secondary">
        <span class="text-text-primary">Nekonic</span>
        <span aria-hidden="true">·</span>
        <time id="postDate"></time>
        <span id="postTags"></span>
        <span class="flex-1"></span>
        <a id="editLink" href="/write" class="inline-flex items-center gap-1.5 px-2 py-1 rounded-md bg-secondary text-text-primary hover:bg-border transition-colors">
          <Icon name="pencil" size={12} /> 수정
        </a>
      </div>
    </header>
    <div id="articleBody" class="article-content"></div>
  </article>

  <div slot="aside" id="structure" class="hidden bg-primary rounded-xl pb-3">
    <div class="h-9 flex items-center px-3.5 font-semibold text-[13px]">Structure</div>
    <ul id="structureList" class="flex flex-col px-1.5 leading-[26px]"></ul>
  </div>
</BaseLayout>

<script is:inline src="https://cdn.jsdelivr.net/npm/marked@12.0.2/marked.min.js"></script>

<script>
  import { getPat, getPrivatePost, resolvePrivateImages } from '../lib/private-posts';
  import { categoryStyle } from '../lib/utils';
  import { enhanceArticle } from '../lib/enhance-article';

  const $ = (id: string) => document.getElementById(id)!;
  const show = (id: string, display = 'block') => { $(id).classList.remove('hidden'); $(id).style.display = display; };
  const hide = (id: string) => $(id).classList.add('hidden');

  function slugify(text: string, used: Set<string>) {
    let base = text.trim().toLowerCase().replace(/[^\p{L}\p{N}]+/gu, '-').replace(/^-+|-+$/g, '') || 'section';
    let slug = base;
    for (let i = 1; used.has(slug); i++) slug = `${base}-${i}`;
    used.add(slug);
    return slug;
  }

  async function main() {
    // 목차가 없으면 오른쪽 도구 창 자리를 비우지 않도록 숨김
    const rightTools = $('structure').parentElement!;
    rightTools.style.display = 'none';

    const id = new URLSearchParams(location.search).get('id');
    const pat = getPat();
    if (!pat) { hide('loading'); show('needAuth'); return; }
    if (!id) { hide('loading'); show('notFound'); return; }

    const post = await getPrivatePost(pat, id).catch(() => null);
    hide('loading');
    if (!post) { show('notFound'); return; }

    document.title = `${post.title} | Nekonic`;
    $('postTitle').textContent = post.title;
    $('postDate').textContent = post.date;
    if (post.tags.length) $('postTags').textContent = '· ' + post.tags.map((t) => `#${t}`).join(' ');
    for (const c of post.categories) {
      const s = categoryStyle(c);
      const chip = document.createElement('span');
      chip.className = 'px-2 py-0.5 rounded';
      chip.style.background = s.chipBg;
      chip.style.color = s.chipText;
      chip.textContent = c;
      $('postCats').append(chip);
    }
    ($('editLink') as HTMLAnchorElement).href = `/write?secret=${encodeURIComponent(post.id)}`;

    // 정렬 문법: ![alt](url){left|right|center}
    const src = post.body.replace(
      /!\[([^\]]*)\]\(([^)\s]+)\)\{:?\s*\.?(?:align-)?(left|right|center)(?:-block)?\s*:?\}/g,
      (_m, alt, url, a) => `<img src="${url}" alt="${alt}" class="img-${a}">`,
    );
    const body = $('articleBody');
    body.innerHTML = (window as any).marked.parse(src);
    enhanceArticle(body);
    resolvePrivateImages(body, pat);

    // Structure (목차)
    const used = new Set<string>();
    const list = $('structureList');
    body.querySelectorAll<HTMLHeadingElement>('h2, h3, h4').forEach((h) => {
      h.id = slugify(h.textContent || '', used);
      const depth = Number(h.tagName[1]);
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = `#${h.id}`;
      a.className = 'flex items-center gap-2 pr-2 rounded-[5px] text-text-body hover:bg-secondary transition-colors';
      a.style.paddingLeft = `${0.5 + (depth - 2) * 0.875}rem`;
      const badge = document.createElement('span');
      badge.className = 'font-mono text-[10px] font-semibold text-text-muted shrink-0';
      badge.textContent = `H${depth}`;
      const label = document.createElement('span');
      label.className = 'truncate';
      label.textContent = h.textContent;
      a.append(badge, label);
      li.append(a);
      list.append(li);
    });
    if (list.children.length) {
      show('structure');
      rightTools.style.display = '';
    }

    show('post', 'flex');
  }

  main();
</script>
