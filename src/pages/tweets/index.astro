---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TweetCard from '../../components/TweetCard.astro';
import { getCollection } from 'astro:content';

let allTweets: any[] = [];
try {
  allTweets = await getCollection('tweets');
} catch {}

const sortedTweets = allTweets.sort((a, b) => {
  const dateA = a.data?.date ? new Date(a.data.date).valueOf() : 0;
  const dateB = b.data?.date ? new Date(b.data.date).valueOf() : 0;
  return dateB - dateA;
});
---

<BaseLayout title="Tweets" description="Short thoughts and updates">
  <div class="max-w-2xl mx-auto">
    <div class="mb-8 flex justify-between items-center pb-6 border-b border-borderSubtle">
      <div>
        <h1 class="text-2xl lg:text-3xl font-bold text-white tracking-tight">Tweets</h1>
        <p class="text-xs font-mono text-text-muted mt-1">Short thoughts, quick updates, and micro-logs</p>
      </div>
      <a 
        href="/compose" 
        class="inline-flex items-center gap-1.5 px-3.5 py-1.5 bg-accent hover:bg-accent-hover text-white rounded-md text-xs font-semibold tracking-wide transition-colors shadow-xs"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
        작성하기
      </a>
    </div>
    
    <div id="tweetsContainer" class="flex flex-col gap-4">
      {sortedTweets.map(tweet => (
        <TweetCard 
          id={tweet.id}
          content={tweet.body}
          date={tweet.data?.date ? new Date(tweet.data.date) : undefined}
          media={tweet.data?.media}
          file={tweet.filePath}
        />
      ))}
    </div>

    <div id="emptyTweets" class:list={["text-center py-16 bg-card border border-borderSubtle rounded-xl p-8", sortedTweets.length > 0 && "hidden"]}>
      <div class="w-12 h-12 rounded-full bg-secondary border border-borderSubtle flex items-center justify-center mx-auto mb-3 text-text-muted">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      </div>
      <p class="text-sm text-text-secondary font-medium mb-1">아직 작성된 트윗이 없습니다.</p>
      <p class="text-xs text-text-muted mb-4 font-mono">새로운 소식이나 짧은 메모를 남겨보세요.</p>
      <a 
        href="/compose" 
        class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-secondary border border-borderSubtle hover:border-accent text-text-primary rounded-md text-xs font-medium transition-colors"
      >
        첫 트윗 작성하기 &rarr;
      </a>
    </div>
  </div>
</BaseLayout>

<style is:global>
  @keyframes heart-burst {
    0% { transform: scale(1); }
    50% { transform: scale(1.4); }
    100% { transform: scale(1); }
  }
  .animate-heart-burst {
    animation: heart-burst 0.3s cubic-bezier(0.17, 0.89, 0.32, 1.49);
  }
</style>

<script is:inline>
  var githubDiscussionsData = {};

  function mountGiscus(slot, term) {
    if (slot.getAttribute('data-loaded')) return;
    slot.setAttribute('data-loaded', 'true');

    var script = document.createElement('script');
    script.src = 'https://giscus.app/client.js';
    script.setAttribute('data-repo', 'Nekonic/Nekonic.github.io');
    script.setAttribute('data-repo-id', 'R_kgDOIgGsMA');
    script.setAttribute('data-category', 'General');
    script.setAttribute('data-category-id', 'DIC_kwDOIgGsMM4DG0Di');
    script.setAttribute('data-mapping', 'specific');
    script.setAttribute('data-term', term);
    script.setAttribute('data-strict', '0');
    script.setAttribute('data-reactions-enabled', '1');
    script.setAttribute('data-emit-metadata', '1');
    script.setAttribute('data-input-position', 'bottom');
    script.setAttribute('data-theme', 'transparent_dark');
    script.setAttribute('data-lang', 'ko');
    script.crossOrigin = 'anonymous';
    script.async = true;
    slot.appendChild(script);
  }

  function initTweetInteractions() {
    // 1. Reply Button (Toggle Giscus thread)
    document.querySelectorAll('.tweet-comment-btn').forEach(function(btn) {
      if (btn.getAttribute('data-bound')) return;
      btn.setAttribute('data-bound', 'true');

      btn.addEventListener('click', function(e) {
        e.preventDefault();
        var targetId = btn.getAttribute('data-target');
        var term = btn.getAttribute('data-term');
        var box = document.getElementById(targetId);
        if (!box) return;

        var isHidden = box.classList.contains('hidden');
        if (isHidden) {
          box.classList.remove('hidden');
          btn.classList.add('text-[#1d9bf0]');
          var slot = box.querySelector('.giscus-slot');
          if (slot && term) mountGiscus(slot, term);
        } else {
          box.classList.add('hidden');
          btn.classList.remove('text-[#1d9bf0]');
        }
      });
    });

    // 2. Heart / Like Button
    document.querySelectorAll('.tweet-like-btn').forEach(function(btn) {
      if (btn.getAttribute('data-bound')) return;
      btn.setAttribute('data-bound', 'true');

      var tweetId = btn.getAttribute('data-id') || 'generic';
      var heartSvg = btn.querySelector('.heart-svg');
      var countSpan = btn.querySelector('.like-count');

      function renderLikeState() {
        var isLiked = localStorage.getItem('tweet_liked_' + tweetId) === 'true';
        var ghHearts = (githubDiscussionsData[tweetId] && githubDiscussionsData[tweetId].heart) || 0;
        var totalCount = ghHearts + (isLiked ? 1 : 0);

        if (isLiked) {
          btn.classList.add('text-[#f91880]');
          btn.classList.remove('text-[#71767b]');
          if (heartSvg) {
            heartSvg.style.fill = '#f91880';
            heartSvg.style.stroke = '#f91880';
          }
        } else {
          btn.classList.remove('text-[#f91880]');
          btn.classList.add('text-[#71767b]');
          if (heartSvg) {
            heartSvg.style.fill = 'none';
            heartSvg.style.stroke = 'currentColor';
          }
        }

        if (countSpan) {
          countSpan.textContent = totalCount > 0 ? totalCount : '';
        }
      }

      renderLikeState();

      btn.addEventListener('click', function(e) {
        e.preventDefault();
        var current = localStorage.getItem('tweet_liked_' + tweetId) === 'true';
        var next = !current;
        localStorage.setItem('tweet_liked_' + tweetId, next ? 'true' : 'false');
        
        renderLikeState();

        if (next && heartSvg) {
          heartSvg.classList.add('animate-heart-burst');
          setTimeout(function() {
            heartSvg.classList.remove('animate-heart-burst');
          }, 350);

          // If unmounted, automatically open comments/Giscus box so user can also give official GitHub reaction
          var targetId = btn.getAttribute('data-target');
          var term = btn.getAttribute('data-term');
          var box = document.getElementById(targetId);
          if (box && box.classList.contains('hidden')) {
            box.classList.remove('hidden');
            var commentBtn = btn.closest('article')?.querySelector('.tweet-comment-btn');
            if (commentBtn) commentBtn.classList.add('text-[#1d9bf0]');
            var slot = box.querySelector('.giscus-slot');
            if (slot && term) mountGiscus(slot, term);
          }
        }
      });
    });

    // 3. Retweet Button
    document.querySelectorAll('.tweet-retweet-btn').forEach(function(btn) {
      if (btn.getAttribute('data-bound')) return;
      btn.setAttribute('data-bound', 'true');

      var tweetId = btn.getAttribute('data-id') || 'generic';
      var countSpan = btn.querySelector('.retweet-count');

      function renderRtState() {
        var isRt = localStorage.getItem('tweet_rt_' + tweetId) === 'true';
        if (isRt) {
          btn.classList.add('text-[#00ba7c]');
          btn.classList.remove('text-[#71767b]');
          if (countSpan) countSpan.textContent = '1';
        } else {
          btn.classList.remove('text-[#00ba7c]');
          btn.classList.add('text-[#71767b]');
          if (countSpan) countSpan.textContent = '';
        }
      }

      renderRtState();

      btn.addEventListener('click', function(e) {
        e.preventDefault();
        var current = localStorage.getItem('tweet_rt_' + tweetId) === 'true';
        var next = !current;
        localStorage.setItem('tweet_rt_' + tweetId, next ? 'true' : 'false');
        renderRtState();
      });
    });

    // 4. Share Button
    document.querySelectorAll('.tweet-share-btn').forEach(function(btn) {
      if (btn.getAttribute('data-bound')) return;
      btn.setAttribute('data-bound', 'true');

      var tweetId = btn.getAttribute('data-id');
      var shareIcon = btn.querySelector('.share-icon');
      var checkIcon = btn.querySelector('.check-icon');
      var tooltip = btn.querySelector('.copied-tooltip');

      btn.addEventListener('click', async function(e) {
        e.preventDefault();
        var url = window.location.origin + '/tweets' + (tweetId ? '#' + tweetId : '');
        try {
          await navigator.clipboard.writeText(url);
          if (shareIcon) shareIcon.classList.add('hidden');
          if (checkIcon) checkIcon.classList.remove('hidden');
          if (tooltip) tooltip.classList.remove('opacity-0');

          setTimeout(function() {
            if (shareIcon) shareIcon.classList.remove('hidden');
            if (checkIcon) checkIcon.classList.add('hidden');
            if (tooltip) tooltip.classList.add('opacity-0');
          }, 1500);
        } catch (err) {
          console.error(err);
        }
      });
    });
  }

  // GitHub Discussions 실시간 카운트 동기화
  async function fetchDiscussionsData() {
    try {
      var pat = localStorage.getItem('github_pat');
      var headers = { 'Accept': 'application/vnd.github.v3+json' };
      if (pat) headers['Authorization'] = 'Bearer ' + pat;

      var res = await fetch('https://api.github.com/repos/Nekonic/Nekonic.github.io/discussions', { headers: headers });
      if (!res.ok) return;

      var discussions = await res.json();
      if (!Array.isArray(discussions)) return;

      discussions.forEach(function(disc) {
        var m = disc.title && disc.title.match(/tweet-(.+)/);
        if (!m) return;
        var tweetId = m[1];
        githubDiscussionsData[tweetId] = {
          comments: disc.comments || 0,
          heart: (disc.reactions && disc.reactions.heart) || 0
        };

        var card = document.querySelector('[data-tweet-id="' + tweetId + '"]');
        if (!card) return;

        // Update reply count
        var replySpan = card.querySelector('.reply-count');
        if (replySpan && disc.comments > 0) {
          replySpan.textContent = disc.comments;
        }

        // Update heart count
        var isLiked = localStorage.getItem('tweet_liked_' + tweetId) === 'true';
        var heartSpan = card.querySelector('.like-count');
        var totalHearts = (disc.reactions?.heart || 0) + (isLiked ? 1 : 0);
        if (heartSpan && totalHearts > 0) {
          heartSpan.textContent = totalHearts;
        }
      });
    } catch (e) {
      console.warn('Discussions fetch:', e);
    }
  }

  // Giscus 메타데이터 수신 (실시간 하트/댓글 반영)
  window.addEventListener('message', function(event) {
    if (event.origin !== 'https://giscus.app') return;
    if (!event.data || typeof event.data.giscus !== 'object') return;

    var giscusData = event.data.giscus;
    if (giscusData.discussion) {
      var disc = giscusData.discussion;
      // 찾아서 화면 카운트 실시간 업데이트
      document.querySelectorAll('.tweet-article').forEach(function(card) {
        var slot = card.querySelector('.giscus-slot');
        if (slot && slot.getAttribute('data-loaded')) {
          var tweetId = card.getAttribute('data-tweet-id');
          if (!tweetId) return;

          var comments = disc.totalCommentCount || 0;
          var ghHearts = (disc.reactions && disc.reactions.HEART) || 0;

          githubDiscussionsData[tweetId] = { comments: comments, heart: ghHearts };

          var replySpan = card.querySelector('.reply-count');
          if (replySpan && comments > 0) replySpan.textContent = comments;

          var isLiked = localStorage.getItem('tweet_liked_' + tweetId) === 'true';
          var heartSpan = card.querySelector('.like-count');
          var total = ghHearts + (isLiked ? 1 : 0);
          if (heartSpan) heartSpan.textContent = total > 0 ? total : '';
        }
      });
    }
  });

  function parseTweet(text) {
    text = text.replace(/^\uFEFF/, '');
    var m = /^---\r?\n([\s\S]*?)\r?\n?---\r?\n?([\s\S]*)$/.exec(text);
    if (!m) return { body: text.trim(), media: [] };
    var fm = m[1], date = null, media = [];
    var d = /^date:\s*(.+)$/m.exec(fm);
    if (d) { date = new Date(d[1].trim().replace(/^['"]|['"]$/g, '')); if (isNaN(date)) date = null; }
    var md = /^media:\s*(\[.*\])\s*$/m.exec(fm);
    if (md) { try { media = JSON.parse(md[1].replace(/'/g, '"')); } catch (e) {} }
    else {
      // YAML 블록 리스트 (media:\n  - /a.png)
      var block = /^media:\s*\r?\n((?:[ \t]*-.*\r?\n?)+)/m.exec(fm);
      if (block) media = block[1].split(/\r?\n/).map(function(l) { return l.replace(/^[ \t]*-\s*/, '').trim().replace(/^['"]|['"]$/g, ''); }).filter(Boolean);
    }
    media = media.filter(function(x) { return typeof x === 'string'; });
    return { body: m[2].trim(), date: date, media: media };
  }

  function tweetTime(d) {
    var tz = { timeZone: 'Asia/Seoul' };
    return d.toLocaleTimeString('ko-KR', Object.assign({ hour: 'numeric', minute: '2-digit', hour12: true }, tz))
      + ' · ' + d.toLocaleDateString('ko-KR', Object.assign({ year: 'numeric', month: 'long', day: 'numeric' }, tz));
  }

  // 배포 전 카드: 첨부도 아직 사이트에 없어서 GitHub 원본 주소로 보여줍니다
  var RAW = 'https://raw.githubusercontent.com/Nekonic/Nekonic.github.io/main/public';
  function pendingCard(t) {
    var el = document.createElement('article');
    el.className = 'bg-card border border-borderSubtle rounded-2xl p-4 sm:p-5';
    var html = '<div class="flex items-start gap-3">'
      + '<img src="https://github.com/Nekonic.png" alt="Nekonic" class="w-10 h-10 rounded-full border border-borderSubtle object-cover flex-shrink-0" />'
      + '<div class="flex-1 min-w-0"><div class="flex items-baseline gap-1.5 flex-wrap leading-tight mb-1">'
      + '<span class="font-bold text-text-primary text-[15px]">Nekonic</span><span class="text-[14px] text-text-muted">@Nekonic</span>'
      + (t.date ? '<span class="text-[13px] text-text-muted">·</span><time class="text-[13px] text-text-muted"></time>' : '')
      + '<span class="ml-1 px-1.5 py-0.5 rounded text-[11px] font-mono bg-[#2b5bc4]/20 text-accent-soft">배포 중</span>'
      + '</div><div class="tw-body text-[#e7e9ea] whitespace-pre-wrap text-[15px] leading-relaxed mb-3 break-words"></div>'
      + '<div class="tw-media"></div></div></div>';
    el.innerHTML = html;
    if (t.date) el.querySelector('time').textContent = tweetTime(t.date);
    var body = el.querySelector('.tw-body');
    if (t.body) body.textContent = t.body; else body.remove();
    var pics = t.media.slice(0, 4);
    var box = el.querySelector('.tw-media');
    if (pics.length) {
      box.className = 'grid gap-0.5 mb-3 rounded-2xl overflow-hidden border border-borderSubtle '
        + (pics.length === 1 ? 'grid-cols-1' : 'grid-cols-2 aspect-[16/9]' + (pics.length > 2 ? ' grid-rows-2' : ''));
      pics.forEach(function(src, i) {
        var video = /\.(mp4|webm|mov|m4v|ogv)$/i.test(src);
        var cell = document.createElement('div');
        cell.className = 'min-h-0 ' + (video ? 'bg-black' : 'bg-primary') + (pics.length === 3 && i === 0 ? ' row-span-2' : '');
        var m = document.createElement(video ? 'video' : 'img');
        m.src = /^https?:/.test(src) ? src : RAW + (src[0] === '/' ? '' : '/') + encodeURI(src);
        if (video) { m.controls = true; m.playsInline = true; m.preload = 'metadata'; }
        m.setAttribute(video ? 'aria-label' : 'alt', '첨부 ' + (i + 1) + '/' + pics.length);
        m.className = 'w-full ' + (pics.length === 1 ? 'max-h-[510px] object-cover' : 'h-full object-cover');
        cell.append(m);
        box.append(cell);
      });
    } else box.remove();
    return el;
  }

  // 초기화 및 실시간 감시
  (async function() {
    initTweetInteractions();
    await fetchDiscussionsData();

    try {
      var pat = localStorage.getItem('github_pat');
      var headers = { 'Accept': 'application/vnd.github.v3+json' };
      if (pat) headers['Authorization'] = 'Bearer ' + pat;

      var res = await fetch('https://api.github.com/repos/Nekonic/Nekonic.github.io/contents/src/content/tweets', { headers: headers, cache: 'no-cache' });
      if (!res.ok) return;

      var files = await res.json();
      if (!Array.isArray(files) || !files.length) return;

      // 아직 배포 안 된 트윗만 GitHub에서 바로 읽어 맨 위에 붙입니다 (새로고침하지 않음)
      var container = document.getElementById('tweetsContainer');
      var shown = {};
      // 파일 경로로 비교합니다 (카드 id는 파일 이름을 slug로 바꾼 값이라 다를 수 있음)
      container.querySelectorAll('[data-file]').forEach(function(el) { shown[el.getAttribute('data-file')] = true; });
      var fresh = files.filter(function(f) {
        return f.type === 'file' && /\.md$/.test(f.name) && !shown[f.path];
      });
      if (!fresh.length) return;

      var tweets = await Promise.all(fresh.map(function(f) {
        return fetch(f.download_url).then(function(r) { return r.ok ? r.text() : null; }).then(function(t) { return t && parseTweet(t); }).catch(function() { return null; });
      }));
      tweets = tweets.filter(Boolean).sort(function(a, b) { return (b.date || 0) - (a.date || 0); });
      for (var i = tweets.length - 1; i >= 0; i--) container.prepend(pendingCard(tweets[i]));
      var emptyEl = document.getElementById('emptyTweets');
      if (emptyEl && tweets.length) emptyEl.classList.add('hidden');
    } catch (e) {
      console.error(e);
    }
  })();
</script>
