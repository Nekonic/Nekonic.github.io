---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TweetCard from '../../components/TweetCard.astro';
import { getCollection } from 'astro:content';

let allTweets: any[] = [];
try {
  allTweets = await getCollection('tweets');
} catch {}

const sortedTweets = allTweets.sort((a, b) => {
  const dateA = a.data?.date ? new Date(a.data.date).valueOf() : 0;
  const dateB = b.data?.date ? new Date(b.data.date).valueOf() : 0;
  return dateB - dateA;
});
---

<BaseLayout title="Tweets" description="Short thoughts and updates">
  <div class="max-w-2xl mx-auto">
    <div class="mb-8 flex justify-between items-center pb-6 border-b border-borderSubtle">
      <div>
        <h1 class="text-2xl lg:text-3xl font-bold text-white tracking-tight">Tweets</h1>
        <p class="text-xs font-mono text-text-muted mt-1">Short thoughts, quick updates, and micro-logs</p>
      </div>
      <a 
        href="/compose" 
        class="inline-flex items-center gap-1.5 px-3.5 py-1.5 bg-accent hover:bg-accent-hover text-white rounded-md text-xs font-semibold tracking-wide transition-colors shadow-xs"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
        작성하기
      </a>
    </div>
    
    <div id="tweetsContainer" class="flex flex-col gap-4">
      {sortedTweets.map(tweet => (
        <TweetCard 
          id={tweet.id}
          content={tweet.body}
          date={tweet.data?.date ? new Date(tweet.data.date) : undefined}
        />
      ))}
    </div>

    <div id="emptyTweets" class:list={["text-center py-16 bg-card border border-borderSubtle rounded-xl p-8", sortedTweets.length > 0 && "hidden"]}>
      <div class="w-12 h-12 rounded-full bg-secondary border border-borderSubtle flex items-center justify-center mx-auto mb-3 text-text-muted">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      </div>
      <p class="text-sm text-text-secondary font-medium mb-1">아직 작성된 트윗이 없습니다.</p>
      <p class="text-xs text-text-muted mb-4 font-mono">새로운 소식이나 짧은 메모를 남겨보세요.</p>
      <a 
        href="/compose" 
        class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-secondary border border-borderSubtle hover:border-accent text-text-primary rounded-md text-xs font-medium transition-colors"
      >
        첫 트윗 작성하기 &rarr;
      </a>
    </div>
  </div>
</BaseLayout>

<style is:global>
  @keyframes heart-burst {
    0% { transform: scale(1); }
    50% { transform: scale(1.35); }
    100% { transform: scale(1); }
  }
  .animate-heart-burst {
    animation: heart-burst 0.3s cubic-bezier(0.17, 0.89, 0.32, 1.49);
  }
</style>

<script is:inline>
  function initTweetInteractions() {
    function mountGiscus(slot, term) {
      if (slot.getAttribute('data-loaded')) return;
      slot.setAttribute('data-loaded', 'true');

      var script = document.createElement('script');
      script.src = 'https://giscus.app/client.js';
      script.setAttribute('data-repo', 'Nekonic/Nekonic.github.io');
      script.setAttribute('data-repo-id', 'R_kgDOIgGsMA');
      script.setAttribute('data-category', 'General');
      script.setAttribute('data-category-id', 'DIC_kwDOIgGsMM4DG0Di');
      script.setAttribute('data-mapping', 'specific');
      script.setAttribute('data-term', term);
      script.setAttribute('data-strict', '0');
      script.setAttribute('data-reactions-enabled', '1');
      script.setAttribute('data-emit-metadata', '0');
      script.setAttribute('data-input-position', 'bottom');
      script.setAttribute('data-theme', 'transparent_dark');
      script.setAttribute('data-lang', 'ko');
      script.crossOrigin = 'anonymous';
      script.async = true;
      slot.appendChild(script);
    }

    // 1. Reply Button (Toggle Giscus thread)
    document.querySelectorAll('.tweet-comment-btn').forEach(function(btn) {
      if (btn.getAttribute('data-bound')) return;
      btn.setAttribute('data-bound', 'true');

      btn.addEventListener('click', function(e) {
        e.preventDefault();
        var targetId = btn.getAttribute('data-target');
        var term = btn.getAttribute('data-term');
        var box = document.getElementById(targetId);
        if (!box) return;

        var isHidden = box.classList.contains('hidden');
        if (isHidden) {
          box.classList.remove('hidden');
          btn.classList.add('text-[#1d9bf0]');
          var slot = box.querySelector('.giscus-slot');
          if (slot && term) mountGiscus(slot, term);
        } else {
          box.classList.add('hidden');
          btn.classList.remove('text-[#1d9bf0]');
        }
      });
    });

    // 2. Heart / Like Button (Twitter style with pop animation & local persistence)
    document.querySelectorAll('.tweet-like-btn').forEach(function(btn) {
      if (btn.getAttribute('data-bound')) return;
      btn.setAttribute('data-bound', 'true');

      var tweetId = btn.getAttribute('data-id') || 'generic';
      var isLiked = localStorage.getItem('tweet_liked_' + tweetId) === 'true';
      var heartSvg = btn.querySelector('.heart-svg');
      var countSpan = btn.querySelector('.like-count');

      function updateHeartUI(liked) {
        if (!heartSvg) return;
        if (liked) {
          btn.classList.add('text-[#f91880]');
          btn.classList.remove('text-[#71767b]');
          heartSvg.setAttribute('fill', '#f91880');
          heartSvg.setAttribute('stroke', '#f91880');
          if (countSpan) countSpan.textContent = '1';
        } else {
          btn.classList.remove('text-[#f91880]');
          btn.classList.add('text-[#71767b]');
          heartSvg.setAttribute('fill', 'none');
          heartSvg.setAttribute('stroke', 'currentColor');
          if (countSpan) countSpan.textContent = '';
        }
      }

      // Initialize saved state
      if (isLiked) updateHeartUI(true);

      btn.addEventListener('click', function(e) {
        e.preventDefault();
        var currentlyLiked = localStorage.getItem('tweet_liked_' + tweetId) === 'true';
        var nextLiked = !currentlyLiked;
        localStorage.setItem('tweet_liked_' + tweetId, nextLiked ? 'true' : 'false');
        updateHeartUI(nextLiked);

        if (nextLiked && heartSvg) {
          heartSvg.classList.add('animate-heart-burst');
          setTimeout(function() {
            heartSvg.classList.remove('animate-heart-burst');
          }, 350);
        }
      });
    });

    // 3. Retweet / Repost Button (Twitter green toggle)
    document.querySelectorAll('.tweet-retweet-btn').forEach(function(btn) {
      if (btn.getAttribute('data-bound')) return;
      btn.setAttribute('data-bound', 'true');

      var tweetId = btn.getAttribute('data-id') || 'generic';
      var isRetweeted = localStorage.getItem('tweet_rt_' + tweetId) === 'true';
      var countSpan = btn.querySelector('.retweet-count');

      function updateRtUI(rt) {
        if (rt) {
          btn.classList.add('text-[#00ba7c]');
          btn.classList.remove('text-[#71767b]');
          if (countSpan) countSpan.textContent = '1';
        } else {
          btn.classList.remove('text-[#00ba7c]');
          btn.classList.add('text-[#71767b]');
          if (countSpan) countSpan.textContent = '';
        }
      }

      if (isRetweeted) updateRtUI(true);

      btn.addEventListener('click', function(e) {
        e.preventDefault();
        var current = localStorage.getItem('tweet_rt_' + tweetId) === 'true';
        var next = !current;
        localStorage.setItem('tweet_rt_' + tweetId, next ? 'true' : 'false');
        updateRtUI(next);
      });
    });

    // 4. Share / Copy Link Button
    document.querySelectorAll('.tweet-share-btn').forEach(function(btn) {
      if (btn.getAttribute('data-bound')) return;
      btn.setAttribute('data-bound', 'true');

      var tweetId = btn.getAttribute('data-id');
      var shareIcon = btn.querySelector('.share-icon');
      var checkIcon = btn.querySelector('.check-icon');
      var tooltip = btn.querySelector('.copied-tooltip');

      btn.addEventListener('click', async function(e) {
        e.preventDefault();
        var url = window.location.origin + '/tweets' + (tweetId ? '#' + tweetId : '');
        try {
          await navigator.clipboard.writeText(url);
          if (shareIcon) shareIcon.classList.add('hidden');
          if (checkIcon) checkIcon.classList.remove('hidden');
          if (tooltip) tooltip.classList.remove('opacity-0');

          setTimeout(function() {
            if (shareIcon) shareIcon.classList.remove('hidden');
            if (checkIcon) checkIcon.classList.add('hidden');
            if (tooltip) tooltip.classList.add('opacity-0');
          }, 1500);
        } catch (err) {
          console.error(err);
        }
      });
    });
  }

  // 실시간 트윗 동기화 (새로 등록된 파일 실시간 확인)
  (async function() {
    initTweetInteractions();

    try {
      var pat = localStorage.getItem('github_pat');
      var headers = { 'Accept': 'application/vnd.github.v3+json' };
      if (pat) headers['Authorization'] = 'Bearer ' + pat;

      var res = await fetch('https://api.github.com/repos/Nekonic/Nekonic.github.io/contents/src/content/tweets', { headers: headers });
      if (!res.ok) return;

      var files = await res.json();
      if (!Array.isArray(files) || !files.length) return;

      var container = document.getElementById('tweetsContainer');
      var emptyEl = document.getElementById('emptyTweets');
      if (emptyEl && files.length > 0) emptyEl.classList.add('hidden');

      var renderedCount = container ? container.children.length : 0;
      if (files.length > renderedCount) {
        window.location.reload();
      }
    } catch (e) {
      console.error(e);
    }
  })();
</script>
