---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TweetCard from '../../components/TweetCard.astro';
import { getCollection } from 'astro:content';

let allTweets: any[] = [];
try {
  allTweets = await getCollection('tweets');
} catch {}

const sortedTweets = allTweets.sort((a, b) => {
  const dateA = a.data?.date ? new Date(a.data.date).valueOf() : 0;
  const dateB = b.data?.date ? new Date(b.data.date).valueOf() : 0;
  return dateB - dateA;
});
---

<BaseLayout title="Tweets" description="Short thoughts and updates">
  <div class="max-w-2xl mx-auto">
    <div class="mb-8 flex justify-between items-center pb-6 border-b border-border/70">
      <div>
        <h1 class="text-2xl lg:text-3xl font-bold text-white tracking-tight">Tweets</h1>
        <p class="text-xs font-mono text-text-muted mt-1">Short thoughts, quick updates, and micro-logs</p>
      </div>
      <a 
        href="/compose" 
        class="inline-flex items-center gap-1.5 px-3.5 py-1.5 bg-accent hover:bg-accent-hover text-white rounded-md text-xs font-semibold tracking-wide transition-colors shadow-xs"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
        작성하기
      </a>
    </div>
    
    <div id="tweetsContainer" class="flex flex-col gap-4">
      {sortedTweets.map(tweet => (
        <TweetCard 
          content={tweet.body}
          date={tweet.data?.date ? new Date(tweet.data.date) : undefined}
        />
      ))}
    </div>

    <div id="emptyTweets" class:list={["text-center py-16 bg-card border border-border rounded-xl p-8", sortedTweets.length > 0 && "hidden"]}>
      <div class="w-12 h-12 rounded-full bg-secondary border border-border flex items-center justify-center mx-auto mb-3 text-text-muted">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      </div>
      <p class="text-sm text-text-secondary font-medium mb-1">아직 작성된 트윗이 없습니다.</p>
      <p class="text-xs text-text-muted mb-4 font-mono">새로운 소식이나 짧은 메모를 남겨보세요.</p>
      <a 
        href="/compose" 
        class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-secondary border border-border hover:border-accent text-text-primary rounded-md text-xs font-medium transition-colors"
      >
        첫 트윗 작성하기 &rarr;
      </a>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  // 실시간 트윗 동기화 (GitHub API를 통해 방금 쓴 트윗 즉시 로딩)
  (async function() {
    try {
      var pat = localStorage.getItem('github_pat');
      var headers = { 'Accept': 'application/vnd.github.v3+json' };
      if (pat) headers['Authorization'] = 'Bearer ' + pat;

      var res = await fetch('https://api.github.com/repos/Nekonic/Nekonic.github.io/contents/src/content/tweets', { headers: headers });
      if (!res.ok) return;

      var files = await res.json();
      if (!Array.isArray(files) || !files.length) return;

      var container = document.getElementById('tweetsContainer');
      var emptyEl = document.getElementById('emptyTweets');
      if (emptyEl && files.length > 0) emptyEl.classList.add('hidden');

      // Sort newest first
      files.sort(function(a, b) { return b.name.localeCompare(a.name); });

      // If client sees more files than statically rendered, re-render dynamically
      var renderedCount = container ? container.children.length : 0;
      if (files.length > renderedCount) {
        container.innerHTML = '';
        for (var i = 0; i < files.length; i++) {
          var f = files[i];
          if (!f.name.endsWith('.md')) continue;

          var fHeaders = { 'Accept': 'application/vnd.github.raw' };
          if (pat) fHeaders['Authorization'] = 'Bearer ' + pat;

          var rawRes = await fetch(f.url, { headers: fHeaders });
          if (!rawRes.ok) continue;
          var text = await rawRes.text();

          var body = text;
          var dateStr = '';
          var fm = text.match(/^---\n([\s\S]*?)\n---\n([\s\S]*)$/);
          if (fm) {
            body = fm[2].trim();
            var dMatch = fm[1].match(/date:\s*["']?(.*?)["']?$/m);
            if (dMatch) {
              var d = new Date(dMatch[1]);
              dateStr = d.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' });
            }
          }

          var card = document.createElement('article');
          card.className = 'bg-card border border-border rounded-lg p-5 hover:border-accent transition-colors duration-200';
          card.innerHTML = '<div class="flex items-start gap-4"><img src="https://github.com/Nekonic.png" alt="Nekonic Avatar" class="w-10 h-10 rounded-full border border-border flex-shrink-0 mt-1" /><div class="flex-1 min-w-0"><div class="flex items-center justify-between mb-1"><span class="font-semibold text-text-primary">Nekonic</span></div><div class="text-text-primary whitespace-pre-wrap text-sm leading-relaxed mb-3">' + body + '</div>' + (dateStr ? '<time class="text-xs text-text-secondary">' + dateStr + '</time>' : '') + '</div></div>';
          container.appendChild(card);
        }
      }
    } catch (e) {
      console.error(e);
    }
  })();
</script>
