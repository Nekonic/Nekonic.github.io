    var titleChanged = parsed.title !== postTitle.value;
    postTitle.value = parsed.title;
    postCategories.value = parsed.categories;
    postTags.value = parsed.tags;
    postDate = /^\d{4}-\d{2}-\d{2}$/.test(parsed.date) ? parsed.date : TODAY;
    if (titleChanged) postTitle.dispatchEvent(new Event('input')); // 새 글이면 파일명 자동 생성
    return parsed.body.replace(/^\s*\n/, '');
  }

  var runConfigLabel = document.getElementById('runConfigLabel');
  function updateRunLabel() {
    var opt = postSelector.options[postSelector.selectedIndex];
    runConfigLabel.textContent = opt ? opt.textContent : (postSlug.value.trim().replace(/\.md$/, '') || '새 글');
  }
  postSelector.addEventListener('change', updateRunLabel);

  // 탭 이름 = 파일명
  var editorTabName = document.getElementById('editorTabName');
  function updateTabName() {
    if (editorTabName) editorTabName.textContent = postSlug.value.trim() || 'new-post.md';
  }
  postSlug.addEventListener('input', updateTabName);

  // ---- Diff 모드: 불러온 원본(저장본)과 지금 에디터 내용을 비교 ----
  var diffBase = '';
  var diffMode = 'unified';
  try { diffMode = localStorage.getItem('write_diff_mode') || 'unified'; } catch (e) {}
  var diffHunks = [], diffIdx = -1;
  var diffBody = document.getElementById('diffBody');

  // text를 주면 그 내용(저장 시점의 스냅샷)을 기준으로 삼음
  function setDiffBase(label, text) {
    diffBase = text != null ? text : postContent.value;
    document.getElementById('diffBaseLabel').textContent = '기준: ' + label;
    if (!diffCol.classList.contains('hidden')) renderDiff();
  }

  // LCS 기반 diff → [{op:'eq'|'del'|'add', a, b}]
  function diffSeq(a, b, eq) {
    // 공통 앞/뒤는 LCS 표에서 빼서 O(n·m) 비용을 바뀐 구간으로 한정
    var pre = 0, suf = 0;
    while (pre < a.length && pre < b.length && eq(a[pre], b[pre])) pre++;
    while (suf < a.length - pre && suf < b.length - pre && eq(a[a.length - 1 - suf], b[b.length - 1 - suf])) suf++;
    var head = [], tail = [], k;
    for (k = 0; k < pre; k++) head.push({ op: 'eq', a: k, b: k });
    for (k = suf; k > 0; k--) tail.push({ op: 'eq', a: a.length - k, b: b.length - k });
    var mid = diffCore(a.slice(pre, a.length - suf), b.slice(pre, b.length - suf), eq);
    mid.forEach(function(d) { if (d.a != null) d.a += pre; if (d.b != null) d.b += pre; });
    return head.concat(mid, tail);
  }
  function diffCore(a, b, eq) {
    var n = a.length, m = b.length, i, j;
    var dp = new Array(n + 1);
    for (i = 0; i <= n; i++) dp[i] = new Uint32Array(m + 1);
    for (i = n - 1; i >= 0; i--)
      for (j = m - 1; j >= 0; j--)
        dp[i][j] = eq(a[i], b[j]) ? dp[i + 1][j + 1] + 1 : Math.max(dp[i + 1][j], dp[i][j + 1]);
    var out = [];
    i = 0; j = 0;
    while (i < n && j < m) {
      if (eq(a[i], b[j])) { out.push({ op: 'eq', a: i++, b: j++ }); }
      else if (dp[i + 1][j] >= dp[i][j + 1]) out.push({ op: 'del', a: i++ });
      else out.push({ op: 'add', b: j++ });
    }
    while (i < n) out.push({ op: 'del', a: i++ });
    while (j < m) out.push({ op: 'add', b: j++ });
    return out;
  }
  function same(x, y) { return x === y; }

  function esc(t) {
    return t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  // 바뀐 줄 안에서 단어 단위로 강조
  function wordDiff(oldLine, newLine) {
    var ta = oldLine.split(/(\s+|[^\s\w가-힣])/).filter(Boolean);
    var tb = newLine.split(/(\s+|[^\s\w가-힣])/).filter(Boolean);
    var ops = diffSeq(ta, tb, same), o = '', n = '';
    ops.forEach(function(d) {
      if (d.op === 'eq') { o += esc(ta[d.a]); n += esc(tb[d.b]); }
      else if (d.op === 'del') o += '<del>' + esc(ta[d.a]) + '</del>';
      else n += '<ins>' + esc(tb[d.b]) + '</ins>';
    });
    return { o: o, n: n };
  }

  // 연속된 삭제/추가 묶음을 짝지어 줄 단위 행으로 변환
  function diffRows(a, b) {
    var ops = diffSeq(a, b, same), rows = [], k = 0;
    while (k < ops.length) {
      if (ops[k].op === 'eq') { rows.push({ t: 'eq', a: ops[k].a, b: ops[k].b }); k++; continue; }
      var dels = [], adds = [];
      while (k < ops.length && ops[k].op !== 'eq') { (ops[k].op === 'del' ? dels : adds).push(ops[k]); k++; }
      var pairs = Math.max(dels.length, adds.length);
      for (var p = 0; p < pairs; p++) {
        var d = dels[p], ad = adds[p];
        var wd = d && ad ? wordDiff(a[d.a], b[ad.b]) : null;
        rows.push({ t: 'chg', a: d ? d.a : null, b: ad ? ad.b : null,
          oh: d ? (wd ? wd.o : esc(a[d.a])) : null, nh: ad ? (wd ? wd.n : esc(b[ad.b])) : null });
      }
    }
    return rows;
  }

  function renderDiff() {
    renderDiffBody();
    collectHunks();
  }

  // 바뀐 덩어리(연속된 변경 줄) 시작점 모으기 → 이전/다음 이동
  function collectHunks() {
    var isChg = function(el) { return !!el && (el.matches('.diff-add, .diff-del') || !!el.querySelector('.diff-add, .diff-del')); };
    diffHunks = [];
    if (diffMode === 'rendered') {
      diffHunks = Array.prototype.slice.call(diffBody.querySelectorAll('.rdiff-add, .rdiff-del, .rdiff-li'));
    } else {
      Array.prototype.forEach.call(diffBody.querySelectorAll('tr'), function(tr) {
        if (isChg(tr) && !isChg(tr.previousElementSibling)) diffHunks.push(tr);
      });
    }
    diffIdx = -1;
    updateDiffNav();
  }

  function updateDiffNav() {
    document.getElementById('diffPrev').disabled = diffIdx <= 0;
    document.getElementById('diffNext').disabled = diffIdx >= diffHunks.length - 1;
    document.getElementById('diffPos').textContent = diffHunks.length ? (diffIdx < 0 ? '–' : diffIdx + 1) + '/' + diffHunks.length : '';
  }

  function gotoHunk(i) {
    if (!diffHunks.length) return;
    diffIdx = Math.max(0, Math.min(diffHunks.length - 1, i));
    diffBody.querySelectorAll('.diff-cur, .rdiff-cur').forEach(function(el) { el.classList.remove('diff-cur', 'rdiff-cur'); });
    var el = diffHunks[diffIdx];
    el.classList.add(diffMode === 'rendered' ? 'rdiff-cur' : 'diff-cur');
    diffBody.scrollTop += el.getBoundingClientRect().top - diffBody.getBoundingClientRect().top - diffBody.clientHeight / 3;
    updateDiffNav();
  }
  document.getElementById('diffPrev').addEventListener('click', function() { gotoHunk(diffIdx - 1); });
  document.getElementById('diffNext').addEventListener('click', function() { gotoHunk(diffIdx + 1); });
  document.addEventListener('keydown', function(e) {
    if (e.key !== 'F7' || diffCol.classList.contains('hidden')) return;
    e.preventDefault();
    gotoHunk(diffIdx + (e.shiftKey ? -1 : 1));
  });

  function renderDiffBody() {
    if (diffMode === 'split' && window.innerWidth < 768) diffMode = 'unified'; // 좁은 화면은 한 줄 보기
    var a = diffBase.split('\n'), b = postContent.value.split('\n');
    var rows = diffRows(a, b), plus = 0, minus = 0;
    rows.forEach(function(r) { if (r.t === 'chg') { if (r.a !== null) minus++; if (r.b !== null) plus++; } });
    document.getElementById('diffStat').innerHTML = '<span style="color:#6aab73">+' + plus + '</span> <span style="color:#db5c5c">−' + minus + '</span>';
    document.querySelectorAll('.diff-mode').forEach(function(btn) { btn.setAttribute('aria-pressed', String(btn.dataset.diffMode === diffMode)); });
    if (!plus && !minus) { diffBody.innerHTML = '<div class="text-text-muted text-center py-20 font-mono text-xs">저장된 글과 달라진 곳이 없어요.</div>'; return; }
    if (diffMode === 'rendered') { renderRenderedDiff(a, b, rows); return; }
    // 바뀐 곳 주변 3줄만 남기고 접기
    var keep = rows.map(function() { return false; });
    rows.forEach(function(r, i) { if (r.t === 'chg') for (var x = Math.max(0, i - 3); x <= Math.min(rows.length - 1, i + 3); x++) keep[x] = true; });
    var html = '<table class="diff-table font-mono' + (diffMode === 'split' ? ' diff-split' : '') + '">'
      + (diffMode === 'split'
        ? '<colgroup><col style="width:3.25rem"><col style="width:1.25rem"><col><col style="width:1px"><col style="width:3.25rem"><col style="width:1.25rem"><col></colgroup>'
        : '<colgroup><col style="width:3.25rem"><col style="width:3.25rem"><col style="width:1.25rem"><col></colgroup>');
    var skipping = false;
    rows.forEach(function(r, i) {
      if (!keep[i]) {
        if (!skipping) html += '<tr class="diff-hunk"><td colspan="' + (diffMode === 'split' ? 7 : 4) + '">⋯ 바뀌지 않은 줄 접힘</td></tr>';
        skipping = true; return;
      }
      skipping = false;
      if (diffMode === 'unified') {
        if (r.t === 'eq') html += '<tr><td class="dn">' + (r.a + 1) + '</td><td class="dn">' + (r.b + 1) + '</td><td class="ds"></td><td class="dt">' + esc(a[r.a]) + '</td></tr>';
        else {
          if (r.a !== null) html += '<tr class="diff-del"><td class="dn">' + (r.a + 1) + '</td><td class="dn"></td><td class="ds">−</td><td class="dt">' + r.oh + '</td></tr>';
          if (r.b !== null) html += '<tr class="diff-add"><td class="dn"></td><td class="dn">' + (r.b + 1) + '</td><td class="ds">+</td><td class="dt">' + r.nh + '</td></tr>';
        }
      } else {
        var left = r.t === 'eq' ? ['', r.a + 1, '', esc(a[r.a])] : (r.a !== null ? ['diff-del', r.a + 1, '−', r.oh] : ['diff-empty', '', '', '']);
        var right = r.t === 'eq' ? ['', r.b + 1, '', esc(b[r.b])] : (r.b !== null ? ['diff-add', r.b + 1, '+', r.nh] : ['diff-empty', '', '', '']);
        html += '<tr>' + cell(left) + '<td class="mid"></td>' + cell(right) + '</tr>';
      }
    });
    diffBody.innerHTML = html + '</table>';
    function cell(c) {
      return '<td class="dn ' + c[0] + '">' + c[1] + '</td><td class="ds ' + c[0] + '">' + c[2] + '</td><td class="dt ' + c[0] + '">' + c[3] + '</td>';
    }
  }

  // 렌더링된 글 기준 diff: 현재 글을 그대로 렌더링하고, 바뀐 블록·목록 항목에 표시
  function renderRenderedDiff(a, b, rows) {
    var text = postContent.value;
    var rawBody = parseFrontmatter(text).body;
    var offset = text.length - rawBody.length; // 본문 시작 위치
    var bodyStart = text.slice(0, offset).split('\n').length - 1;
    // 미리보기와 같은 변환(대기 이미지 blob URL, 정렬 문법) — 줄바꿈 수는 그대로라 줄 번호 매핑이 유지됨
    var body = previewSrc(rawBody);
    var changed = {}, dels = {};
    var pendingDel = [];
    rows.forEach(function(r) {
      if (r.t === 'eq') { flush(r.b); return; }
      if (r.b !== null) { flush(r.b); changed[r.b] = r.a === null ? 'add' : 'mod'; }
      else if (a[r.a].trim()) pendingDel.push(a[r.a]);
    });
    flush(b.length);
    function flush(at) { if (pendingDel.length) { dels[at] = (dels[at] || []).concat(pendingDel); pendingDel = []; } }

    if (!window.marked) { diffBody.innerHTML = '<p class="p-6 text-text-muted">marked를 불러오지 못했어요.</p>'; return; }
    var tokens = marked.lexer(body), pos = 0, covered = bodyStart, html = '';
    // 토큰 raw가 본문 어디에 있는지 찾아 줄 번호로 변환
    var nls = [];
    for (var q = body.indexOf('\n'); q >= 0; q = body.indexOf('\n', q + 1)) nls.push(q);
    var lineAt = function(i) { // i 앞의 줄바꿈 개수 (이진 탐색)
      var lo = 0, hi = nls.length;
      while (lo < hi) { var md = (lo + hi) >> 1; if (nls[md] < i) lo = md + 1; else hi = md; }
      return bodyStart + lo;
    };
    // raw가 차지하는 줄의 끝(뒤따르는 빈 줄 포함) — 토큰 사이에 빠지는 줄이 없도록
    var lineEnd = function(at, raw) { return lineAt(at + raw.length) + (/\n$/.test(raw) ? 0 : 1); };
    var delHtml = function(from, to) {
      var out = [];
      for (var i = from; i < to; i++) if (dels[i]) out = out.concat(dels[i]);
      return out.length ? '<div class="rdiff-del">' + out.map(function(l) { return '<div>' + esc(l) + '</div>'; }).join('') + '</div>' : '';
    };
    var hasChange = function(from, to) {
      for (var i = from; i < to; i++) if (changed[i]) return true;
      return false;
    };
    // frontmatter(제목·태그 등)의 변경도 표시
    html += delHtml(0, bodyStart);
    var fmAdded = [];
    for (var f = 0; f < bodyStart; f++) if (changed[f]) fmAdded.push(b[f]);
    if (fmAdded.length) html += '<div class="rdiff-add"><pre>' + esc(fmAdded.join('\n')) + '</pre></div>';
    tokens.forEach(function(tok) {
      var at = body.indexOf(tok.raw, pos);
      if (at < 0) at = pos;
      pos = at + tok.raw.length;
      var from = lineAt(at), to = lineEnd(at, tok.raw);
      html += delHtml(Math.max(from, covered), to);
      covered = Math.max(covered, to);
      if (tok.type === 'space') return;
      var one = [tok]; one.links = tokens.links;
      var part = marked.parser(one);
      if (tok.type === 'list') {
        // 목록은 바뀐 항목만 표시
        var box = document.createElement('div');
        box.innerHTML = part;
        var lis = box.querySelectorAll(':scope > ul > li, :scope > ol > li');
        var ip = at;
        tok.items.forEach(function(it, idx) {
          var ia = body.indexOf(it.raw, ip);
          if (ia < 0) ia = ip;
          ip = ia + it.raw.length;
          var l2 = lineAt(ia);
          if (lis[idx] && hasChange(l2, lineEnd(ia, it.raw))) lis[idx].classList.add('rdiff-li');
        });
        html += box.innerHTML;
      } else if (hasChange(from, to)) {
        html += '<div class="rdiff-add">' + part + '</div>';
      } else {
        html += part;
      }
    });
    html += delHtml(covered, b.length + 1);
    diffBody.innerHTML = '<div class="px-6 lg:px-10 py-6 article-content max-w-3xl">' + html + '</div>';
    highlightCode(diffBody);
    resolvePreviewImages(diffBody);
  }

  document.querySelectorAll('.diff-mode').forEach(function(btn) {
    btn.addEventListener('click', function() {
      diffMode = btn.dataset.diffMode;
      try { localStorage.setItem('write_diff_mode', diffMode); } catch (e) {}
      renderDiff();
    });
  });

  // View switchers
  var viewDiffBtn = document.getElementById('viewDiffBtn');
  var diffCol = document.getElementById('diffCol');
  function showPanes(editor, preview, diff) {
    editorCol.classList.toggle('hidden', !editor);
    previewCol.classList.toggle('hidden', !preview);
    diffCol.classList.toggle('hidden', !diff);
    diffCol.classList.toggle('flex', diff);
  }
  viewSplitBtn.addEventListener('click', function() { showPanes(true, true, false); setActiveViewBtn(viewSplitBtn); });
  viewEditBtn.addEventListener('click', function() { showPanes(true, false, false); setActiveViewBtn(viewEditBtn); });
  viewPreviewBtn.addEventListener('click', function() { showPanes(false, true, false); setActiveViewBtn(viewPreviewBtn); });
  viewDiffBtn.addEventListener('click', function() { showPanes(false, false, true); setActiveViewBtn(viewDiffBtn); renderDiff(); });

  function setActiveViewBtn(active) {
    [viewSplitBtn, viewEditBtn, viewPreviewBtn, viewDiffBtn].forEach(function(btn) {
      btn.classList.remove('bg-accent/25', 'text-accent-soft');
      btn.classList.add('text-text-secondary');
    });
    active.classList.remove('text-text-secondary');
    active.classList.add('bg-accent/25', 'text-accent-soft');
    updateGutter();
  }

  // Auto-generate slug when typing title for new posts
  postTitle.addEventListener('input', function() {
    if (postSelector.value === '__NEW__') {
      var cleanTitle = postTitle.value.trim().toLowerCase().replace(/[^a-z0-9가-힣]+/g, '-');
      postSlug.value = TODAY + (cleanTitle ? '-' + cleanTitle : '') + '.md';
      updateTabName();
    }
  });

  // Post Selector change handler
  postSelector.addEventListener('change', async function() {
    var val = postSelector.value;
    postSecret.disabled = false;
    if (val.indexOf('secret:') === 0) {
      await loadSecretPost(val.slice('secret:'.length));
      return;
    }
    if (val === '__NEW__') {
      currentEditingSha = null;
      postSecret.checked = false;
      updateSaveLocation();
      postTitle.value = '';
      postCategories.value = '';
      postTags.value = '';
      postSlug.value = '';
      setEditor('');
      setDiffBase('새 글');
      publishBtnText.textContent = '발행하기';
      updatePreview();
      return;
    }

    var selected = posts.find(function(p) { return p.id === val; });
    if (selected) {
      // 공개 글을 수정할 때는 비밀글로 바꿀 수 없음 (공개 파일이 그대로 남기 때문)
      currentEditingSha = null;
      postSecret.checked = false;
      postSecret.disabled = true;
      updateSaveLocation();
      postTitle.value = selected.title || '';
      postCategories.value = Array.isArray(selected.categories) ? selected.categories.join(', ') : (selected.categories || '');
      postTags.value = Array.isArray(selected.tags) ? selected.tags.join(', ') : (selected.tags || '');
      postSlug.value = selected.id + '.md';
      setEditor(selected.body || '', selected.date || selected.id); // 날짜가 없으면 파일명 앞 날짜
      setDiffBase(selected.id + '.md');
      publishBtnText.textContent = '수정 저장하기';
      updatePreview();

      // Fetch file SHA from GitHub API so we can update it
      fetchFileSha(selected.id + '.md');
    }
  });

  async function fetchFileSha(filename) {
    var pat = localStorage.getItem('github_pat');
    if (!pat) return;

    try {
      var res = await fetch('https://api.github.com/repos/Nekonic/Nekonic.github.io/contents/src/content/blog/' + filename, {
        headers: { 'Authorization': 'Bearer ' + pat, 'Accept': 'application/vnd.github.v3+json' }
      });
      if (res.ok) {
        var data = await res.json();
        currentEditingSha = data.sha;
      }
    } catch(e) {}
  }

  function showAlert(msg, isError) {
    // JetBrains 알림 풍선 (오른쪽 아래)
    statusAlert.className = 'fixed right-4 bottom-20 lg:bottom-10 z-50 max-w-sm flex items-start gap-2.5 px-4 py-3 rounded-lg bg-secondary border border-border shadow-2xl text-xs leading-relaxed text-text-primary';
    statusAlert.innerHTML = '';
    var dot = document.createElement('span');
    dot.className = 'mt-1 w-2 h-2 shrink-0 rounded-full ' + (isError ? 'bg-[#db5c5c]' : 'bg-accent-green');
    var text = document.createElement('span');
    text.textContent = msg;
    statusAlert.appendChild(dot);
    statusAlert.appendChild(text);
    clearTimeout(showAlert.timer);
    showAlert.timer = setTimeout(function() { statusAlert.classList.add('hidden'); }, 8000);
  }

  // Publish / Save Button
  publishBtn.addEventListener('click', async function() {
    var pat = localStorage.getItem('github_pat');
    if (!pat) {
      showAlert('GitHub 토큰이 필요합니다. 트윗 작성 페이지에서 먼저 토큰을 등록해주세요.', true);
      return;
    }

    var content = syncFrontmatter().trim();
    var savedText = postContent.value; // 저장되는 시점의 에디터 내용 (저장 중 추가로 고친 부분은 diff에 남도록)
    var title = postTitle.value.trim();
    var slug = postSlug.value.trim();
    var categories = postCategories.value.trim();
    var tags = postTags.value.trim();

    if (!title) { showAlert('제목을 입력해주세요.', true); return; }
    if (!slug) { showAlert('파일명을 입력해주세요.', true); return; }
    if (!slug.endsWith('.md')) { slug += '.md'; postSlug.value = slug; }
    if (!content) { showAlert('본문 내용을 입력해주세요.', true); return; }

    publishBtn.disabled = true;
    publishBtnText.textContent = '저장 중...';

    // Construct Frontmatter (date는 에디터 frontmatter 값)
    var frontmatter = '---\n';
    frontmatter += 'title: "' + title.replace(/"/g, '\\"') + '"\n';
    frontmatter += 'date: ' + postDate + '\n';
    if (categories) {
      frontmatter += 'categories: [' + categories.split(',').map(function(s){ return '"' + s.trim() + '"'; }).join(', ') + ']\n';
    }
    if (tags) {
      frontmatter += 'tags: [' + tags.split(',').map(function(s){ return '"' + s.trim() + '"'; }).join(', ') + ']\n';
    }
    frontmatter += '---\n\n';

    var fullFileContent = frontmatter + content;

    if (postSecret.checked) {
      try {
        // 이미지: 비공개 저장소 _posts/images/<폴더>/ 에 저장하고 본문 경로를 /_private/ 로 바꿈
        var secretImages = Object.keys(pendingImages).filter(function(p) { return fullFileContent.indexOf(p) !== -1; });
        for (var i = 0; i < secretImages.length; i++) {
          var publicPath = secretImages[i];
          var rel = 'images/' + publicPath.replace(/^\/assets\/images\/posts\//, '');
          var img = pendingImages[publicPath];
          await putPrivateFile(pat, PRIVATE_DIR + '/' + rel, await fileToBase64(img.file), 'secret image: ' + title);
          var privatePath = '/_private/' + rel;
          fullFileContent = fullFileContent.split(publicPath).join(privatePath);
          postContent.value = postContent.value.split(publicPath).join(privatePath);
          savedText = savedText.split(publicPath).join(privatePath);
          privateImageCache[privatePath] = img.blobUrl;
          delete pendingImages[publicPath];
        }

        var saved = await putPrivateFile(
          pat,
          PRIVATE_DIR + '/' + slug,
          btoa(unescape(encodeURIComponent(fullFileContent))),
          (currentEditingSha ? 'edit secret post: ' : 'secret post: ') + title,
          currentEditingSha
        );
        currentEditingSha = saved.content ? saved.content.sha : null;
        postSecret.disabled = true;
        showAlert('비밀글이 비공개 저장소에 저장되었습니다. Blog 목록의 private 그룹에서 볼 수 있어요.', false);
        setDiffBase(slug + ' (저장됨)', savedText);
        publishBtnText.textContent = '저장 완료!';
        setTimeout(function() { publishBtnText.textContent = '수정 저장하기'; }, 3000);
      } catch (e) {
        showAlert('비밀글 저장 실패: ' + e.message, true);
        publishBtnText.textContent = '저장 실패';
      } finally {
        publishBtn.disabled = false;
      }
      return;
    }

    // 본문에서 실제로 참조 중인 이미지만 함께 커밋
    var usedImages = Object.keys(pendingImages).filter(function(p) { return fullFileContent.indexOf(p) !== -1; });
    if (usedImages.length > 0) {
      try {
        await publishWithImages(pat, slug, fullFileContent, title, usedImages);
        usedImages.forEach(function(p) { URL.revokeObjectURL(pendingImages[p].blobUrl); delete pendingImages[p]; });
        currentEditingSha = null;
        fetchFileSha(slug);
        showAlert('글과 이미지가 한 커밋으로 저장되었습니다! GitHub Actions 배포 후 반영됩니다.', false);
        setDiffBase(slug + ' (저장됨)', savedText);
        publishBtnText.textContent = '발행 완료!';
        setTimeout(function() { publishBtnText.textContent = '수정 저장하기'; }, 3000);
      } catch(e) {
        showAlert('저장 실패: ' + e.message, true);
        publishBtnText.textContent = '저장 실패';
      } finally {
        publishBtn.disabled = false;
      }
      return;
    }

    var reqBody = {
      message: (currentEditingSha ? 'edit post: ' : 'post: ') + title,
      content: btoa(unescape(encodeURIComponent(fullFileContent)))
    };
    if (currentEditingSha) {
      reqBody.sha = currentEditingSha;
    }

    try {
      var res = await fetch('https://api.github.com/repos/Nekonic/Nekonic.github.io/contents/src/content/blog/' + slug, {
        method: 'PUT',
        headers: {
          'Authorization': 'Bearer ' + pat,
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(reqBody)
      });

      if (res.ok) {
        var data = await res.json();
        currentEditingSha = data.content ? data.content.sha : null;
        showAlert('성공적으로 저장되었습니다! GitHub Actions 배포 후 사이트에 자동 반영됩니다.', false);
        setDiffBase(slug + ' (저장됨)', savedText);
        publishBtnText.textContent = '발행 완료!';
        setTimeout(function() { publishBtnText.textContent = currentEditingSha ? '수정 저장하기' : '발행하기'; }, 3000);
      } else {
        var err = await res.json();
        showAlert('저장 실패: ' + err.message, true);
        publishBtnText.textContent = '저장 실패';
      }
    } catch(e) {
      showAlert('통신 오류가 발생했습니다.', true);
      publishBtnText.textContent = '오류 발생';
    } finally {
      publishBtn.disabled = false;
    }
  });

  // Init
  postSlug.value = TODAY + '-new-post.md';
  setEditor('');
  setDiffBase('새 글');
  postContent.classList.add('hl-on');
  (window.innerWidth < 1024 ? viewEditBtn : viewSplitBtn).click();
  updatePreview();

  loadSecretList().then(function() {
    var secretId = new URLSearchParams(location.search).get('secret');
    if (secretId) {
      postSelector.value = 'secret:' + secretId;
      loadSecretPost(secretId);
    }
  });
</script>
