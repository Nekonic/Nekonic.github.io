<!-- Embedded existing posts data -->
<script is:inline id="postsData" type="application/json" set:html={JSON.stringify(postList)}></script>

<script is:inline>
  var posts = [];
  try {
    posts = JSON.parse(document.getElementById('postsData').textContent);
  } catch(e) {}

  var postSelector = document.getElementById('postSelector');
  var postTitle = document.getElementById('postTitle');
  var postCategories = document.getElementById('postCategories');
  var postTags = document.getElementById('postTags');
  var postSlug = document.getElementById('postSlug');
  var postContent = document.getElementById('postContent');
  var previewContent = document.getElementById('previewContent');
  var publishBtn = document.getElementById('publishBtn');
  var publishBtnText = document.getElementById('publishBtnText');
  var statusAlert = document.getElementById('statusAlert');
  var charCount = document.getElementById('charCount');

  var viewSplitBtn = document.getElementById('viewSplitBtn');
  var viewEditBtn = document.getElementById('viewEditBtn');
  var viewPreviewBtn = document.getElementById('viewPreviewBtn');
  var editorCol = document.getElementById('editorCol');
  var previewCol = document.getElementById('previewCol');
  var workspaceContainer = document.getElementById('workspaceContainer');

  var currentEditingSha = null;
  var postSecret = document.getElementById('postSecret');
  var saveLocation = document.getElementById('saveLocation');
  var secretGroup = document.getElementById('secretGroup');

  // ---- 비밀글 (비공개 저장소) ----
  var PRIVATE_API = 'https://api.github.com/repos/Nekonic/Nekonic.github.io.data/contents/';
  var PRIVATE_DIR = '_posts';
  var privateImageCache = {};

  function updateSaveLocation() {
    saveLocation.textContent = postSecret.checked
      ? 'Nekonic.github.io.data/_posts/'
      : 'src/content/blog/';
    saveLocation.className = postSecret.checked ? 'text-accent-soft whitespace-nowrap truncate min-w-0' : 'text-text-muted whitespace-nowrap truncate min-w-0';
    publishBtnText.textContent = currentEditingSha ? '수정 저장하기' : (postSecret.checked ? '비밀글 저장' : '발행하기');
  }
  postSecret.addEventListener('change', updateSaveLocation);

  function encodePath(path) {
    return path.split('/').map(encodeURIComponent).join('/');
  }

  function decodeBase64Utf8(b64) {
    var bin = atob(b64.replace(/\n/g, ''));
    var bytes = new Uint8Array(bin.length);
    for (var i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
    return new TextDecoder().decode(bytes);
  }

  function parseFrontmatter(text) {
    var m = text.match(/^---\r?\n([\s\S]*?)\r?\n---[ \t]*(?:\r?\n|$)/);
    var fm = m ? m[1] : '';
    var field = function(k) {
      var r = fm.match(new RegExp('^' + k + '[ \\t]*:[ \\t]*(.*)$', 'm'));
      return r ? r[1].trim() : '';
    };
    var list = function(v) {
      v = v.replace(/^\[/, '').replace(/\]$/, '');
      return v.split(',').map(function(x) { return x.trim().replace(/^["']|["']$/g, ''); }).filter(Boolean).join(', ');
    };
    return {
      title: field('title').replace(/^"(.*)"$/, '$1').replace(/^'(.*)'$/, '$1').replace(/\\"/g, '"'),
      date: field('date').replace(/^["']|["']$/g, ''),
      categories: list(field('categories')),
      tags: list(field('tags')),
      body: m ? text.slice(m[0].length) : text
    };
  }

  async function loadSecretList() {
    var pat = localStorage.getItem('github_pat');
    if (!pat) return;
    try {
      var res = await fetch(PRIVATE_API + PRIVATE_DIR, {
        headers: { 'Authorization': 'Bearer ' + pat, 'Accept': 'application/vnd.github+json' }
      });
      if (!res.ok) return;
      var files = await res.json();
      files.filter(function(f) { return f.type === 'file' && f.name.endsWith('.md'); })
        .sort(function(a, b) { return b.name.localeCompare(a.name); })
        .forEach(function(f) {
          var opt = document.createElement('option');
          opt.value = 'secret:' + f.name.replace(/\.md$/, '');
          opt.textContent = f.name.replace(/\.md$/, '');
          secretGroup.appendChild(opt);
        });
      if (secretGroup.children.length) secretGroup.hidden = false;
    } catch (e) {}
  }

  async function loadSecretPost(id) {
    var pat = localStorage.getItem('github_pat');
    if (!pat) { showAlert('비밀글을 불러오려면 GitHub 토큰이 필요합니다.', true); return; }
    try {
      var res = await fetch(PRIVATE_API + encodePath(PRIVATE_DIR + '/' + id + '.md'), {
        headers: { 'Authorization': 'Bearer ' + pat, 'Accept': 'application/vnd.github+json' }
      });
      if (!res.ok) throw new Error('HTTP ' + res.status);
      var data = await res.json();
      var parsed = parseFrontmatter(decodeBase64Utf8(data.content));
      currentEditingSha = data.sha;
      postSecret.checked = true;
      postSecret.disabled = true;
      postTitle.value = parsed.title;
      postCategories.value = parsed.categories;
      postTags.value = parsed.tags;
      postSlug.value = id + '.md';
      setEditor(parsed.body.trim(), parsed.date);
      setDiffBase('비밀글 ' + id + '.md');
      updateSaveLocation();
      updatePreview();
    } catch (e) {
      showAlert('비밀글을 불러오지 못했습니다: ' + e.message, true);
    }
  }

  // 미리보기에서 /_private/... 이미지를 토큰으로 불러와 표시
  function resolvePreviewImages(root) {
    var pat = localStorage.getItem('github_pat');
    if (!pat) return;
    root.querySelectorAll('img[src^="/_private/"]').forEach(function(img) {
      var src = img.getAttribute('src');
      if (privateImageCache[src]) { img.src = privateImageCache[src]; return; }
      fetch(PRIVATE_API + encodePath(PRIVATE_DIR + '/' + src.slice('/_private/'.length)), {
        headers: { 'Authorization': 'Bearer ' + pat, 'Accept': 'application/vnd.github.raw' }
      }).then(function(r) { return r.ok ? r.blob() : null; }).then(function(b) {
        if (!b) return;
        privateImageCache[src] = URL.createObjectURL(b);
        img.src = privateImageCache[src];
      });
    });
  }

  async function putPrivateFile(pat, path, base64Content, message, sha) {
    var body = { message: message, content: base64Content };
    if (sha) body.sha = sha;
    var res = await fetch(PRIVATE_API + encodePath(path), {
      method: 'PUT',
      headers: { 'Authorization': 'Bearer ' + pat, 'Content-Type': 'application/json' },
      body: JSON.stringify(body)
    });
    var data = await res.json();
    if (!res.ok) throw new Error(data.message || ('HTTP ' + res.status));
    return data;
  }

  // ---- Image upload (원본 파일 그대로 public/assets/images/posts/<slug>/ 에 저장) ----
  var REPO_API = 'https://api.github.com/repos/Nekonic/Nekonic.github.io';
  var pendingImages = {}; // publicPath -> { file, blobUrl, repoPath, origFile, edit }

  function sanitizeName(name) {
    var dot = name.lastIndexOf('.');
    var base = dot > 0 ? name.slice(0, dot) : name;
    var ext = dot > 0 ? name.slice(dot + 1).toLowerCase() : 'png';
    base = base.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '') || 'image';
    return base + '-' + Date.now().toString(36) + '.' + ext;
  }

  function insertImageFiles(files) {
    var folder = (postSlug.value.trim().replace(/\.md$/, '')) || 'untitled';
    var inserts = [], paths = [];
    Array.prototype.forEach.call(files, function(file) {
      if (!file.type.startsWith('image/')) return;
      var fileName = sanitizeName(file.name || 'image.png');
      var publicPath = '/assets/images/posts/' + folder + '/' + fileName;
      pendingImages[publicPath] = {
        file: file,
        blobUrl: URL.createObjectURL(file),
        repoPath: 'public' + publicPath,
        origFile: file, // 다시 편집할 때 쓰는 원본 (업로드되지 않음)
        edit: null      // 다시 편집할 때 복원할 도형들
      };
      paths.push(publicPath);
      inserts.push('![](' + publicPath + ')');
    });
    if (!inserts.length) return paths;
    var start = postContent.selectionStart, end = postContent.selectionEnd;
    var text = inserts.join('\n\n') + '\n';
    postContent.value = postContent.value.slice(0, start) + text + postContent.value.slice(end);
    postContent.selectionStart = postContent.selectionEnd = start + text.length;
    postContent.focus();
    updatePreview();
    return paths;
  }

  // ---- Image editor: 넣기 전에 가리기/모자이크/박스/화살표/텍스트/자르기 편집 ----
  var imgEd = document.getElementById('imgEditor');
  var imgEdCanvas = document.getElementById('imgEdCanvas');
  var imgEdCtx = imgEdCanvas.getContext('2d');
  var imgEdTextInput = document.getElementById('imgEdTextInput');
  var imgEdUndo = document.getElementById('imgEdUndo');
  var imgEdRedo = document.getElementById('imgEdRedo');
  var imgEdClear = document.getElementById('imgEdClear');
  var imgEdDelete = document.getElementById('imgEdDelete');
  var imgEdCropClear = document.getElementById('imgEdCropClear');
  var imgEdSizeWrap = document.getElementById('imgEdSizeWrap');
  var imgEdColorInput = document.getElementById('imgEdColorInput');
  var imgEdQueue = [];       // 편집을 기다리는 { file, target, state }
  var imgEdFile = null;      // 지금 편집 중인 파일
  var imgEdTarget = null;    // 다시 편집 중이면 그 이미지의 publicPath
  var imgEdImage = null;     // 원본 이미지 (HTMLImageElement)
  var imgEdShapes = [];      // { type, x, y, w, h, x1, y1, x2, y2, color, size, text }
  var imgEdCrop = null;      // 남길 영역 { x, y, w, h }
  var imgEdSel = -1;         // 선택한 도형 index
  var imgEdDraft = null;     // 드래그로 그리는 중인 도형
  var imgEdDrag = null;      // 진행 중인 드래그 (그리기/이동/크기 조절/자르기)
  var imgEdTextPos = null;   // 열린 텍스트 입력 { x, y, index, color, size }
  var imgEdHistory = [], imgEdFuture = []; // 되돌리기/다시 실행용 스냅샷
  var imgEdBusy = false;     // 이미지 로딩·내보내기 중 (적용/취소 중복 실행 방지)
  var imgEdColorBefore = null; // 색상 피커로 바꾸기 전 스냅샷 (되돌리기 한 번에 묶음)
  var imgEdTool = 'redact';
  var imgEdColors = { redact: '#000000', mosaic: '#000000', box: '#ff3b30', arrow: '#ff3b30', text: '#ff3b30' };
  var imgEdSizes = { box: 'm', arrow: 'm', text: 'm' };
  var IMG_ED_KEYS = { v: 'select', r: 'redact', m: 'mosaic', b: 'box', a: 'arrow', t: 'text', c: 'crop' };
  var IMG_ED_EMPTY = '{"s":[],"c":null}';

  function addImageFiles(files) {
    Array.prototype.forEach.call(files, function(f) { if (f.type.startsWith('image/')) imgEdQueue.push({ file: f }); });
    if (!imgEdFile) openNextImage();
  }

  // 이번 세션에 넣은 (아직 안 올라간) 이미지를 원본부터 다시 편집
  function reopenPendingImage(path) {
    var entry = pendingImages[path];
    if (!entry) return;
    imgEdQueue.push({ file: entry.origFile || entry.file, target: path, state: entry.edit });
    if (!imgEdFile) openNextImage();
  }

  function openNextImage() {
    var item = imgEdQueue.shift() || null;
    imgEdFile = item ? item.file : null;
    imgEdTarget = item ? item.target || null : null;
    imgEdBusy = !!imgEdFile;
    if (!imgEdFile) { imgEd.classList.add('hidden'); imgEd.classList.remove('flex'); postContent.focus(); return; }
    var url = URL.createObjectURL(imgEdFile);
    var img = new Image();
    img.onload = function() {
      imgEdImage = img;
      imgEdBusy = false;
      restoreSnapshot(item.state || IMG_ED_EMPTY);
      imgEdHistory = []; imgEdFuture = [];
      imgEdDraft = imgEdDrag = null;
      imgEdCanvas.width = img.naturalWidth;
      imgEdCanvas.height = img.naturalHeight;
      document.getElementById('imgEditorTitle').textContent = (imgEdTarget ? '다시 편집 · ' : '') + (imgEdFile.name || 'image.png');
      document.getElementById('imgEditorQueue').textContent = imgEdQueue.length ? '+' + imgEdQueue.length + '장 대기' : '';
      document.getElementById('imgEdOriginal').textContent = imgEdTarget ? '원본으로 되돌리기' : '원본 그대로 넣기';
      document.getElementById('imgEdApply').textContent = imgEdTarget ? '적용' : '적용해서 넣기';
      imgEd.classList.remove('hidden'); imgEd.classList.add('flex');
      postContent.blur(); // 편집 중 키 입력이 뒤의 에디터로 새지 않게
      fitCanvas();
      renderImgEd();
    };
    img.onerror = function() {
      URL.revokeObjectURL(url);
      if (!imgEdTarget) insertImageFiles([imgEdFile]);
      openNextImage();
    };
    img.src = url;
  }

  // 화면에 맞게 표시 크기 조정 (실제 해상도는 원본 그대로)
  function fitCanvas() {
    var stage = document.getElementById('imgEdStage');
    var maxW = stage.clientWidth - 32, maxH = stage.clientHeight - 32;
    var scale = Math.min(1, maxW / imgEdCanvas.width, maxH / imgEdCanvas.height);
    imgEdCanvas.style.width = Math.round(imgEdCanvas.width * scale) + 'px';
    imgEdCanvas.style.height = Math.round(imgEdCanvas.height * scale) + 'px';
  }
  window.addEventListener('resize', function() { if (imgEdFile) { fitCanvas(); if (imgEdImage) renderImgEd(); } });

  // 표시 px → 캔버스 px 비율 (핸들·선택 테두리를 화면 기준 크기로 그리기 위해)
  function displayScale() {
    var w = imgEdCanvas.getBoundingClientRect().width;
    return w ? w / imgEdCanvas.width : 1;
  }
  function imgMaxDim() { return Math.max(imgEdCanvas.width, imgEdCanvas.height); }
  function strokePx(size) {
    var base = Math.max(3, Math.round(imgMaxDim() / 300));
    return Math.max(2, Math.round(base * ({ s: 0.6, m: 1, l: 1.8 }[size || 'm'])));
  }
  function fontPx(size) {
    return Math.round(Math.max(16, imgMaxDim() / 40) * ({ s: 0.7, m: 1, l: 1.45 }[size || 'm']));
  }
  function textFont(size) { return 'bold ' + fontPx(size) + 'px "Pretendard Variable", Pretendard, sans-serif'; }

  function normRect(r) {
    return { x: Math.min(r.x, r.x + r.w), y: Math.min(r.y, r.y + r.h), w: Math.abs(r.w), h: Math.abs(r.h) };
  }
  // 이미지 밖으로 나간 부분을 잘라낸 정수 사각형
  function clampRect(r) {
    var x = Math.max(0, Math.round(r.x)), y = Math.max(0, Math.round(r.y));
    return {
      x: x, y: y,
      w: Math.max(0, Math.min(imgEdCanvas.width, Math.round(r.x + r.w)) - x),
      h: Math.max(0, Math.min(imgEdCanvas.height, Math.round(r.y + r.h)) - y)
    };
  }
  function inRect(r, p, pad) {
    pad = pad || 0;
    return p.x >= r.x - pad && p.x <= r.x + r.w + pad && p.y >= r.y - pad && p.y <= r.y + r.h + pad;
  }
  function isLight(hex) {
    var n = parseInt(hex.slice(1), 16);
    return ((n >> 16) * 299 + ((n >> 8) & 255) * 587 + (n & 255) * 114) / 1000 > 150;
  }
  function clone(o) { return JSON.parse(JSON.stringify(o)); }

  // ---- 도형 그리기 ----
  function drawShape(sh) {
    var c = imgEdCtx;
    if (sh.type === 'text') { drawText(c, sh); return; }
    if (sh.type === 'arrow') { drawArrow(c, sh); return; }
    var r = normRect(sh);
    if (sh.type === 'redact') {
      c.fillStyle = sh.color;
      c.fillRect(r.x, r.y, r.w, r.h);
    } else if (sh.type === 'mosaic') {
      // 원본 영역을 작게 줄였다가 그대로 키워서 픽셀화
      var block = Math.max(8, Math.round(imgMaxDim() / 80));
      var sw = Math.max(1, Math.round(r.w / block)), shh = Math.max(1, Math.round(r.h / block));
      var tmp = document.createElement('canvas');
      tmp.width = sw; tmp.height = shh;
      tmp.getContext('2d').drawImage(imgEdImage, r.x, r.y, r.w, r.h, 0, 0, sw, shh);
      c.imageSmoothingEnabled = false;
      c.drawImage(tmp, 0, 0, sw, shh, r.x, r.y, r.w, r.h);
      c.imageSmoothingEnabled = true;
    } else if (sh.type === 'box') {
      var lw = strokePx(sh.size);
      c.lineWidth = lw;
      c.strokeStyle = sh.color;
      c.strokeRect(r.x + lw / 2, r.y + lw / 2, Math.max(0, r.w - lw), Math.max(0, r.h - lw));
    }
  }

  function drawText(c, sh) {
    var fs = fontPx(sh.size);
    c.font = textFont(sh.size);
    c.textBaseline = 'top';
    c.lineJoin = 'round';
    c.lineWidth = Math.max(2, fs / 6);
    c.strokeStyle = isLight(sh.color) ? 'rgba(0,0,0,0.75)' : 'rgba(255,255,255,0.85)';
    c.strokeText(sh.text, sh.x, sh.y);
    c.fillStyle = sh.color;
    c.fillText(sh.text, sh.x, sh.y);
  }

  function drawArrow(c, sh) {
    var dx = sh.x2 - sh.x1, dy = sh.y2 - sh.y1, len = Math.sqrt(dx * dx + dy * dy);
    if (len < 1) return;
    var lw = strokePx(sh.size), ux = dx / len, uy = dy / len;
    var head = Math.min(len, Math.max(lw * 4, 14)), hw = head * 0.55;
    var bx = sh.x2 - ux * head, by = sh.y2 - uy * head;
    c.strokeStyle = c.fillStyle = sh.color;
    c.lineWidth = lw;
    c.lineCap = 'round';
    c.beginPath();
    c.moveTo(sh.x1, sh.y1);
    c.lineTo(sh.x2 - ux * head * 0.6, sh.y2 - uy * head * 0.6); // 머리 끝으로 선이 삐져나오지 않게
    c.stroke();
    c.beginPath();
    c.moveTo(sh.x2, sh.y2);
    c.lineTo(bx - uy * hw, by + ux * hw);
    c.lineTo(bx + uy * hw, by - ux * hw);
    c.closePath();
    c.fill();
    c.lineCap = 'butt';
  }

  // ---- 선택 · 히트 테스트 ----
  function shapeBounds(sh) {
    if (sh.type === 'text') {
      imgEdCtx.font = textFont(sh.size);
      var pad = Math.max(2, fontPx(sh.size) / 12);
      return { x: sh.x - pad, y: sh.y - pad, w: imgEdCtx.measureText(sh.text).width + pad * 2, h: fontPx(sh.size) * 1.2 + pad * 2 };
    }
    if (sh.type === 'arrow') {
      return normRect({ x: sh.x1, y: sh.y1, w: sh.x2 - sh.x1, h: sh.y2 - sh.y1 });
    }
    return normRect(sh);
  }

  function segDist(p, a, b) {
    var dx = b.x - a.x, dy = b.y - a.y, l2 = dx * dx + dy * dy;
    var t = l2 ? Math.max(0, Math.min(1, ((p.x - a.x) * dx + (p.y - a.y) * dy) / l2)) : 0;
    var qx = a.x + t * dx - p.x, qy = a.y + t * dy - p.y;
    return Math.sqrt(qx * qx + qy * qy);
  }

  function hitTest(sh, p) {
    var tol = 6 / displayScale();
    if (sh.type === 'arrow') {
      return segDist(p, { x: sh.x1, y: sh.y1 }, { x: sh.x2, y: sh.y2 }) <= Math.max(strokePx(sh.size), tol);
    }
    return inRect(shapeBounds(sh), p, sh.type === 'text' ? 0 : tol);
  }

  // 위에 그려진 도형부터 찾음
  function hitShape(p, onlyType) {
    for (var i = imgEdShapes.length - 1; i >= 0; i--) {
      if (onlyType && imgEdShapes[i].type !== onlyType) continue;
      if (hitTest(imgEdShapes[i], p)) return i;
    }
    return -1;
  }

  function handleSize() { return 10 / displayScale(); }

  // 크기 조절 핸들: 화살표는 양 끝점, 사각형(+자르기 영역)은 네 모서리, 텍스트는 없음
  function handlesOf(o) {
    if (o.type === 'arrow') return [{ id: 'p1', x: o.x1, y: o.y1 }, { id: 'p2', x: o.x2, y: o.y2 }];
    if (o.type === 'text') return [];
    var r = normRect(o);
    return [
      { id: 'nw', x: r.x, y: r.y }, { id: 'ne', x: r.x + r.w, y: r.y },
      { id: 'sw', x: r.x, y: r.y + r.h }, { id: 'se', x: r.x + r.w, y: r.y + r.h }
    ];
  }
  function hitHandle(o, p) {
    var hs = handleSize() * 0.9;
    var hs2 = handlesOf(o);
    for (var i = 0; i < hs2.length; i++) {
      if (Math.abs(p.x - hs2[i].x) <= hs && Math.abs(p.y - hs2[i].y) <= hs) return hs2[i].id;
    }
    return null;
  }
  function handleCursor(id) {
    return id === 'nw' || id === 'se' ? 'nwse-resize' : id === 'ne' || id === 'sw' ? 'nesw-resize' : 'move';
  }

  function moveShape(o, orig, dx, dy) {
    if (o.type === 'arrow') { o.x1 = orig.x1 + dx; o.y1 = orig.y1 + dy; o.x2 = orig.x2 + dx; o.y2 = orig.y2 + dy; }
    else { o.x = orig.x + dx; o.y = orig.y + dy; }
  }

  function resizeShape(o, orig, id, p) {
    if (id === 'p1') { o.x1 = p.x; o.y1 = p.y; return; }
    if (id === 'p2') { o.x2 = p.x; o.y2 = p.y; return; }
    // 끌고 있는 모서리의 반대쪽을 고정
    var r = normRect(orig);
    var fx = id === 'nw' || id === 'sw' ? r.x + r.w : r.x;
    var fy = id === 'nw' || id === 'ne' ? r.y + r.h : r.y;
    var n = normRect({ x: fx, y: fy, w: p.x - fx, h: p.y - fy });
    o.x = n.x; o.y = n.y; o.w = Math.max(1, n.w); o.h = Math.max(1, n.h);
  }

  function selectedShape() { return imgEdSel >= 0 ? imgEdShapes[imgEdSel] || null : null; }

  // ---- 선택 표시 · 자르기 표시 ----
  function drawHandles(o) {
    var c = imgEdCtx, s = 1 / displayScale(), hs = handleSize();
    c.lineWidth = 1.5 * s;
    handlesOf(o).forEach(function(h) {
      c.fillStyle = '#ffffff';
      c.strokeStyle = '#3574f0';
      c.fillRect(h.x - hs / 2, h.y - hs / 2, hs, hs);
      c.strokeRect(h.x - hs / 2, h.y - hs / 2, hs, hs);
    });
  }

  function drawSelection(sh) {
    var c = imgEdCtx, s = 1 / displayScale();
    var b = shapeBounds(sh), pad = 4 * s;
    c.save();
    if (sh.type === 'arrow') {
      c.lineCap = 'round';
      c.strokeStyle = 'rgba(53,116,240,0.3)';
      c.lineWidth = strokePx(sh.size) + 6 * s;
      c.beginPath(); c.moveTo(sh.x1, sh.y1); c.lineTo(sh.x2, sh.y2); c.stroke();
    } else {
      c.strokeStyle = '#ffffff';
      c.lineWidth = 3 * s;
      c.strokeRect(b.x - pad, b.y - pad, b.w + pad * 2, b.h + pad * 2);
      c.strokeStyle = '#3574f0';
      c.lineWidth = 1.5 * s;
      c.setLineDash([6 * s, 4 * s]);
      c.strokeRect(b.x - pad, b.y - pad, b.w + pad * 2, b.h + pad * 2);
    }
    c.restore();
    drawHandles(sh);
  }

  function drawCropOverlay() {
    if (!imgEdCrop) return;
    var c = imgEdCtx, s = 1 / displayScale(), r = clampRect(normRect(imgEdCrop)); // 드래그 중 이미지 밖으로 나가도 어둡게 칠하는 영역이 겹치지 않게
    var W = imgEdCanvas.width, H = imgEdCanvas.height;
    c.fillStyle = 'rgba(0,0,0,0.6)';
    c.fillRect(0, 0, W, r.y);
    c.fillRect(0, r.y + r.h, W, H - r.y - r.h);
    c.fillRect(0, r.y, r.x, r.h);
    c.fillRect(r.x + r.w, r.y, W - r.x - r.w, r.h);
    c.save();
    c.strokeStyle = '#ffffff';
    c.lineWidth = 1.5 * s;
    c.setLineDash([6 * s, 4 * s]);
    c.strokeRect(r.x, r.y, r.w, r.h);
    c.restore();
    if (imgEdTool === 'crop') drawHandles(r);
  }

  // clean: 내보낼 때는 선택·자르기 표시 없이 그림
  function renderImgEd(clean) {
    var c = imgEdCtx;
    c.clearRect(0, 0, imgEdCanvas.width, imgEdCanvas.height);
    c.drawImage(imgEdImage, 0, 0);
    imgEdShapes.forEach(function(sh, i) {
      if (!(imgEdTextPos && imgEdTextPos.index === i)) drawShape(sh); // 수정 중인 텍스트는 입력창으로 대신 보임
    });
    if (imgEdDraft) drawShape(imgEdDraft);
    if (!clean) {
      drawCropOverlay();
      var sh = selectedShape();
      if (sh && !imgEdTextPos) drawSelection(sh);
    }
    updateImgEdUi();
  }

  // 툴바 상태: 색/굵기는 [텍스트 입력 중 > 선택한 도형 > 현재 도구] 기준으로 표시
  function updateImgEdUi() {
    var t = imgEdTextPos, sh = selectedShape();
    var key = t ? 'text' : sh ? sh.type : imgEdTool;
    var color = t ? t.color : sh ? sh.color : imgEdColors[imgEdTool];
    var size = t ? t.size : sh ? sh.size || 'm' : imgEdSizes[imgEdTool];
    document.querySelectorAll('#imgEdColors [data-color]').forEach(function(b) { b.setAttribute('aria-pressed', String(b.dataset.color === color)); });
    document.getElementById('imgEdColors').style.opacity = color && key !== 'mosaic' ? '' : '0.4';
    if (color) imgEdColorInput.value = color;
    var sized = imgEdSizes.hasOwnProperty(key);
    imgEdSizeWrap.classList.toggle('invisible', !sized); // 자리는 유지해서 툴바가 흔들리지 않게
    document.getElementById('imgEdSizeLabel').textContent = key === 'text' ? '크기' : '굵기';
    imgEdSizeWrap.querySelectorAll('[data-size]').forEach(function(b) { b.setAttribute('aria-pressed', String(b.dataset.size === size)); });
    imgEdUndo.disabled = !imgEdHistory.length;
    imgEdRedo.disabled = !imgEdFuture.length;
    imgEdClear.disabled = !imgEdShapes.length && !imgEdCrop;
    imgEdDelete.classList.toggle('invisible', !sh);
    if (imgEdCropClear.classList.contains('hidden') === !!imgEdCrop) {
      imgEdCropClear.classList.toggle('hidden', !imgEdCrop);
      fitCanvas(); // 하단 줄바꿈이 바뀌면 캔버스 크기 다시 맞춤
    }
    if (imgEdCrop) {
      var r = clampRect(normRect(imgEdCrop));
      imgEdCropClear.textContent = '자르기 해제 · ' + r.w + '×' + r.h;
    } else imgEdCropClear.textContent = '자르기 해제';
  }

  // ---- 되돌리기 / 다시 실행 (도형 + 자르기 영역 스냅샷) ----
  function snapshot() { return JSON.stringify({ s: imgEdShapes, c: imgEdCrop }); }
  function restoreSnapshot(str) {
    var o = JSON.parse(str);
    imgEdShapes = o.s; imgEdCrop = o.c; imgEdSel = -1;
  }
  function pushHistory(before) {
    imgEdHistory.push(before || snapshot());
    imgEdFuture = [];
  }
  function undoImgEd() {
    commitTextInput();
    if (!imgEdHistory.length) return;
    imgEdFuture.push(snapshot());
    restoreSnapshot(imgEdHistory.pop());
    renderImgEd();
  }
  function redoImgEd() {
    commitTextInput();
    if (!imgEdFuture.length) return;
    imgEdHistory.push(snapshot());
    restoreSnapshot(imgEdFuture.pop());
    renderImgEd();
  }
  function deleteSelected() {
    if (!selectedShape()) return;
    pushHistory();
    imgEdShapes.splice(imgEdSel, 1);
    imgEdSel = -1;
    renderImgEd();
  }

  // ---- 도구 · 색 · 굵기 ----
  function canvasPoint(e) {
    var rect = imgEdCanvas.getBoundingClientRect();
    return {
      x: (e.clientX - rect.left) * imgEdCanvas.width / rect.width,
      y: (e.clientY - rect.top) * imgEdCanvas.height / rect.height
    };
  }

  function toolCursor() { return imgEdTool === 'text' ? 'text' : imgEdTool === 'select' ? 'default' : 'crosshair'; }

  function setImgTool(tool) {
    commitTextInput();
    if (tool !== 'select') imgEdSel = -1;
    imgEdTool = tool;
    document.querySelectorAll('.img-tool').forEach(function(b) { b.setAttribute('aria-pressed', String(b.dataset.tool === tool)); });
    imgEdCanvas.style.cursor = toolCursor();
    if (imgEdImage) renderImgEd(); else updateImgEdUi();
  }

  // live: 색상 피커 드래그 중 — 기록은 change 때 한 번만 남김
  function setImgColor(color, live) {
    var t = imgEdTextPos, sh = selectedShape();
    if (t) { t.color = color; imgEdColors.text = color; imgEdTextInput.style.color = color; }
    else if (sh) {
      if (sh.color !== color) {
        if (!live) pushHistory();
        else if (!imgEdColorBefore) imgEdColorBefore = snapshot();
        sh.color = color;
      }
    }
    else if (imgEdColors[imgEdTool]) imgEdColors[imgEdTool] = color;
    if (imgEdImage) renderImgEd(); else updateImgEdUi();
  }

  function setImgSize(size) {
    var t = imgEdTextPos, sh = selectedShape();
    if (t) { t.size = size; imgEdSizes.text = size; imgEdTextInput.style.fontSize = Math.max(12, fontPx(size) * displayScale()) + 'px'; }
    else if (sh && imgEdSizes.hasOwnProperty(sh.type)) { if ((sh.size || 'm') !== size) { pushHistory(); sh.size = size; } }
    else if (imgEdSizes.hasOwnProperty(imgEdTool)) imgEdSizes[imgEdTool] = size;
    if (imgEdImage) renderImgEd(); else updateImgEdUi();
  }

  document.querySelectorAll('.img-tool').forEach(function(b) { b.addEventListener('click', function() { setImgTool(b.dataset.tool); }); });
  document.querySelectorAll('#imgEdColors [data-color]').forEach(function(b) {
    b.addEventListener('click', function() { setImgColor(b.dataset.color); if (imgEdTextPos) imgEdTextInput.focus(); });
  });
  imgEdColorInput.addEventListener('input', function(e) { setImgColor(e.target.value, true); });
  imgEdColorInput.addEventListener('change', function(e) {
    if (imgEdColorBefore && snapshot() !== imgEdColorBefore) pushHistory(imgEdColorBefore);
    imgEdColorBefore = null;
    setImgColor(e.target.value); // input 없이 change만 온 경우
  });
  imgEdSizeWrap.querySelectorAll('[data-size]').forEach(function(b) {
    b.addEventListener('click', function() { setImgSize(b.dataset.size); if (imgEdTextPos) imgEdTextInput.focus(); });
  });

  // ---- 포인터: 그리기 / 선택·이동·크기 조절 / 자르기 ----
  function newDraft(p) {
    var d = { type: imgEdTool, color: imgEdColors[imgEdTool] };
    if (imgEdTool === 'arrow') { d.x1 = d.x2 = p.x; d.y1 = d.y2 = p.y; }
    else { d.x = p.x; d.y = p.y; d.w = 0; d.h = 0; }
    if (imgEdSizes.hasOwnProperty(imgEdTool)) d.size = imgEdSizes[imgEdTool];
    return d;
  }

  // 선택 도구에서 누른 곳에 따라 크기 조절/이동 시작
  function startSelectDrag(drag, p) {
    var cur = selectedShape();
    var h = cur && hitHandle(cur, p);
    if (h) { drag.mode = 'resize'; drag.target = cur; drag.handle = h; return true; }
    imgEdSel = hitShape(p);
    if (imgEdSel < 0) return false;
    drag.mode = 'move'; drag.target = imgEdShapes[imgEdSel];
    return true;
  }

  function startCropDrag(drag, p) {
    var h = imgEdCrop && hitHandle(imgEdCrop, p);
    if (h) { drag.mode = 'resize'; drag.handle = h; }
    else if (imgEdCrop && inRect(normRect(imgEdCrop), p)) drag.mode = 'move';
    else { drag.mode = 'newcrop'; drag.prevCrop = imgEdCrop; imgEdCrop = { x: p.x, y: p.y, w: 0, h: 0 }; }
    drag.target = imgEdCrop;
  }

  imgEdCanvas.addEventListener('pointerdown', function(e) {
    if (e.button > 0 || !imgEdImage || imgEdBusy) return;
    var p = canvasPoint(e);
    if (imgEdTool === 'text') {
      e.preventDefault();
      var ti = hitShape(p, 'text');
      if (ti >= 0) editText(ti); else openTextInput(p);
      return;
    }
    commitTextInput();
    var drag = { start: p, before: snapshot() };
    if (imgEdTool === 'select') {
      if (!startSelectDrag(drag, p)) { renderImgEd(); return; }
    } else if (imgEdTool === 'crop') {
      startCropDrag(drag, p);
    } else {
      drag.mode = 'draw';
      imgEdDraft = newDraft(p);
    }
    if (drag.target) drag.orig = clone(drag.target);
    imgEdDrag = drag;
    imgEdCanvas.setPointerCapture(e.pointerId);
    renderImgEd();
  });

  function updateHoverCursor(p) {
    var cur = toolCursor(), h;
    if (imgEdTool === 'select') {
      var sh = selectedShape();
      h = sh && hitHandle(sh, p);
      if (h) cur = handleCursor(h); else if (hitShape(p) >= 0) cur = 'move';
    } else if (imgEdTool === 'crop' && imgEdCrop) {
      h = hitHandle(imgEdCrop, p);
      if (h) cur = handleCursor(h); else if (inRect(normRect(imgEdCrop), p)) cur = 'move';
    }
    imgEdCanvas.style.cursor = cur;
  }

  imgEdCanvas.addEventListener('pointermove', function(e) {
    if (!imgEdImage) return;
    var p = canvasPoint(e), d = imgEdDrag;
    if (!d) { updateHoverCursor(p); return; }
    if (d.mode === 'draw') {
      if (imgEdDraft.type === 'arrow') { imgEdDraft.x2 = p.x; imgEdDraft.y2 = p.y; }
      else { imgEdDraft.w = p.x - imgEdDraft.x; imgEdDraft.h = p.y - imgEdDraft.y; }
    } else if (d.mode === 'newcrop') {
      d.target.w = p.x - d.start.x; d.target.h = p.y - d.start.y;
    } else if (d.mode === 'move') {
      var dx = p.x - d.start.x, dy = p.y - d.start.y;
      if (d.target === imgEdCrop) { // 자르기 영역은 이미지 안에서만 이동
        dx = Math.max(-d.orig.x, Math.min(imgEdCanvas.width - d.orig.x - d.orig.w, dx));
        dy = Math.max(-d.orig.y, Math.min(imgEdCanvas.height - d.orig.y - d.orig.h, dy));
      }
      moveShape(d.target, d.orig, dx, dy);
    } else if (d.mode === 'resize') {
      resizeShape(d.target, d.orig, d.handle, p);
    }
    renderImgEd();
  });

  function isValidDraft(sh) {
    if (sh.type === 'arrow') return Math.abs(sh.x2 - sh.x1) + Math.abs(sh.y2 - sh.y1) > 6;
    var r = normRect(sh);
    return r.w > 3 && r.h > 3;
  }

  function endDrag() {
    var d = imgEdDrag;
    if (!d) return;
    imgEdDrag = null;
    if (d.mode === 'draw') {
      var sh = imgEdDraft;
      imgEdDraft = null;
      if (isValidDraft(sh)) imgEdShapes.push(sh.type === 'arrow' ? sh : Object.assign({}, sh, normRect(sh)));
    } else if (d.target === imgEdCrop && imgEdCrop) {
      var r = clampRect(normRect(imgEdCrop));
      // 그냥 클릭이거나 너무 작게 줄이면 드래그 전 영역 유지
      imgEdCrop = r.w > 8 && r.h > 8 ? r : (d.mode === 'newcrop' ? d.prevCrop : d.orig) || null;
    }
    if (snapshot() !== d.before) pushHistory(d.before);
    renderImgEd();
  }
  imgEdCanvas.addEventListener('pointerup', endDrag);
  imgEdCanvas.addEventListener('pointercancel', endDrag);
  imgEdCanvas.addEventListener('dblclick', function(e) {
    var i = hitShape(canvasPoint(e), 'text');
    if (i >= 0) { e.preventDefault(); editText(i); }
  });

  // ---- 텍스트 입력 (새로 넣기 / 기존 텍스트 수정) ----
  function showTextInput(t, value) {
    var scale = displayScale();
    imgEdTextPos = t;
    imgEdTextInput.style.left = (t.x * scale - 5) + 'px'; // 입력창 안쪽 여백만큼 보정
    imgEdTextInput.style.top = (t.y * scale - 3) + 'px';
    imgEdTextInput.style.fontSize = Math.max(12, fontPx(t.size) * scale) + 'px';
    imgEdTextInput.style.color = t.color;
    imgEdTextInput.value = value;
    imgEdTextInput.classList.remove('hidden');
    imgEdTextInput.focus();
    imgEdTextInput.select();
    renderImgEd();
  }
  function openTextInput(p) {
    commitTextInput();
    imgEdSel = -1;
    showTextInput({ x: p.x, y: p.y, index: -1, color: imgEdColors.text, size: imgEdSizes.text }, '');
  }
  function editText(i) {
    var sh = imgEdShapes[i];
    commitTextInput();
    i = imgEdShapes.indexOf(sh); // 앞의 입력이 지워지면서 순서가 바뀌었을 수 있음
    if (i < 0) return;
    imgEdSel = i;
    showTextInput({ x: sh.x, y: sh.y, index: i, color: sh.color, size: sh.size || 'm' }, sh.text);
  }
  function closeTextInput() {
    imgEdTextPos = null;
    if (document.activeElement === imgEdTextInput) imgEdTextInput.blur(); // 단축키가 바로 먹도록
    imgEdTextInput.classList.add('hidden');
  }
  function commitTextInput() {
    var t = imgEdTextPos;
    if (!t) return;
    closeTextInput();
    var text = imgEdTextInput.value.trim();
    if (imgEdTool !== 'select') imgEdSel = -1;
    var sh = t.index >= 0 ? imgEdShapes[t.index] : null;
    if (sh) {
      if (!text) { pushHistory(); imgEdShapes.splice(t.index, 1); imgEdSel = -1; }
      else if (text !== sh.text || t.color !== sh.color || t.size !== (sh.size || 'm')) {
        pushHistory();
        sh.text = text; sh.color = t.color; sh.size = t.size;
