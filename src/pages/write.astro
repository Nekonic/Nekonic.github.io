---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const postList = allPosts.map(p => ({
  id: p.id,
  title: p.data.title,
  categories: p.data.categories,
  tags: p.data.tags,
  date: p.data.date ? new Date(p.data.date).toISOString().substring(0, 10) : '',
  body: p.body || ''
})).sort((a, b) => b.id.localeCompare(a.id));
---

<BaseLayout title="Post Editor" description="Write or edit blog posts" tab="new-post.md" status={[]} bleed={true}>
  <div class="flex flex-col h-[calc(100dvh-9.5rem)] lg:h-[calc(100dvh-7.25rem)] min-h-[440px]">
    <!-- Toolbar -->
    <div class="shrink-0 flex flex-wrap items-center gap-x-1.5 gap-y-1.5 px-2 py-1.5 border-b border-borderSubtle">
      <!-- Run configuration 스타일 글 선택 (네이티브 select를 투명하게 덮음) -->
      <div class="relative flex-1 sm:flex-none min-w-0">
        <div class="flex items-center gap-1.5 h-7 pl-2 pr-1.5 rounded-md hover:bg-secondary transition-colors pointer-events-none">
          <Icon name="md" class="shrink-0" />
          <span id="runConfigLabel" class="truncate max-w-[14rem] text-text-primary">새 글</span>
          <Icon name="chevron-down" size={12} class="shrink-0 text-text-secondary" />
        </div>
        <select id="postSelector" aria-label="수정할 글 선택" class="absolute inset-0 w-full opacity-0 cursor-pointer">
          <option value="__NEW__">새 글</option>
          <optgroup id="secretGroup" label="비밀글 수정" hidden></optgroup>
          <optgroup label="기존 글 수정">
            {postList.map(p => (
              <option value={p.id}>{p.title}</option>
            ))}
          </optgroup>
        </select>
      </div>

      <span class="hidden sm:block w-px h-4 bg-border mx-0.5"></span>

      <!-- 저장 경로 / 파일명 -->
      <label class="order-last sm:order-none basis-full sm:basis-0 sm:flex-1 flex items-center h-7 px-2 rounded-md text-xs font-mono text-text-muted hover:bg-secondary focus-within:bg-secondary focus-within:ring-1 focus-within:ring-accent min-w-0 sm:max-w-2xl">
        <Icon name="folder" size={13} class="shrink-0 mr-1.5 text-text-secondary" />
        <span id="saveLocation" class="text-text-muted whitespace-nowrap truncate min-w-0">src/content/blog/</span>
        <input
          type="text"
          id="postSlug"
          aria-label="파일명"
          spellcheck="false"
          class="flex-1 min-w-[6rem] bg-transparent text-text-primary focus:outline-none"
          placeholder="2026-10-01-my-first-post.md"
        />
      </label>

      <span class="hidden sm:block flex-1"></span>

      <label title="비밀글: 비공개 저장소(Nekonic.github.io.data)에만 저장되고 이미지도 함께 비공개로 저장됩니다." class="flex items-center gap-1.5 h-7 px-2 rounded-md text-xs text-text-secondary hover:bg-secondary cursor-pointer select-none has-[:checked]:bg-accent/20 has-[:checked]:text-accent-soft has-[:disabled]:opacity-50 has-[:disabled]:cursor-not-allowed">
        <input type="checkbox" id="postSecret" class="sr-only" />
        <Icon name="lock" size={13} />
        <span class="hidden sm:inline">Private</span>
      </label>

      <button
        id="publishBtn"
        class="inline-flex items-center gap-1.5 h-7 px-3 bg-accent hover:bg-accent-hover disabled:opacity-60 text-white rounded-md text-xs font-semibold transition-colors"
      >
        <svg width="11" height="11" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2.5v11l9.5-5.5z" fill="currentColor"/></svg>
        <span id="publishBtnText">발행하기</span>
      </button>
    </div>

    <!-- frontmatter 값은 에디터 본문에서 읽어 여기에 동기화 -->
    <input type="hidden" id="postTitle" />
    <input type="hidden" id="postCategories" />
    <input type="hidden" id="postTags" />

    <!-- Editor + Preview -->
    <div id="workspaceContainer" class="relative flex-1 min-h-0 flex flex-col lg:flex-row">
      <!-- Editor toolbar (JetBrains Markdown 편집기 오른쪽 위) -->
      <div class="absolute top-1 right-2 z-10 flex items-center gap-0.5">
        <button id="imageBtn" type="button" title="이미지 추가 (붙여넣기·드래그도 가능)" class="w-7 h-6 flex items-center justify-center rounded text-text-secondary hover:bg-secondary hover:text-text-primary">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="12" height="10" rx="1.5"/><circle cx="6" cy="6.5" r="1"/><path d="M2.5 12l3.5-3.5 2.5 2.5 2-2 3 3"/></svg>
        </button>
        <input type="file" id="imageInput" accept="image/*" multiple class="hidden" />
        <span class="w-px h-4 bg-border mx-1"></span>
        <button id="viewEditBtn" type="button" title="Editor Only" class="w-7 h-6 flex items-center justify-center rounded text-text-secondary hover:bg-secondary hover:text-text-primary">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" aria-hidden="true"><path d="M3 4h10M3 7h7M3 10h10M3 13h5"/></svg>
        </button>
        <button id="viewSplitBtn" type="button" title="Editor and Preview" class="w-7 h-6 flex items-center justify-center rounded text-text-secondary hover:bg-secondary hover:text-text-primary">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><rect x="2" y="2.5" width="12" height="11" rx="1.5"/><path d="M8 2.5v11"/></svg>
        </button>
        <button id="viewPreviewBtn" type="button" title="Preview Only" class="w-7 h-6 flex items-center justify-center rounded text-text-secondary hover:bg-secondary hover:text-text-primary">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" aria-hidden="true"><path d="M1.5 8S4 3.5 8 3.5 14.5 8 14.5 8 12 12.5 8 12.5 1.5 8 1.5 8z"/><circle cx="8" cy="8" r="2"/></svg>
        </button>
      </div>

      <!-- Editor pane -->
      <div id="editorCol" class="flex-1 min-w-0 min-h-0 flex flex-col">
        <div class="shrink-0 h-8 flex items-center px-3 text-xs text-text-muted border-b border-borderSubtle">Markdown</div>
        <div class="relative flex-1 min-h-0 flex">
          <div id="lineGutter" class="editor-font w-12 shrink-0 overflow-hidden text-right pr-3 py-3 text-[13px] leading-6 text-text-faint select-none" aria-hidden="true"></div>
          <textarea
            id="postContent"
            spellcheck="false"
            class="editor-font flex-1 min-w-0 h-full bg-transparent py-3 pr-4 text-[13px] leading-6 text-text-primary placeholder:text-text-faint focus:outline-none resize-none"
          ></textarea>
          <!-- 줄 높이 측정용 (soft wrap 대응) -->
          <div id="lineMirror" class="editor-font absolute invisible pointer-events-none top-0 text-[13px] leading-6 whitespace-pre-wrap break-words" aria-hidden="true"></div>
        </div>
      </div>

      <!-- Preview pane -->
      <div id="previewCol" class="flex-1 min-w-0 min-h-0 flex flex-col border-t lg:border-t-0 lg:border-l border-borderSubtle">
        <div class="shrink-0 h-8 flex items-center px-3 text-xs text-text-muted border-b border-borderSubtle">Preview</div>
        <div class="flex-1 min-h-0 overflow-y-auto">
          <header id="previewHeader" class="hidden mx-6 lg:mx-8 mt-6 flex-col gap-3.5 pb-6 border-b border-borderSubtle">
            <div id="previewCats" class="flex gap-1.5 flex-wrap font-mono text-xs"></div>
            <h1 id="previewTitle" class="text-[28px] lg:text-[34px] leading-tight font-bold tracking-tight text-white"></h1>
            <div class="flex items-center gap-2.5 flex-wrap font-mono text-xs text-text-secondary">
              <img src="https://github.com/Nekonic.png" alt="" class="w-5 h-5 rounded-full bg-secondary" />
              <span class="text-text-primary">Nekonic</span>
              <span aria-hidden="true">·</span>
              <time id="previewDate"></time>
              <span id="previewTags"></span>
            </div>
          </header>
          <div id="previewContent" class="px-6 lg:px-8 pt-6 pb-10 article-content"></div>
        </div>
      </div>
    </div>

    <!-- Status bar -->
    <div class="shrink-0 h-7 flex items-center gap-4 px-3 border-t border-borderSubtle font-mono text-[11px] text-text-muted whitespace-nowrap overflow-hidden">
      <span id="caretPos">1:1</span>
      <span id="charCount">0 characters</span>
      <span class="flex-1"></span>
      <span class="hidden sm:inline">Markdown</span>
      <span class="hidden sm:inline">UTF-8</span>
      <span class="hidden sm:inline">LF</span>
    </div>
  </div>

  <!-- Notification balloon -->
  <div id="statusAlert" class="hidden" role="status"></div>
</BaseLayout>

<style>
  /* 영문·코드는 JetBrains Mono, 한글은 Pretendard로 */
  .editor-font { font-family: "JetBrains Mono", "Pretendard Variable", Pretendard, ui-monospace, monospace; }
</style>

<!-- Lightweight Marked CDN for Live Markdown Parsing -->
<script is:inline src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

<!-- Embedded existing posts data -->
<script is:inline id="postsData" type="application/json" set:html={JSON.stringify(postList)}></script>

<script is:inline>
  var posts = [];
  try {
    posts = JSON.parse(document.getElementById('postsData').textContent);
  } catch(e) {}

  var postSelector = document.getElementById('postSelector');
  var postTitle = document.getElementById('postTitle');
  var postCategories = document.getElementById('postCategories');
  var postTags = document.getElementById('postTags');
  var postSlug = document.getElementById('postSlug');
  var postContent = document.getElementById('postContent');
  var previewContent = document.getElementById('previewContent');
  var publishBtn = document.getElementById('publishBtn');
  var publishBtnText = document.getElementById('publishBtnText');
  var statusAlert = document.getElementById('statusAlert');
  var charCount = document.getElementById('charCount');

  var viewSplitBtn = document.getElementById('viewSplitBtn');
  var viewEditBtn = document.getElementById('viewEditBtn');
  var viewPreviewBtn = document.getElementById('viewPreviewBtn');
  var editorCol = document.getElementById('editorCol');
  var previewCol = document.getElementById('previewCol');
  var workspaceContainer = document.getElementById('workspaceContainer');

  var currentEditingSha = null;
  var postSecret = document.getElementById('postSecret');
  var saveLocation = document.getElementById('saveLocation');
  var secretGroup = document.getElementById('secretGroup');

  // ---- 비밀글 (비공개 저장소) ----
  var PRIVATE_API = 'https://api.github.com/repos/Nekonic/Nekonic.github.io.data/contents/';
  var PRIVATE_DIR = '_posts';
  var privateImageCache = {};

  function updateSaveLocation() {
    saveLocation.textContent = postSecret.checked
      ? 'Nekonic.github.io.data/_posts/'
      : 'src/content/blog/';
    saveLocation.className = postSecret.checked ? 'text-accent-soft whitespace-nowrap truncate min-w-0' : 'text-text-muted whitespace-nowrap truncate min-w-0';
    publishBtnText.textContent = currentEditingSha ? '수정 저장하기' : (postSecret.checked ? '비밀글 저장' : '발행하기');
  }
  postSecret.addEventListener('change', updateSaveLocation);

  function encodePath(path) {
    return path.split('/').map(encodeURIComponent).join('/');
  }

  function decodeBase64Utf8(b64) {
    var bin = atob(b64.replace(/\n/g, ''));
    var bytes = new Uint8Array(bin.length);
    for (var i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
    return new TextDecoder().decode(bytes);
  }

  function parseFrontmatter(text) {
    var m = text.match(/^---\r?\n([\s\S]*?)\r?\n---[ \t]*(?:\r?\n|$)/);
    var fm = m ? m[1] : '';
    var field = function(k) {
      var r = fm.match(new RegExp('^' + k + '[ \\t]*:[ \\t]*(.*)$', 'm'));
      return r ? r[1].trim() : '';
    };
    var list = function(v) {
      v = v.replace(/^\[/, '').replace(/\]$/, '');
      return v.split(',').map(function(x) { return x.trim().replace(/^["']|["']$/g, ''); }).filter(Boolean).join(', ');
    };
    return {
      title: field('title').replace(/^"(.*)"$/, '$1').replace(/^'(.*)'$/, '$1').replace(/\\"/g, '"'),
      date: field('date').replace(/^["']|["']$/g, ''),
      categories: list(field('categories')),
      tags: list(field('tags')),
      body: m ? text.slice(m[0].length) : text
    };
  }

  async function loadSecretList() {
    var pat = localStorage.getItem('github_pat');
    if (!pat) return;
    try {
      var res = await fetch(PRIVATE_API + PRIVATE_DIR, {
        headers: { 'Authorization': 'Bearer ' + pat, 'Accept': 'application/vnd.github+json' }
      });
      if (!res.ok) return;
      var files = await res.json();
      files.filter(function(f) { return f.type === 'file' && f.name.endsWith('.md'); })
        .sort(function(a, b) { return b.name.localeCompare(a.name); })
        .forEach(function(f) {
          var opt = document.createElement('option');
          opt.value = 'secret:' + f.name.replace(/\.md$/, '');
          opt.textContent = f.name.replace(/\.md$/, '');
          secretGroup.appendChild(opt);
        });
      if (secretGroup.children.length) secretGroup.hidden = false;
    } catch (e) {}
  }

  async function loadSecretPost(id) {
    var pat = localStorage.getItem('github_pat');
    if (!pat) { showAlert('비밀글을 불러오려면 GitHub 토큰이 필요합니다.', true); return; }
    try {
      var res = await fetch(PRIVATE_API + encodePath(PRIVATE_DIR + '/' + id + '.md'), {
        headers: { 'Authorization': 'Bearer ' + pat, 'Accept': 'application/vnd.github+json' }
      });
      if (!res.ok) throw new Error('HTTP ' + res.status);
      var data = await res.json();
      var parsed = parseFrontmatter(decodeBase64Utf8(data.content));
      currentEditingSha = data.sha;
      postSecret.checked = true;
      postSecret.disabled = true;
      postTitle.value = parsed.title;
      postCategories.value = parsed.categories;
      postTags.value = parsed.tags;
      postSlug.value = id + '.md';
      setEditor(parsed.body.trim(), parsed.date);
      updateSaveLocation();
      updatePreview();
    } catch (e) {
      showAlert('비밀글을 불러오지 못했습니다: ' + e.message, true);
    }
  }

  // 미리보기에서 /_private/... 이미지를 토큰으로 불러와 표시
  function resolvePreviewImages() {
    var pat = localStorage.getItem('github_pat');
    if (!pat) return;
    previewContent.querySelectorAll('img[src^="/_private/"]').forEach(function(img) {
      var src = img.getAttribute('src');
      if (privateImageCache[src]) { img.src = privateImageCache[src]; return; }
      fetch(PRIVATE_API + encodePath(PRIVATE_DIR + '/' + src.slice('/_private/'.length)), {
        headers: { 'Authorization': 'Bearer ' + pat, 'Accept': 'application/vnd.github.raw' }
      }).then(function(r) { return r.ok ? r.blob() : null; }).then(function(b) {
        if (!b) return;
        privateImageCache[src] = URL.createObjectURL(b);
        img.src = privateImageCache[src];
      });
    });
  }

  async function putPrivateFile(pat, path, base64Content, message, sha) {
    var body = { message: message, content: base64Content };
    if (sha) body.sha = sha;
    var res = await fetch(PRIVATE_API + encodePath(path), {
      method: 'PUT',
      headers: { 'Authorization': 'Bearer ' + pat, 'Content-Type': 'application/json' },
      body: JSON.stringify(body)
    });
    var data = await res.json();
    if (!res.ok) throw new Error(data.message || ('HTTP ' + res.status));
    return data;
  }

  // ---- Image upload (원본 파일 그대로 public/assets/images/posts/<slug>/ 에 저장) ----
  var REPO_API = 'https://api.github.com/repos/Nekonic/Nekonic.github.io';
  var pendingImages = {}; // publicPath -> { file, blobUrl, repoPath }

  function sanitizeName(name) {
    var dot = name.lastIndexOf('.');
    var base = dot > 0 ? name.slice(0, dot) : name;
    var ext = dot > 0 ? name.slice(dot + 1).toLowerCase() : 'png';
    base = base.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '') || 'image';
    return base + '-' + Date.now().toString(36) + '.' + ext;
  }

  function addImageFiles(files) {
    var folder = (postSlug.value.trim().replace(/\.md$/, '')) || 'untitled';
    var inserts = [];
    Array.prototype.forEach.call(files, function(file) {
      if (!file.type.startsWith('image/')) return;
      var fileName = sanitizeName(file.name || 'image.png');
      var publicPath = '/assets/images/posts/' + folder + '/' + fileName;
      pendingImages[publicPath] = {
        file: file,
        blobUrl: URL.createObjectURL(file),
        repoPath: 'public' + publicPath
      };
      inserts.push('![](' + publicPath + ')');
    });
    if (!inserts.length) return;
    var start = postContent.selectionStart, end = postContent.selectionEnd;
    var text = inserts.join('\n\n') + '\n';
    postContent.value = postContent.value.slice(0, start) + text + postContent.value.slice(end);
    postContent.selectionStart = postContent.selectionEnd = start + text.length;
    postContent.focus();
    updatePreview();
  }

  postContent.addEventListener('paste', function(e) {
    var items = e.clipboardData && e.clipboardData.files;
    if (items && items.length && Array.prototype.some.call(items, function(f) { return f.type.startsWith('image/'); })) {
      e.preventDefault();
      addImageFiles(items);
    }
  });
  postContent.addEventListener('dragover', function(e) { e.preventDefault(); });
  postContent.addEventListener('drop', function(e) {
    if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length) {
      e.preventDefault();
      addImageFiles(e.dataTransfer.files);
    }
  });
  document.getElementById('imageBtn').addEventListener('click', function() {
    document.getElementById('imageInput').click();
  });
  document.getElementById('imageInput').addEventListener('change', function(e) {
    addImageFiles(e.target.files);
    e.target.value = '';
  });

  function fileToBase64(file) {
    return new Promise(function(resolve, reject) {
      var reader = new FileReader();
      reader.onload = function() { resolve(String(reader.result).split(',')[1]); };
      reader.onerror = reject;
      reader.readAsDataURL(file);
    });
  }

  async function gh(path, method, body, pat) {
    var res = await fetch(REPO_API + path, {
      method: method,
      headers: { 'Authorization': 'Bearer ' + pat, 'Accept': 'application/vnd.github+json', 'Content-Type': 'application/json' },
      body: body ? JSON.stringify(body) : undefined
    });
    var data = await res.json();
    if (!res.ok) throw new Error(data.message || ('HTTP ' + res.status));
    return data;
  }

  // 글 + 이미지를 하나의 커밋으로 발행 (Git Data API)
  async function publishWithImages(pat, slug, fileContent, title, imagePaths) {
    var repo = await gh('', 'GET', null, pat);
    var branch = repo.default_branch;
    var ref = await gh('/git/ref/heads/' + branch, 'GET', null, pat);
    var baseCommit = await gh('/git/commits/' + ref.object.sha, 'GET', null, pat);

    var entries = [];
    for (var i = 0; i < imagePaths.length; i++) {
      var img = pendingImages[imagePaths[i]];
      var blob = await gh('/git/blobs', 'POST', { content: await fileToBase64(img.file), encoding: 'base64' }, pat);
      entries.push({ path: img.repoPath, mode: '100644', type: 'blob', sha: blob.sha });
    }
    var postBlob = await gh('/git/blobs', 'POST', { content: fileContent, encoding: 'utf-8' }, pat);
    entries.push({ path: 'src/content/blog/' + slug, mode: '100644', type: 'blob', sha: postBlob.sha });

    var tree = await gh('/git/trees', 'POST', { base_tree: baseCommit.tree.sha, tree: entries }, pat);
    var commit = await gh('/git/commits', 'POST', {
      message: 'post: ' + title + ' (+' + imagePaths.length + ' image' + (imagePaths.length > 1 ? 's' : '') + ')',
      tree: tree.sha,
      parents: [ref.object.sha]
    }, pat);
    await gh('/git/refs/heads/' + branch, 'PATCH', { sha: commit.sha }, pat);
  }

  // Live Markdown Preview
  function updatePreview() {
    var raw = syncFrontmatter();
    charCount.textContent = postContent.value.length + ' characters';
    updateRunLabel();
    updatePreviewHeader();
    updateGutter();
    updateCaret();
    updateTabName();

    if (!raw.trim()) {
      previewContent.innerHTML = '<div class="text-text-muted text-center py-20 font-mono text-xs">마크다운을 입력하면 실시간 미리보기가 표시됩니다.</div>';
      return;
    }

    if (window.marked) {
      var src = raw;
      // 업로드 대기 중인 이미지는 blob URL로 미리보기
      Object.keys(pendingImages).forEach(function(p) { src = src.split(p).join(pendingImages[p].blobUrl); });
      // 정렬 문법: ![alt](url){left|right|center} (기존 {: .align-left} 도 지원)
      src = src.replace(/!\[([^\]]*)\]\(([^)\s]+)\)\{:?\s*\.?(?:align-)?(left|right|center)(?:-block)?\s*:?\}/g,
        function(_, alt, url, a) { return '<img src="' + url + '" alt="' + alt + '" class="img-' + a + '">'; });
      previewContent.innerHTML = marked.parse(src);
      resolvePreviewImages();
    }
  }


  postContent.addEventListener('input', updatePreview);

  // ---- Line number gutter (soft wrap 대응: 미러로 줄마다 높이를 잼) ----
  var lineGutter = document.getElementById('lineGutter');
  var lineMirror = document.getElementById('lineMirror');
  var caretPos = document.getElementById('caretPos');

  function updateGutter() {
    var lines = postContent.value.split('\n');
    var style = getComputedStyle(postContent);
    lineMirror.style.width = (postContent.clientWidth - parseFloat(style.paddingRight)) + 'px';
    lineMirror.innerHTML = '';
    lines.forEach(function(line) {
      var d = document.createElement('div');
      d.textContent = line || ' ';
      lineMirror.appendChild(d);
    });
    var html = '';
    var current = currentLine();
    Array.prototype.forEach.call(lineMirror.children, function(d, i) {
      html += '<div style="height:' + d.offsetHeight + 'px"' + (i === current ? ' class="text-text-secondary"' : '') + '>' + (i + 1) + '</div>';
    });
    lineGutter.innerHTML = html;
    lineGutter.scrollTop = postContent.scrollTop;
  }

  function currentLine() {
    return postContent.value.slice(0, postContent.selectionStart).split('\n').length - 1;
  }

  function updateCaret() {
    var before = postContent.value.slice(0, postContent.selectionStart);
    var line = before.split('\n').length - 1;
    var col = before.length - before.lastIndexOf('\n');
    caretPos.textContent = (line + 1) + ':' + col;
    Array.prototype.forEach.call(lineGutter.children, function(d, i) {
      d.className = i === line ? 'text-text-secondary' : '';
    });
  }

  postContent.addEventListener('scroll', function() { lineGutter.scrollTop = postContent.scrollTop; });
  ['keyup', 'click', 'select'].forEach(function(ev) { postContent.addEventListener(ev, updateCaret); });
  window.addEventListener('resize', updateGutter);

  // Tab 키: 들여쓰기 4칸
  postContent.addEventListener('keydown', function(e) {
    if (e.key !== 'Tab' || e.shiftKey || e.ctrlKey || e.metaKey || e.altKey) return;
    e.preventDefault();
    var a = postContent.selectionStart, b = postContent.selectionEnd;
    postContent.setRangeText('    ', a, b, 'end');
    postContent.dispatchEvent(new Event('input'));
  });

  // 미리보기 머리말: 카테고리 · 제목 · 날짜 · 태그 (글 페이지와 같은 모양)
  function splitList(v) {
    return v.split(',').map(function(x) { return x.trim(); }).filter(Boolean);
  }
  var previewHeader = document.getElementById('previewHeader');
  var previewCats = document.getElementById('previewCats');
  var previewTitle = document.getElementById('previewTitle');
  var previewDate = document.getElementById('previewDate');
  var previewTags = document.getElementById('previewTags');
  function updatePreviewHeader() {
    var header = previewHeader;
    var title = postTitle.value.trim();
    var cats = splitList(postCategories.value);
    var tags = splitList(postTags.value);
    var shown = !!(title || cats.length || tags.length);
    header.classList.toggle('hidden', !shown);
    header.classList.toggle('flex', shown);
    previewContent.classList.toggle('pt-6', !shown);
    previewContent.classList.toggle('pt-2', shown);
    if (!shown) return;
    var catsEl = previewCats;
    catsEl.innerHTML = '';
    cats.forEach(function(c) {
      var chip = document.createElement('span');
      chip.className = 'px-2 py-0.5 rounded bg-secondary text-text-body';
      chip.textContent = c;
      catsEl.appendChild(chip);
    });
    catsEl.classList.toggle('hidden', !cats.length);
    var titleEl = previewTitle;
    titleEl.textContent = title || '제목 없음';
    titleEl.classList.toggle('text-text-faint', !title);
    previewDate.textContent = postDate;
    previewTags.textContent = tags.length ? '· ' + tags.map(function(t) { return '#' + t; }).join(' ') : '';
  }

  // ---- frontmatter는 에디터 본문 맨 위 YAML에서 읽음 ----
  var TODAY = (function() {
    var d = new Date(), p = function(n) { return String(n).padStart(2, '0'); };
    return d.getFullYear() + '-' + p(d.getMonth() + 1) + '-' + p(d.getDate());
  })();

  var postDate = TODAY; // 에디터 frontmatter의 date (저장 시 사용)

  function setEditor(body, date) {
    var t = postTitle.value;
    // 따옴표로 시작하는 제목은 파싱 시 따옴표가 벗겨지지 않도록 감싸서 씀
    if (/^["']/.test(t)) t = '"' + t.replace(/"/g, '\\"') + '"';
    postContent.value = '---\n'
      + 'title: ' + t + '\n'
      + 'date: ' + ((/^\d{4}-\d{2}-\d{2}/.exec(date || '') || [TODAY])[0]) + '\n'
      + 'categories: ' + postCategories.value + '\n'
      + 'tags: ' + postTags.value + '\n'
      + '---\n\n' + body;
  }

  /** 에디터의 frontmatter를 숨은 입력칸에 반영하고 본문만 돌려줌 */
  function syncFrontmatter() {
    var parsed = parseFrontmatter(postContent.value);
    var titleChanged = parsed.title !== postTitle.value;
    postTitle.value = parsed.title;
    postCategories.value = parsed.categories;
    postTags.value = parsed.tags;
    postDate = /^\d{4}-\d{2}-\d{2}$/.test(parsed.date) ? parsed.date : TODAY;
    if (titleChanged) postTitle.dispatchEvent(new Event('input')); // 새 글이면 파일명 자동 생성
    return parsed.body.replace(/^\s*\n/, '');
  }

  var runConfigLabel = document.getElementById('runConfigLabel');
  function updateRunLabel() {
    var opt = postSelector.options[postSelector.selectedIndex];
    runConfigLabel.textContent = opt ? opt.textContent : (postSlug.value.trim().replace(/\.md$/, '') || '새 글');
  }
  postSelector.addEventListener('change', updateRunLabel);

  // 탭 이름 = 파일명
  var editorTabName = document.getElementById('editorTabName');
  function updateTabName() {
    if (editorTabName) editorTabName.textContent = postSlug.value.trim() || 'new-post.md';
  }
  postSlug.addEventListener('input', updateTabName);

  // View switchers
  viewSplitBtn.addEventListener('click', function() {
    editorCol.classList.remove('hidden');
    previewCol.classList.remove('hidden');
    setActiveViewBtn(viewSplitBtn);
  });

  viewEditBtn.addEventListener('click', function() {
    editorCol.classList.remove('hidden');
    previewCol.classList.add('hidden');
    setActiveViewBtn(viewEditBtn);
  });

  viewPreviewBtn.addEventListener('click', function() {
    editorCol.classList.add('hidden');
    previewCol.classList.remove('hidden');
    setActiveViewBtn(viewPreviewBtn);
  });

  function setActiveViewBtn(active) {
    [viewSplitBtn, viewEditBtn, viewPreviewBtn].forEach(function(btn) {
      btn.classList.remove('bg-accent/25', 'text-accent-soft');
      btn.classList.add('text-text-secondary');
    });
    active.classList.remove('text-text-secondary');
    active.classList.add('bg-accent/25', 'text-accent-soft');
    updateGutter();
  }

  // Auto-generate slug when typing title for new posts
  postTitle.addEventListener('input', function() {
    if (postSelector.value === '__NEW__') {
      var cleanTitle = postTitle.value.trim().toLowerCase().replace(/[^a-z0-9가-힣]+/g, '-');
      postSlug.value = TODAY + (cleanTitle ? '-' + cleanTitle : '') + '.md';
      updateTabName();
    }
  });

  // Post Selector change handler
  postSelector.addEventListener('change', async function() {
    var val = postSelector.value;
    postSecret.disabled = false;
    if (val.indexOf('secret:') === 0) {
      await loadSecretPost(val.slice('secret:'.length));
      return;
    }
    if (val === '__NEW__') {
      currentEditingSha = null;
      postSecret.checked = false;
      updateSaveLocation();
      postTitle.value = '';
      postCategories.value = '';
      postTags.value = '';
      postSlug.value = '';
      setEditor('');
      publishBtnText.textContent = '발행하기';
      updatePreview();
      return;
    }

    var selected = posts.find(function(p) { return p.id === val; });
    if (selected) {
      // 공개 글을 수정할 때는 비밀글로 바꿀 수 없음 (공개 파일이 그대로 남기 때문)
      currentEditingSha = null;
      postSecret.checked = false;
      postSecret.disabled = true;
      updateSaveLocation();
      postTitle.value = selected.title || '';
      postCategories.value = Array.isArray(selected.categories) ? selected.categories.join(', ') : (selected.categories || '');
      postTags.value = Array.isArray(selected.tags) ? selected.tags.join(', ') : (selected.tags || '');
      postSlug.value = selected.id + '.md';
      setEditor(selected.body || '', selected.date || selected.id); // 날짜가 없으면 파일명 앞 날짜
      publishBtnText.textContent = '수정 저장하기';
      updatePreview();

      // Fetch file SHA from GitHub API so we can update it
      fetchFileSha(selected.id + '.md');
    }
  });

  async function fetchFileSha(filename) {
    var pat = localStorage.getItem('github_pat');
    if (!pat) return;

    try {
      var res = await fetch('https://api.github.com/repos/Nekonic/Nekonic.github.io/contents/src/content/blog/' + filename, {
        headers: { 'Authorization': 'Bearer ' + pat, 'Accept': 'application/vnd.github.v3+json' }
      });
      if (res.ok) {
        var data = await res.json();
        currentEditingSha = data.sha;
      }
    } catch(e) {}
  }

  function showAlert(msg, isError) {
    // JetBrains 알림 풍선 (오른쪽 아래)
    statusAlert.className = 'fixed right-4 bottom-20 lg:bottom-10 z-50 max-w-sm flex items-start gap-2.5 px-4 py-3 rounded-lg bg-secondary border border-border shadow-2xl text-xs leading-relaxed text-text-primary';
    statusAlert.innerHTML = '';
    var dot = document.createElement('span');
    dot.className = 'mt-1 w-2 h-2 shrink-0 rounded-full ' + (isError ? 'bg-[#db5c5c]' : 'bg-accent-green');
    var text = document.createElement('span');
    text.textContent = msg;
    statusAlert.appendChild(dot);
    statusAlert.appendChild(text);
    clearTimeout(showAlert.timer);
    showAlert.timer = setTimeout(function() { statusAlert.classList.add('hidden'); }, 8000);
  }

  // Publish / Save Button
  publishBtn.addEventListener('click', async function() {
    var pat = localStorage.getItem('github_pat');
    if (!pat) {
      showAlert('GitHub 토큰이 필요합니다. 트윗 작성 페이지에서 먼저 토큰을 등록해주세요.', true);
      return;
    }

    var content = syncFrontmatter().trim();
    var title = postTitle.value.trim();
    var slug = postSlug.value.trim();
    var categories = postCategories.value.trim();
    var tags = postTags.value.trim();

    if (!title) { showAlert('제목을 입력해주세요.', true); return; }
    if (!slug) { showAlert('파일명을 입력해주세요.', true); return; }
    if (!slug.endsWith('.md')) { slug += '.md'; postSlug.value = slug; }
    if (!content) { showAlert('본문 내용을 입력해주세요.', true); return; }

    publishBtn.disabled = true;
    publishBtnText.textContent = '저장 중...';

    // Construct Frontmatter (date는 에디터 frontmatter 값)
    var frontmatter = '---\n';
    frontmatter += 'title: "' + title.replace(/"/g, '\\"') + '"\n';
    frontmatter += 'date: ' + postDate + '\n';
    if (categories) {
      frontmatter += 'categories: [' + categories.split(',').map(function(s){ return '"' + s.trim() + '"'; }).join(', ') + ']\n';
    }
    if (tags) {
      frontmatter += 'tags: [' + tags.split(',').map(function(s){ return '"' + s.trim() + '"'; }).join(', ') + ']\n';
    }
    frontmatter += '---\n\n';

    var fullFileContent = frontmatter + content;

    if (postSecret.checked) {
      try {
        // 이미지: 비공개 저장소 _posts/images/<폴더>/ 에 저장하고 본문 경로를 /_private/ 로 바꿈
        var secretImages = Object.keys(pendingImages).filter(function(p) { return fullFileContent.indexOf(p) !== -1; });
        for (var i = 0; i < secretImages.length; i++) {
          var publicPath = secretImages[i];
          var rel = 'images/' + publicPath.replace(/^\/assets\/images\/posts\//, '');
          var img = pendingImages[publicPath];
          await putPrivateFile(pat, PRIVATE_DIR + '/' + rel, await fileToBase64(img.file), 'secret image: ' + title);
          var privatePath = '/_private/' + rel;
          fullFileContent = fullFileContent.split(publicPath).join(privatePath);
          postContent.value = postContent.value.split(publicPath).join(privatePath);
          privateImageCache[privatePath] = img.blobUrl;
          delete pendingImages[publicPath];
        }

        var saved = await putPrivateFile(
          pat,
          PRIVATE_DIR + '/' + slug,
          btoa(unescape(encodeURIComponent(fullFileContent))),
          (currentEditingSha ? 'edit secret post: ' : 'secret post: ') + title,
          currentEditingSha
        );
        currentEditingSha = saved.content ? saved.content.sha : null;
        postSecret.disabled = true;
        showAlert('비밀글이 비공개 저장소에 저장되었습니다. Blog 목록의 private 그룹에서 볼 수 있어요.', false);
        publishBtnText.textContent = '저장 완료!';
        setTimeout(function() { publishBtnText.textContent = '수정 저장하기'; }, 3000);
      } catch (e) {
        showAlert('비밀글 저장 실패: ' + e.message, true);
        publishBtnText.textContent = '저장 실패';
      } finally {
        publishBtn.disabled = false;
      }
      return;
    }

    // 본문에서 실제로 참조 중인 이미지만 함께 커밋
    var usedImages = Object.keys(pendingImages).filter(function(p) { return fullFileContent.indexOf(p) !== -1; });
    if (usedImages.length > 0) {
      try {
        await publishWithImages(pat, slug, fullFileContent, title, usedImages);
        usedImages.forEach(function(p) { URL.revokeObjectURL(pendingImages[p].blobUrl); delete pendingImages[p]; });
        currentEditingSha = null;
        fetchFileSha(slug);
        showAlert('글과 이미지가 한 커밋으로 저장되었습니다! GitHub Actions 배포 후 반영됩니다.', false);
        publishBtnText.textContent = '발행 완료!';
        setTimeout(function() { publishBtnText.textContent = '수정 저장하기'; }, 3000);
      } catch(e) {
        showAlert('저장 실패: ' + e.message, true);
        publishBtnText.textContent = '저장 실패';
      } finally {
        publishBtn.disabled = false;
      }
      return;
    }

    var reqBody = {
      message: (currentEditingSha ? 'edit post: ' : 'post: ') + title,
      content: btoa(unescape(encodeURIComponent(fullFileContent)))
    };
    if (currentEditingSha) {
      reqBody.sha = currentEditingSha;
    }

    try {
      var res = await fetch('https://api.github.com/repos/Nekonic/Nekonic.github.io/contents/src/content/blog/' + slug, {
        method: 'PUT',
        headers: {
          'Authorization': 'Bearer ' + pat,
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(reqBody)
      });

      if (res.ok) {
        var data = await res.json();
        currentEditingSha = data.content ? data.content.sha : null;
        showAlert('성공적으로 저장되었습니다! GitHub Actions 배포 후 사이트에 자동 반영됩니다.', false);
        publishBtnText.textContent = '발행 완료!';
        setTimeout(function() { publishBtnText.textContent = currentEditingSha ? '수정 저장하기' : '발행하기'; }, 3000);
      } else {
        var err = await res.json();
        showAlert('저장 실패: ' + err.message, true);
        publishBtnText.textContent = '저장 실패';
      }
    } catch(e) {
      showAlert('통신 오류가 발생했습니다.', true);
      publishBtnText.textContent = '오류 발생';
    } finally {
      publishBtn.disabled = false;
    }
  });

  // Init
  postSlug.value = TODAY + '-new-post.md';
  setEditor('');
  (window.innerWidth < 1024 ? viewEditBtn : viewSplitBtn).click();
  updatePreview();

  loadSecretList().then(function() {
    var secretId = new URLSearchParams(location.search).get('secret');
    if (secretId) {
      postSelector.value = 'secret:' + secretId;
      loadSecretPost(secretId);
    }
  });
</script>
