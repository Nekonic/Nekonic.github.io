  /**
   * 미리보기 코드 색: 언어 있는 블록은 highlight.js, 출력·text 블록과 인라인 코드는
   * 블로그 빌드와 같은 토큰 규칙(src/lib/code-tokens.mjs → window.nkTokens), 본문 연산자는 코드 글꼴.
   */
  function highlightCode(root) {
    var t = window.nkTokens;
    root.querySelectorAll('pre code').forEach(function(el) {
      var lang = (el.className.match(/language-([\w+#-]+)/) || [])[1];
      if (t && t.isPlainLang(lang)) {
        el.innerHTML = t.tokenizeToHtml(el.textContent, { keywords: false });
        el.parentElement.classList.add('plain-code');
        return;
      }
      if (!window.hljs || !lang || !hljs.getLanguage(lang)) return;
      try { hljs.highlightElement(el); } catch (e) {}
    });
    if (!t) return;
    root.querySelectorAll('code').forEach(function(el) {
      if (!el.closest('pre, h1, h2, h3, h4, h5, h6')) el.innerHTML = t.tokenizeToHtml(el.textContent);
    });
    var walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
      acceptNode: function(n) {
        return n.parentElement.closest('pre, code, h1, h2, h3, h4, h5, h6, script, style, .op') ? NodeFilter.FILTER_REJECT : NodeFilter.FILTER_ACCEPT;
      }
    });
    var texts = [];
    while (walker.nextNode()) texts.push(walker.currentNode);
    texts.forEach(function(n) {
      var html = t.wrapOperators(n.nodeValue);
      if (!html) return;
      var tpl = document.createElement('template');
      tpl.innerHTML = html;
      n.replaceWith(tpl.content);
    });
  }

  /** 미리보기용 마크다운 변환 (줄바꿈 수는 바꾸지 않음) */
  function previewSrc(src) {
