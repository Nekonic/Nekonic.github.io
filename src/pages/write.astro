---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const postList = allPosts.map(p => ({
  id: p.id,
  title: p.data.title,
  categories: p.data.categories,
  tags: p.data.tags,
  date: p.data.date ? new Date(p.data.date).toISOString().substring(0, 10) : '',
  body: p.body || ''
})).sort((a, b) => b.id.localeCompare(a.id));
---

<BaseLayout title="Post Editor" description="Write or edit blog posts" tab="new-post.md" status={[]} bleed={true}>
  <div class="flex flex-col h-[calc(100dvh-9.5rem)] lg:h-[calc(100dvh-7.25rem)] min-h-[440px]">
    <!-- Toolbar -->
    <div class="shrink-0 flex flex-wrap items-center gap-x-1.5 gap-y-1.5 px-2 py-1.5 border-b border-borderSubtle">
      <!-- Run configuration 스타일 글 선택 (네이티브 select를 투명하게 덮음) -->
      <div class="relative flex-1 sm:flex-none min-w-0">
        <div class="flex items-center gap-1.5 h-7 pl-2 pr-1.5 rounded-md hover:bg-secondary transition-colors pointer-events-none">
          <Icon name="md" class="shrink-0" />
          <span id="runConfigLabel" class="truncate max-w-[14rem] text-text-primary">새 글</span>
          <Icon name="chevron-down" size={12} class="shrink-0 text-text-secondary" />
        </div>
        <select id="postSelector" aria-label="수정할 글 선택" class="absolute inset-0 w-full opacity-0 cursor-pointer">
          <option value="__NEW__">새 글</option>
          <optgroup id="secretGroup" label="비밀글 수정" hidden></optgroup>
          <optgroup label="기존 글 수정">
            {postList.map(p => (
              <option value={p.id}>{p.title}</option>
            ))}
          </optgroup>
        </select>
      </div>

      <span class="hidden sm:block w-px h-4 bg-border mx-0.5"></span>

      <!-- 저장 경로 / 파일명 -->
      <label class="order-last sm:order-none basis-full sm:basis-0 sm:flex-1 flex items-center h-7 px-2 rounded-md text-xs font-mono text-text-muted hover:bg-secondary focus-within:bg-secondary focus-within:ring-1 focus-within:ring-accent min-w-0 sm:max-w-2xl">
        <Icon name="folder" size={13} class="shrink-0 mr-1.5 text-text-secondary" />
        <span id="saveLocation" class="text-text-muted whitespace-nowrap truncate min-w-0">src/content/blog/</span>
        <input
          type="text"
          id="postSlug"
          aria-label="파일명"
          spellcheck="false"
          class="flex-1 min-w-[6rem] bg-transparent text-text-primary focus:outline-none"
          placeholder="2026-10-01-my-first-post.md"
        />
      </label>

      <span class="hidden sm:block flex-1"></span>

      <label title="비밀글: 비공개 저장소(Nekonic.github.io.data)에만 저장되고 이미지도 함께 비공개로 저장됩니다." class="flex items-center gap-1.5 h-7 px-2 rounded-md text-xs text-text-secondary hover:bg-secondary cursor-pointer select-none has-[:checked]:bg-accent/20 has-[:checked]:text-accent-soft has-[:disabled]:opacity-50 has-[:disabled]:cursor-not-allowed">
        <input type="checkbox" id="postSecret" class="sr-only" />
        <Icon name="lock" size={13} />
        <span class="hidden sm:inline">Private</span>
      </label>

      <button
        id="publishBtn"
        class="inline-flex items-center gap-1.5 h-7 px-3 bg-accent hover:bg-accent-hover disabled:opacity-60 text-white rounded-md text-xs font-semibold transition-colors"
      >
        <svg width="11" height="11" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2.5v11l9.5-5.5z" fill="currentColor"/></svg>
        <span id="publishBtnText">발행하기</span>
      </button>
    </div>

    <!-- frontmatter 값은 에디터 본문에서 읽어 여기에 동기화 -->
    <input type="hidden" id="postTitle" />
    <input type="hidden" id="postCategories" />
    <input type="hidden" id="postTags" />

    <!-- Editor + Preview -->
    <div id="workspaceContainer" class="relative flex-1 min-h-0 flex flex-col lg:flex-row">
      <!-- Editor toolbar (JetBrains Markdown 편집기 오른쪽 위) -->
      <div class="absolute top-1 right-2 z-10 flex items-center gap-0.5">
        <button id="imageBtn" type="button" title="이미지 추가 (붙여넣기·드래그도 가능)" class="w-7 h-6 flex items-center justify-center rounded text-text-secondary hover:bg-secondary hover:text-text-primary">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="12" height="10" rx="1.5"/><circle cx="6" cy="6.5" r="1"/><path d="M2.5 12l3.5-3.5 2.5 2.5 2-2 3 3"/></svg>
        </button>
        <input type="file" id="imageInput" accept="image/*" multiple class="hidden" />
        <span class="w-px h-4 bg-border mx-1"></span>
        <button id="viewEditBtn" type="button" title="Editor Only" class="w-7 h-6 flex items-center justify-center rounded text-text-secondary hover:bg-secondary hover:text-text-primary">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" aria-hidden="true"><path d="M3 4h10M3 7h7M3 10h10M3 13h5"/></svg>
        </button>
        <button id="viewSplitBtn" type="button" title="Editor and Preview" class="w-7 h-6 flex items-center justify-center rounded text-text-secondary hover:bg-secondary hover:text-text-primary">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><rect x="2" y="2.5" width="12" height="11" rx="1.5"/><path d="M8 2.5v11"/></svg>
        </button>
        <button id="viewPreviewBtn" type="button" title="Preview Only" class="w-7 h-6 flex items-center justify-center rounded text-text-secondary hover:bg-secondary hover:text-text-primary">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" aria-hidden="true"><path d="M1.5 8S4 3.5 8 3.5 14.5 8 14.5 8 12 12.5 8 12.5 1.5 8 1.5 8z"/><circle cx="8" cy="8" r="2"/></svg>
        </button>
        <span class="w-px h-4 bg-border mx-1"></span>
        <button id="viewDiffBtn" type="button" title="Diff: 저장된 글과 비교" class="h-6 px-1.5 flex items-center gap-1 rounded text-text-secondary hover:bg-secondary hover:text-text-primary text-[11px] font-mono">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true"><path d="M4.5 2.5v6M1.5 5.5h6M8.5 12.5h6"/></svg>Diff
        </button>
      </div>

      <!-- Editor pane -->
      <div id="editorCol" class="flex-1 min-w-0 min-h-0 flex flex-col">
        <div class="shrink-0 h-8 flex items-center px-3 text-xs text-text-muted border-b border-borderSubtle">Markdown</div>
        <div class="relative flex-1 min-h-0 flex">
          <div id="lineGutter" class="font-mono w-12 shrink-0 overflow-hidden text-right pr-3 py-3 text-[13px] leading-6 text-text-faint select-none" aria-hidden="true"></div>
          <!-- 구문 색 레이어: 투명한 textarea 뒤에서 같은 글자를 색칠해 보여줌 -->
          <div id="editorHl" class="font-mono absolute top-0 overflow-hidden pointer-events-none py-3 pr-4 text-[13px] leading-6 text-text-primary whitespace-pre-wrap break-words" aria-hidden="true"></div>
          <textarea
            id="postContent"
            spellcheck="false"
            class="font-mono flex-1 min-w-0 h-full bg-transparent py-3 pr-4 text-[13px] leading-6 text-text-primary placeholder:text-text-faint focus:outline-none resize-none"
          ></textarea>
          <!-- 줄 높이 측정용 (soft wrap 대응) -->
          <div id="lineMirror" class="font-mono absolute invisible pointer-events-none top-0 text-[13px] leading-6 whitespace-pre-wrap break-words" aria-hidden="true"></div>
        </div>
      </div>

      <!-- Preview pane -->
      <div id="previewCol" class="flex-1 min-w-0 min-h-0 flex flex-col border-t lg:border-t-0 lg:border-l border-borderSubtle">
        <div class="shrink-0 h-8 flex items-center px-3 text-xs text-text-muted border-b border-borderSubtle">Preview</div>
        <div id="previewScroll" class="relative flex-1 min-h-0 overflow-y-auto">
          <button id="previewImgEdit" type="button" title="이 이미지 다시 편집" class="hidden absolute z-10 -translate-x-full whitespace-nowrap h-7 px-2.5 rounded-md text-xs font-semibold text-white bg-black/70 border border-border hover:bg-accent hover:border-accent">편집</button>
          <header id="previewHeader" class="hidden mx-6 lg:mx-8 mt-6 flex-col gap-3.5 pb-6 border-b border-borderSubtle">
            <div id="previewCats" class="flex gap-1.5 flex-wrap font-mono text-xs"></div>
            <h1 id="previewTitle" class="text-[28px] lg:text-[34px] leading-tight font-bold tracking-tight text-white"></h1>
            <div class="flex items-center gap-2.5 flex-wrap font-mono text-xs text-text-secondary">
              <img src="https://github.com/Nekonic.png" alt="" class="w-5 h-5 rounded-full bg-secondary" />
              <span class="text-text-primary">Nekonic</span>
              <span aria-hidden="true">·</span>
              <time id="previewDate"></time>
              <span id="previewTags"></span>
            </div>
          </header>
          <div id="previewContent" class="px-6 lg:px-8 pt-6 pb-10 article-content"></div>
        </div>
      </div>

      <!-- Diff pane (저장된 원본 ↔ 현재) -->
      <div id="diffCol" class="hidden flex-1 min-w-0 min-h-0 flex-col">
        <div class="shrink-0 flex flex-wrap sm:flex-nowrap items-center gap-x-3 gap-y-1 px-3 pt-9 pb-1.5 sm:h-8 sm:p-0 sm:pl-3 sm:pr-64 text-xs text-text-muted border-b border-borderSubtle whitespace-nowrap">
          <span class="hidden sm:inline">Diff</span>
          <div id="diffModes" class="flex items-center rounded-md border border-border overflow-hidden shrink-0">
            <button type="button" data-diff-mode="unified" class="diff-mode px-2 h-5">Unified</button>
            <button type="button" data-diff-mode="split" class="diff-mode px-2 h-5 border-l border-border hidden md:block">Side-by-side</button>
            <button type="button" data-diff-mode="rendered" class="diff-mode px-2 h-5 border-l border-border">Rendered</button>
          </div>
          <div class="flex items-center shrink-0">
            <button id="diffPrev" type="button" title="이전 변경 (Shift+F7)" class="w-6 h-6 flex items-center justify-center rounded text-text-secondary hover:bg-secondary hover:text-text-primary disabled:opacity-40 disabled:hover:bg-transparent">
              <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 13V3M3.5 7.5L8 3l4.5 4.5"/></svg>
            </button>
            <button id="diffNext" type="button" title="다음 변경 (F7)" class="w-6 h-6 flex items-center justify-center rounded text-text-secondary hover:bg-secondary hover:text-text-primary disabled:opacity-40 disabled:hover:bg-transparent">
              <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3v10M3.5 8.5L8 13l4.5-4.5"/></svg>
            </button>
            <span id="diffPos" class="ml-1 font-mono text-[11px]"></span>
          </div>
          <span id="diffStat" class="font-mono shrink-0"></span>
          <span id="diffBaseLabel" class="hidden lg:inline truncate"></span>
        </div>
        <div id="diffBody" class="flex-1 min-h-0 overflow-auto"></div>
      </div>
    </div>

    <!-- Status bar -->
    <div class="shrink-0 h-7 flex items-center gap-4 px-3 border-t border-borderSubtle font-mono text-[11px] text-text-muted whitespace-nowrap overflow-hidden">
      <span id="caretPos">1:1</span>
      <span id="charCount">0 characters</span>
      <span class="flex-1"></span>
      <span class="hidden sm:inline">Markdown</span>
      <span class="hidden sm:inline">UTF-8</span>
      <span class="hidden sm:inline">LF</span>
    </div>
  </div>

  <!-- Image editor dialog: 가리기 · 모자이크 · 박스 · 텍스트 -->
  <div id="imgEditor" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/60 p-2 sm:p-6" role="dialog" aria-modal="true" aria-labelledby="imgEditorTitle">
    <div class="w-full max-w-5xl max-h-full flex flex-col bg-primary border border-border rounded-xl shadow-2xl overflow-hidden">
      <div class="shrink-0 h-10 flex items-center gap-2 px-4 border-b border-borderSubtle">
        <span id="imgEditorTitle" class="font-semibold truncate">Edit Image</span>
        <span id="imgEditorQueue" class="text-xs text-text-muted"></span>
        <span class="flex-1"></span>
        <button id="imgEdClose" type="button" aria-label="닫기" title="닫기 (Esc)" class="w-7 h-7 flex items-center justify-center rounded-md text-text-secondary hover:bg-secondary hover:text-text-primary"><Icon name="close" size={14} /></button>
      </div>

      <!-- tools -->
      <div class="shrink-0 flex flex-wrap items-center gap-1 px-3 py-1.5 border-b border-borderSubtle text-xs">
        <button type="button" data-tool="select" aria-label="선택" class="img-tool h-7 px-2 sm:px-2.5 rounded-md flex items-center gap-1.5" title="선택 · 드래그로 이동, 모서리로 크기 조절, 더블클릭으로 텍스트 수정 (V)">
          <svg width="13" height="13" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor"><path d="M3.5 2l9 6.2-4 .8 2.4 4.6-1.6.8-2.4-4.6-3.4 2.6z"/></svg><span class="hidden sm:inline">선택</span>
        </button>
        <span class="w-px h-4 bg-border mx-1"></span>
        <button type="button" data-tool="redact" aria-label="가리기" class="img-tool h-7 px-2 sm:px-2.5 rounded-md flex items-center gap-1.5" title="단색으로 덮어 가리기 · IP 등 민감 정보 (R)">
          <svg width="13" height="13" viewBox="0 0 16 16" aria-hidden="true"><rect x="2" y="4" width="12" height="8" rx="1" fill="currentColor"/></svg><span class="hidden sm:inline">가리기</span>
        </button>
        <button type="button" data-tool="mosaic" aria-label="모자이크" class="img-tool h-7 px-2 sm:px-2.5 rounded-md flex items-center gap-1.5" title="모자이크 · 사진용, 글자는 가리기 권장 (M)">
          <svg width="13" height="13" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor"><rect x="2" y="2" width="4" height="4"/><rect x="10" y="2" width="4" height="4"/><rect x="6" y="6" width="4" height="4"/><rect x="2" y="10" width="4" height="4"/><rect x="10" y="10" width="4" height="4"/></svg><span class="hidden sm:inline">모자이크</span>
        </button>
        <button type="button" data-tool="box" aria-label="박스" class="img-tool h-7 px-2 sm:px-2.5 rounded-md flex items-center gap-1.5" title="네모 박스로 강조 (B)">
          <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="2.5" y="3.5" width="11" height="9" rx="1"/></svg><span class="hidden sm:inline">박스</span>
        </button>
        <button type="button" data-tool="arrow" aria-label="화살표" class="img-tool h-7 px-2 sm:px-2.5 rounded-md flex items-center gap-1.5" title="드래그해서 화살표 그리기 (A)">
          <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 13L12.5 3.5M7 3.5h5.5V9"/></svg><span class="hidden sm:inline">화살표</span>
        </button>
        <button type="button" data-tool="text" aria-label="텍스트" class="img-tool h-7 px-2 sm:px-2.5 rounded-md flex items-center gap-1.5" title="클릭한 곳에 텍스트 입력, 기존 텍스트를 누르면 수정 (T)">
          <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M3 3.5h10M8 3.5v9.5"/></svg><span class="hidden sm:inline">텍스트</span>
        </button>
        <button type="button" data-tool="crop" aria-label="자르기" class="img-tool h-7 px-2 sm:px-2.5 rounded-md flex items-center gap-1.5" title="드래그해서 남길 영역 지정 · 적용할 때 잘라냄 (C)">
          <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M4.5 1.5v10h10M1.5 4.5h10v10"/></svg><span class="hidden sm:inline">자르기</span>
        </button>

        <span class="w-px h-4 bg-border mx-1.5"></span>

        <div id="imgEdColors" class="flex items-center gap-1">
          <button type="button" data-color="#000000" class="img-color" style="background:#000000" aria-label="검정"></button>
          <button type="button" data-color="#ffffff" class="img-color" style="background:#ffffff" aria-label="흰색"></button>
          <button type="button" data-color="#ff3b30" class="img-color" style="background:#ff3b30" aria-label="빨강"></button>
          <button type="button" data-color="#ffcc00" class="img-color" style="background:#ffcc00" aria-label="노랑"></button>
          <button type="button" data-color="#34c759" class="img-color" style="background:#34c759" aria-label="초록"></button>
          <button type="button" data-color="#3574f0" class="img-color" style="background:#3574f0" aria-label="파랑"></button>
          <label class="img-color relative overflow-hidden cursor-pointer" title="다른 색" style="background:conic-gradient(#f03a69,#f48924,#ffcc00,#34c759,#3574f0,#7f52ff,#f03a69)">
            <input id="imgEdColorInput" type="color" class="absolute inset-0 opacity-0 cursor-pointer" />
          </label>
        </div>

        <div id="imgEdSizeWrap" class="invisible flex items-center gap-1.5 ml-1 sm:ml-2">
          <span id="imgEdSizeLabel" class="hidden sm:inline text-text-muted">굵기</span>
          <div class="flex rounded-md border border-border overflow-hidden">
            <button type="button" data-size="s" class="img-size font-mono" title="얇게 / 작게">S</button>
            <button type="button" data-size="m" class="img-size font-mono" title="보통">M</button>
            <button type="button" data-size="l" class="img-size font-mono" title="굵게 / 크게">L</button>
          </div>
        </div>

        <span class="flex-1"></span>

        <button id="imgEdDelete" type="button" title="선택한 도형 삭제 (Delete)" aria-label="삭제" class="invisible w-7 h-7 flex items-center justify-center rounded-md text-text-secondary hover:bg-secondary hover:text-text-primary disabled:opacity-40 disabled:hover:bg-transparent">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 4.5h11M6.5 4.5V2.5h3v2M4 4.5l.7 9h6.6l.7-9"/></svg>
        </button>
        <button id="imgEdUndo" type="button" title="되돌리기 (Ctrl+Z)" aria-label="되돌리기" class="w-7 h-7 flex items-center justify-center rounded-md text-text-secondary hover:bg-secondary hover:text-text-primary disabled:opacity-40 disabled:hover:bg-transparent">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5.5 3.5L2.5 6.5l3 3M2.5 6.5h7a4 4 0 010 8H7"/></svg>
        </button>
        <button id="imgEdRedo" type="button" title="다시 실행 (Ctrl+Shift+Z)" aria-label="다시 실행" class="w-7 h-7 flex items-center justify-center rounded-md text-text-secondary hover:bg-secondary hover:text-text-primary disabled:opacity-40 disabled:hover:bg-transparent">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.5 3.5l3 3-3 3M13.5 6.5h-7a4 4 0 000 8H9"/></svg>
        </button>
      </div>

      <!-- canvas -->
      <div id="imgEdStage" class="flex-1 min-h-0 overflow-auto bg-ground flex items-center justify-center p-4">
        <div class="relative inline-block">
          <canvas id="imgEdCanvas" class="block max-w-full touch-none cursor-crosshair shadow-lg"></canvas>
          <input id="imgEdTextInput" type="text" class="hidden absolute min-w-[8rem] px-1 py-0.5 bg-black/70 border border-accent rounded text-white font-bold outline-none" placeholder="텍스트 입력 후 Enter" />
        </div>
      </div>

      <div class="shrink-0 flex flex-wrap md:flex-nowrap items-center gap-2 px-4 py-2.5 border-t border-borderSubtle">
        <button id="imgEdClear" type="button" class="shrink-0 h-8 px-2.5 rounded-md text-xs text-text-secondary hover:bg-secondary hover:text-text-primary disabled:opacity-40 disabled:hover:bg-transparent">모두 지우기</button>
        <button id="imgEdCropClear" type="button" title="자르기 영역 해제" class="hidden shrink-0 h-8 px-2.5 rounded-md text-xs text-text-secondary hover:bg-secondary hover:text-text-primary">자르기 해제</button>
        <span class="hidden md:inline min-w-0 truncate text-xs text-text-muted">V로 선택해 이동·크기 조절 · 적용하면 편집된 이미지만 올라가요 (메타데이터 제거)</span>
        <span class="flex-1"></span>
        <button id="imgEdOriginal" type="button" class="shrink-0 h-8 px-3 rounded-md text-xs text-text-primary bg-secondary hover:bg-border">원본 그대로 넣기</button>
        <button id="imgEdApply" type="button" class="shrink-0 h-8 px-4 rounded-md text-xs font-semibold text-white bg-accent hover:bg-accent-hover">적용해서 넣기</button>
      </div>
    </div>
  </div>

  <!-- Notification balloon -->
  <div id="statusAlert" class="hidden" role="status"></div>
</BaseLayout>

<style is:global>
  /* 에디터 구문 색 레이어 (색 레이어가 준비된 뒤에만 글자를 투명하게). 색은 global.css의 --c-* / .tok-* */
  #postContent.hl-on { color: transparent; caret-color: #dfe1e5; position: relative; z-index: 1; }
  #postContent.hl-on::selection { color: transparent; background: rgb(53 116 240 / 0.35); }
  #editorHl .md-quote { color: #9da0a8; }
  #editorHl .md-strong { color: #ffffff; }
  #editorHl .md-tag { color: var(--c-tag); }
  #editorHl .md-key { color: var(--c-prop); }

  /* 미리보기 코드 색: highlight.js 클래스 → 같은 JetBrains Dark 색 */
  .hljs-comment, .hljs-quote { color: var(--c-com); }
  .hljs-keyword, .hljs-literal, .hljs-type, .hljs-selector-tag, .hljs-section, .hljs-char.escape_, .hljs-subst { color: var(--c-kw); }
  .hljs-string, .hljs-regexp, .hljs-addition, .hljs-meta .hljs-string { color: var(--c-str); }
  .hljs-number { color: var(--c-num); }
  .hljs-title.function_, .hljs-function .hljs-title { color: var(--c-fn); }
  .hljs-attr, .hljs-property, .hljs-variable, .hljs-symbol { color: var(--c-prop); }
  .hljs-meta, .hljs-meta .hljs-keyword { color: var(--c-meta); }
  .hljs-tag, .hljs-name, .hljs-selector-class, .hljs-selector-id { color: var(--c-tag); }
  .hljs-deletion { color: #f75464; }

  /* diff 모드 */
  .diff-mode { color: #9da0a8; }
  .diff-mode:hover { color: #dfe1e5; background: #2b2d30; }
  .diff-mode[aria-pressed="true"] { color: #8cb4f0; background: rgb(53 116 240 / 0.25); }
  .diff-table { width: 100%; border-collapse: collapse; table-layout: fixed; font-size: 13px; line-height: 1.6rem; }
  .diff-table td { padding: 0 8px; vertical-align: top; white-space: pre-wrap; word-break: break-word; }
  .diff-table td.dn { width: 3.25rem; text-align: right; color: #6f737a; user-select: none; padding-right: 10px; }
  .diff-table td.ds { width: 1.25rem; padding: 0; text-align: center; user-select: none; }
  .diff-table td.dt { color: #dfe1e5; }
  .diff-add { background: rgb(87 150 92 / 0.16); }
  .diff-add td.ds, .diff-add td.dn { color: #6aab73; }
  .diff-del { background: rgb(219 92 92 / 0.14); }
  .diff-del td.ds, .diff-del td.dn { color: #db5c5c; }
  .diff-add ins { background: rgb(87 150 92 / 0.45); text-decoration: none; border-radius: 2px; }
  .diff-del del { background: rgb(219 92 92 / 0.45); text-decoration: none; border-radius: 2px; }
  .diff-hunk td { background: rgb(53 116 240 / 0.10); color: #8cb4f0; font-size: 12px; }
  .diff-cur td.ds { box-shadow: inset 3px 0 0 #3574f0; }
  .rdiff-cur { outline: 2px solid #3574f0 !important; outline-offset: 2px; }
  .diff-empty { background: repeating-linear-gradient(135deg, transparent 0 6px, rgb(255 255 255 / 0.03) 6px 12px); }
  .diff-split td.dt { width: calc(50% - 4.5rem); }
  .diff-split td.mid { width: 1px; padding: 0; background: #2b2d30; }
  .rdiff-add { border-left: 3px solid #57965c; background: rgb(87 150 92 / 0.12); padding: 2px 14px; margin: 0 -17px; border-radius: 0 4px 4px 0; }
  .rdiff-del { border-left: 3px solid #db5c5c; background: rgb(219 92 92 / 0.10); padding: 6px 14px; margin: 8px -17px; border-radius: 0 4px 4px 0; color: #9da0a8; font-size: .9em; text-decoration: line-through; text-decoration-color: rgb(219 92 92 / .7); }
  .rdiff-add > :first-child { margin-top: .5rem; }
  .rdiff-li { background: rgb(87 150 92 / 0.16); border-radius: 4px; outline: 1px solid rgb(87 150 92 / 0.35); }

  .img-tool { color: #9da0a8; }
  .img-tool:hover { background: #2b2d30; color: #dfe1e5; }
  .img-tool[aria-pressed="true"] { background: rgb(53 116 240 / 0.25); color: #8cb4f0; }
  .img-color { width: 20px; height: 20px; border-radius: 9999px; border: 1px solid #4e5157; }
  .img-color[aria-pressed="true"] { outline: 2px solid #3574f0; outline-offset: 2px; }
  .img-size { width: 24px; height: 22px; color: #9da0a8; }
  .img-size + .img-size { border-left: 1px solid #393b40; }
  .img-size:hover { background: #2b2d30; color: #dfe1e5; }
  .img-size[aria-pressed="true"] { background: rgb(53 116 240 / 0.25); color: #8cb4f0; }
</style>

