  // 한 줄 안의 인라인 문법: `코드`, **굵게**, [링크](url), ![이미지](url), <태그>
  function mdInline(line) {
    var re = /(`+)([^`]*?)\1|(\*\*|__)(?=\S)(.+?)\3|(!?\[)([^\]]*)(\]\()([^)\s]*)(\))|(<\/?[A-Za-z][^>]*>)/g;
    var out = '', last = 0, m;
    while ((m = re.exec(line))) {
      out += esc(line.slice(last, m.index));
      if (m[1]) out += '<span class="tok-str">' + esc(m[0]) + '</span>';
      else if (m[3]) out += '<span class="tok-com">' + m[3] + '</span><span class="md-strong">' + esc(m[4]) + '</span><span class="tok-com">' + m[3] + '</span>';
      else if (m[5]) out += '<span class="tok-com">' + esc(m[5]) + '</span><span class="tok-fn">' + esc(m[6]) + '</span><span class="tok-com">' + m[7] + '</span><span class="tok-com">' + esc(m[8]) + '</span><span class="tok-com">)</span>';
      else out += '<span class="md-tag">' + esc(m[0]) + '</span>';
      last = m.index + m[0].length;
    }
    return out + esc(line.slice(last));
  }

  // 코드 블록 안 한 줄: 언어가 있으면 highlight.js, 없으면 블로그와 같은 토큰 규칙
  function codeLine(line, lang) {
    var t = window.nkTokens;
    if (!t) return esc(line); // 색칠 규칙이 아직 안 불러와졌으면 캐시하지 않음
    var key = lang + '\u0000' + line;
    if (hlCache.has(key)) return hlCache.get(key);
    var plain = t.isPlainLang(lang), useHljs = !plain && lang && window.hljs && hljs.getLanguage(lang);
    if (!plain && !window.hljs) return esc(line); // highlight.js를 기다리는 중
    var html = useHljs ? hljs.highlight(line, { language: lang, ignoreIllegals: true }).value : t.tokenizeToHtml(line, { keywords: !plain });
    if (hlCache.size > 5000) hlCache.clear();
    hlCache.set(key, html);
    return html;
  }

  function mdHighlight(text) {
    var lines = text.split('\n'), out = [], fm = false, fence = null, fenceMark = '';
    lines.forEach(function(line, i) {
      var m;
      if (i === 0 && line === '---') { fm = true; out.push('<span class="tok-com">---</span>'); return; }
      if (fm) {
        if (line === '---') { fm = false; out.push('<span class="tok-com">---</span>'); return; }
        m = line.match(/^([\w-]+)(\s*:)(.*)$/);
        if (m) out.push('<span class="md-key">' + esc(m[1]) + '</span>' + esc(m[2]) + '<span class="' + (/^\s*[\d-]+\s*$/.test(m[3]) ? 'tok-num' : 'tok-str') + '">' + esc(m[3]) + '</span>');
        else out.push(esc(line));
        return;
      }
      if ((m = line.match(/^(\s*)(```+|~~~+)\s*([\w+#-]*)(.*)$/))) {
        if (fence === null) { fence = (m[3] || '').toLowerCase(); fenceMark = m[2]; }
        else if (!m[3] && !m[4].trim() && m[2][0] === fenceMark[0] && m[2].length >= fenceMark.length) fence = null;
        else { out.push(codeLine(line, fence)); return; }
        out.push(esc(m[1]) + '<span class="tok-com">' + m[2] + '</span><span class="tok-kw">' + esc(m[3]) + '</span>' + esc(m[4]));
        return;
      }
      if (fence !== null) { out.push(codeLine(line, fence)); return; }
      if ((m = line.match(/^(#{1,6}\s)(.*)$/))) { out.push('<span class="tok-kw">' + esc(m[1]) + mdInline(m[2]) + '</span>'); return; }
      if (/^\s*([-*_])(\s*\1){2,}\s*$/.test(line)) { out.push('<span class="tok-com">' + esc(line) + '</span>'); return; }
      if ((m = line.match(/^(\s*>+\s?)(.*)$/))) { out.push('<span class="tok-com">' + esc(m[1]) + '</span><span class="md-quote">' + mdInline(m[2]) + '</span>'); return; }
      if ((m = line.match(/^(\s*)([-*+]|\d+[.)])(\s+)(.*)$/))) { out.push(esc(m[1]) + '<span class="tok-kw">' + esc(m[2]) + '</span>' + m[3] + mdInline(m[4])); return; }
      out.push(mdInline(line));
    });
    return out.join('\n') + '\n ';
  }

