  function replacePendingImage(path, file, state) {
    var entry = pendingImages[path];
    if (!entry) return;
    URL.revokeObjectURL(entry.blobUrl);
    entry.file = file;
    entry.blobUrl = URL.createObjectURL(file);
    entry.edit = state;
    var m = /\.([^.\/]+)$/.exec(path);
    var ext = fileExt(file);
    if (!m || m[1].toLowerCase().replace('jpeg', 'jpg') !== ext) {
      var newPath = path.replace(/(\.[^.\/]+)?$/, '.' + ext);
      delete pendingImages[path];
      pendingImages[newPath] = entry;
      entry.repoPath = 'public' + newPath;
      postContent.value = postContent.value.split(path).join(newPath);
    }
    updatePreview();
