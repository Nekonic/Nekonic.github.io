---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import Giscus from '../../components/Giscus.astro';
import { getDateFromId, formatDate, toArray } from '../../lib/utils';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const date = getDateFromId(post.id, post.data.date);
const tags = toArray(post.data.tags);
const categories = toArray(post.data.categories);
---

<BaseLayout title={post.data.title} description={`Blog post about ${post.data.title}`} wide={true}>
  <div class="flex gap-8 lg:gap-12 items-start justify-between">
    <!-- Main Article Column -->
    <article class="flex-1 min-w-0 max-w-3xl">
      <!-- Back to blog link -->
      <a href="/blog" class="inline-flex items-center gap-1.5 text-xs font-mono text-text-muted hover:text-accent mb-6 transition-colors">
        <span>&larr;</span>
        <span>Back to all posts</span>
      </a>

      <!-- Post Header -->
      <header class="mb-8 border-b border-border/70 pb-6">
        <div class="flex items-center gap-2 mb-3">
          <time class="text-xs font-mono text-text-muted">{formatDate(date)}</time>
          {categories.length > 0 && (
            <span class="text-xs font-mono text-text-muted">/</span>
            <span class="text-xs font-mono text-accent">{categories.join(', ')}</span>
          )}
        </div>

        <h1 class="text-2xl lg:text-4xl font-bold text-white tracking-tight leading-tight mb-4">
          {post.data.title}
        </h1>

        {tags.length > 0 && (
          <div class="flex flex-wrap gap-1.5 pt-2">
            {tags.map(tag => (
              <span class="px-2 py-0.5 text-xs font-mono rounded bg-secondary text-text-secondary border border-border">
                #{tag}
              </span>
            ))}
          </div>
        )}
      </header>

      <!-- Post Body -->
      <div class="article-content">
        <Content />
      </div>

      <!-- Comments Section (GitHub Discussions) -->
      <Giscus mapping="pathname" />
    </article>

    <!-- Right-side Sticky TOC (Notion style) -->
    {headings && headings.length > 0 && (
      <aside class="hidden xl:block w-60 shrink-0 sticky top-10 self-start max-h-[calc(100vh-5rem)] overflow-y-auto pr-2">
        <TableOfContents headings={headings} />
      </aside>
    )}
  </div>
</BaseLayout>
