---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { getDateFromId } from '../lib/utils';

const allPosts = await getCollection('blog');

const recentPosts = allPosts
  .sort((a, b) => getDateFromId(b.id, b.data.date).valueOf() - getDateFromId(a.id, a.data.date).valueOf())
  .slice(0, 6);

const techStack = ['C++', 'Algorithms', 'Linux', 'Reverse Engineering', 'Systems'];
---

<BaseLayout title="Home" description="C++ Programmer & Developer">
  <!-- Hero Section (JetBrains developer header with subtle ambient accent) -->
  <section class="py-8 lg:py-14 border-b border-borderSubtle mb-10 relative">
    <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-md bg-secondary border border-borderSubtle text-xs font-mono text-text-secondary mb-4">
      <span class="w-2 h-2 rounded-xs bg-gradient-to-tr from-[#f48924] via-[#f03a69] to-[#3574f0]"></span>
      <span>Nekonic's Workspace</span>
    </div>

    <h1 class="text-3xl lg:text-5xl font-bold tracking-tight text-white mb-3">
      Welcome to <span class="bg-clip-text text-transparent bg-gradient-to-r from-white via-[#dfe1e5] to-[#3574f0]">Nekonic.</span>
    </h1>
    
    <p class="text-base lg:text-lg text-text-secondary max-w-2xl leading-relaxed mb-6 font-sans">
      Notes from the Dev. Explorations in C++, systems programming, algorithms, and digital craftsmanship.
    </p>

    <!-- Tech tags in IDE badge style -->
    <div class="flex flex-wrap items-center gap-2">
      {techStack.map(tech => (
        <span class="px-2.5 py-1 rounded-md text-xs font-mono bg-card border border-borderSubtle text-text-secondary hover:border-accent hover:text-white transition-colors">
          {tech}
        </span>
      ))}
    </div>
  </section>

  <!-- Recent Posts Section -->
  <section class="mb-14">
    <div class="flex justify-between items-baseline mb-6">
      <div class="flex items-center gap-2.5">
        <svg class="text-accent" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/>
          <polyline points="14 2 14 8 20 8"/>
        </svg>
        <div>
          <h2 class="text-xl font-bold text-white tracking-tight">Recent Posts</h2>
          <p class="text-xs font-mono text-text-muted mt-0.5">Latest technical articles and problem solving logs</p>
        </div>
      </div>
      <a 
        href="/blog" 
        class="text-xs font-mono text-accent hover:text-[#56a8f5] transition-colors flex items-center gap-1 group font-medium"
      >
        View all ({allPosts.length})
        <span class="group-hover:translate-x-0.5 transition-transform">&rarr;</span>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {recentPosts.map(post => (
        <PostCard 
          title={post.data.title}
          date={getDateFromId(post.id, post.data.date)}
          categories={post.data.categories}
          tags={post.data.tags}
          slug={post.id}
        />
      ))}
    </div>
  </section>
</BaseLayout>
