---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';
import { getDateFromId, toArray, categoryStyle, initials } from '../lib/utils';

const allPosts = await getCollection('blog');

const recentPosts = allPosts
  .sort((a, b) => getDateFromId(b.id, b.data.date).valueOf() - getDateFromId(a.id, a.data.date).valueOf())
  .slice(0, 6)
  .map((post) => {
    const date = getDateFromId(post.id, post.data.date);
    const cats = toArray(post.data.categories);
    return {
      id: post.id,
      title: post.data.title,
      year: date.getFullYear(),
      md: `${String(date.getMonth() + 1).padStart(2, '0')}.${String(date.getDate()).padStart(2, '0')}`,
      cats,
      style: categoryStyle(cats[0]),
      initials: initials(cats[0]),
    };
  });

let tweets: { body: string; date?: Date }[] = [];
try {
  tweets = (await getCollection('tweets'))
    .map((t) => ({ body: (t.body ?? '').trim(), date: t.data.date ? new Date(t.data.date) : undefined }))
    .sort((a, b) => (b.date?.valueOf() ?? 0) - (a.date?.valueOf() ?? 0))
    .slice(0, 3);
} catch {}

const fmtTweetDate = (d?: Date) =>
  d ? d.toLocaleString('ko-KR', { month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'Asia/Seoul' }) : '';

const techStack = ['C++', 'Rust', 'Algorithms', 'Arch Linux', 'Networking', 'Reverse Eng.'];
---

<BaseLayout title="Home" description="C++ Programmer & Developer" tab="README.md" tree={true} wide={true} status={[`${allPosts.length} posts`, 'UTF-8', 'LF', 'Markdown']}>
  <div class="flex flex-wrap gap-10 items-start">

    <!-- Intro + Recent posts -->
    <section class="flex-[999_1_460px] min-w-0 flex flex-col gap-8">
      <div class="flex items-center gap-5">
        <span class="w-16 h-16 shrink-0 rounded-[14px] bg-accent text-white font-mono text-2xl font-semibold flex items-center justify-center">NK</span>
        <div class="flex flex-col gap-1 min-w-0">
          <h1 class="text-3xl font-bold tracking-tight text-white">Nekonic</h1>
          <p class="font-mono text-[13px] text-text-secondary">
            <span class="text-syntax-keyword">class</span> <span class="text-text-primary">Developer</span> : <span class="text-text-primary">CppProgrammer</span>, <span class="text-text-primary">SystemsTinkerer</span>
          </p>
        </div>
      </div>

      <p class="text-[15px] leading-7 text-text-body max-w-xl">
        C++, 시스템 프로그래밍, 알고리즘, 그리고 그 사이에서 만난 삽질들을 기록합니다. 인시던트 리포트부터 마인크래프트 플러그인까지.
      </p>

      <div class="flex flex-col gap-1.5">
        <div class="flex items-baseline justify-between px-3 pb-1.5">
          <h2 class="text-[13px] font-semibold">Recent Posts</h2>
          <a href="/blog" class="text-xs text-accent-soft hover:text-white transition-colors">전체 {allPosts.length}개 보기 →</a>
        </div>

        {recentPosts.map((p) => (
          <a href={`/blog/${p.id}`} class="flex items-center gap-3.5 px-3 py-2.5 rounded-lg hover:bg-accent/15 transition-colors">
            <span class="w-8 h-8 shrink-0 rounded-[7px] text-white font-mono text-xs font-semibold flex items-center justify-center" style={`background:${p.style.tile}`}>{p.initials}</span>
            <span class="flex-1 min-w-0 flex flex-col gap-0.5">
              <span class="text-sm font-semibold text-text-primary truncate">{p.title}</span>
              <span class="font-mono text-xs text-text-secondary truncate">posts/{p.year}{p.cats.length > 0 && ` · ${p.cats.join(', ')}`}</span>
            </span>
            <span class="font-mono text-xs text-text-secondary">{p.md}</span>
          </a>
        ))}

        <div id="privateRecent" class="hidden flex-col gap-1.5 pt-3"></div>
      </div>
    </section>

    <!-- Notifications + stack -->
    <section class="flex-[1_1_280px] max-w-sm flex flex-col gap-6">
      <div class="flex flex-col gap-2">
        <div class="flex items-center justify-between px-0.5 pb-1">
          <h2 class="text-[13px] font-semibold">Notifications</h2>
          <span class="text-xs text-text-secondary">tweets/</span>
        </div>
        {tweets.length === 0 && (
          <p class="text-xs text-text-muted px-0.5">아직 트윗이 없습니다.</p>
        )}
        {tweets.map((t) => (
          <a href="/tweets" class="flex gap-2.5 bg-secondary border border-border rounded-lg px-3.5 py-3 hover:border-borderHover transition-colors">
            <Icon name="info" class="shrink-0 mt-0.5 text-syntax-func" />
            <span class="flex flex-col gap-1 min-w-0">
              <span class="text-[13px] leading-relaxed text-text-primary whitespace-pre-line break-words">{t.body}</span>
              <span class="font-mono text-[11px] text-text-secondary">{fmtTweetDate(t.date)}</span>
            </span>
          </a>
        ))}
        <a href="/tweets" class="text-xs px-0.5 text-accent-soft hover:text-white transition-colors">모든 트윗 보기 →</a>
      </div>

      <div class="flex flex-col gap-2">
        <h2 class="text-[13px] font-semibold px-0.5 pb-1">Installed</h2>
        <div class="flex flex-wrap gap-1.5 font-mono text-xs">
          {techStack.map((tech) => (
            <span class="px-2 py-0.5 rounded-[5px] bg-secondary text-text-body">{tech}</span>
          ))}
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import { getPat, listPrivatePosts } from '../lib/private-posts';

  // 토큰이 있으면 최근 비밀글도 함께 보여줍니다
  const box = document.getElementById('privateRecent');
  const pat = getPat();
  if (box && pat) {
    listPrivatePosts(pat).then((posts) => {
      if (!posts || posts.length === 0) return;
      const head = document.createElement('div');
      head.className = 'px-3 pb-1.5 text-[13px] font-semibold flex items-center gap-1.5';
      head.textContent = 'Private';
      box.append(head);
      posts.slice(0, 3).forEach((p) => {
        const a = document.createElement('a');
        a.href = `/secret?id=${encodeURIComponent(p.id)}`;
        a.className = 'flex items-center gap-3.5 px-3 py-2.5 rounded-lg hover:bg-accent/15 transition-colors';
        const tile = document.createElement('span');
        tile.className = 'w-8 h-8 shrink-0 rounded-[7px] bg-[#4e5157] text-white flex items-center justify-center';
        tile.innerHTML = '<svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="3" y="7" width="10" height="7" rx="1.5"/><path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2"/></svg>';
        const text = document.createElement('span');
        text.className = 'flex-1 min-w-0 flex flex-col gap-0.5';
        const t = document.createElement('span');
        t.className = 'text-sm font-semibold text-text-primary truncate';
        t.textContent = p.title;
        const sub = document.createElement('span');
        sub.className = 'font-mono text-xs text-text-secondary truncate';
        sub.textContent = `private${p.categories.length ? ' · ' + p.categories.join(', ') : ''}`;
        text.append(t, sub);
        const d = document.createElement('span');
        d.className = 'font-mono text-xs text-text-secondary';
        d.textContent = p.date.slice(5).replace('-', '.');
        a.append(tile, text, d);
        box.append(a);
      });
      box.classList.remove('hidden');
      box.classList.add('flex');
    });
  }
</script>
